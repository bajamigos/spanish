  "titulo": "Tener in the imperfect subjunctive",
  "subtitulo": "Tuviera, tuvieras, tuviéramos.",
  "foto": "t08.jpg",
  "regla": "Tener in the imperfect subjunctive comes from tuvieron: tuviera, tuvieras, tuviera, tuviéramos, tuvieran (or tuviese...). Si tuviera tiempo, iría.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "From the ellos preterite **tuvieron** → **tuvie-** + endings."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "tener (imperfect subjunctive)"
          ],
          "filas": [
            [
              "yo",
              "tuviera"
            ],
            [
              "tú",
              "tuvieras"
            ],
            [
              "él, ella, usted",
              "tuviera"
            ],
            [
              "nosotros",
              "tuviéramos"
            ],
            [
              "ustedes, ellos",
              "tuvieran"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "The **-se** forms: **tuviese, tuvieses, tuviese, tuviésemos, tuviesen**."
        },
        {
          "tipo": "texto",
          "texto": "Verbs built on **tener** follow it: **mantener → mantuviera**, **obtener → obtuviera**, **detener → detuviera**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **tuve** → **tuviera**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Si ==tuviera== más tiempo, aprendería a tocar guitarra.",
              "en": "If I had more time, I'd learn to play guitar."
            },
            {
              "es": "Ojalá ==tuviéramos== una casa en la playa.",
              "en": "I wish we had a house at the beach."
            },
            {
              "es": "Me dijo que ==tuviera== cuidado.",
              "en": "He told me to be careful."
            },
            {
              "es": "Era raro que no ==tuvieran== hambre.",
              "en": "It was strange that they weren't hungry."
            },
            {
              "es": "Actúa como si ==tuviera== veinte años.",
              "en": "She acts as if she were twenty."
            }
