{
  "tema": 5081,
  "slug": "cuanto-verbo-exclamacion",
  "titulo": "¡Cuánto + verb! in exclamations",
  "subtitulo": "¡Cuánto has crecido!",
  "foto": "t06.jpg",
  "regla": "¡Cuánto + verb! expresses surprise at how much someone does something: ¡Cuánto has crecido! ¡Cuánto comes! With a verb, cuánto never changes (not cuánta / cuántos).",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "¡Cuánto",
            "+ verb!"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Surprise at **how much** an action happens."
        },
        {
          "tipo": "texto",
          "texto": "With a verb, it's always **cuánto**: it doesn't agree with anything."
        },
        {
          "tipo": "texto",
          "texto": "Compare: with a noun, it agrees: **¡cuánta gente!**"
        },
        {
          "tipo": "texto",
          "texto": "Tip: **cuánto** + verb = _you sure do... a lot_."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "¡==Cuánto aprendo== en la clase de alemán!",
              "en": "I'm learning so much in German class!"
            },
            {
              "es": "¡==Cuánto has crecido== desde la última vez que te vi!",
              "en": "You've grown so much since the last time I saw you!"
            },
            {
              "es": "¡==Cuánto vas a viajar== con tu nuevo trabajo!",
              "en": "You're going to travel so much with your new job!"
            },
            {
              "es": "¡==Cuánto me acuerdo== de ti!",
              "en": "I think about you so much!"
            },
            {
              "es": "¡==Cuánto sabes==, papá!",
              "en": "You know so much, Dad!"
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¡Cuántos sabes!"
                },
                {
                  "v": "bien",
                  "t": "¡Cuánto sabes!"
                }
              ],
              "nota": "With a verb: **cuánto**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¡Cuánta bailas!"
                },
                {
                  "v": "bien",
                  "t": "¡Cuánto bailas!"
                }
              ]
            },
            {
              "filas": [
                {
                  "v": "verbo",
                  "t": "¡Cuánto comes!"
                },
                {
                  "v": "sustantivo",
                  "t": "¡Cuánta comida!"
                }
              ],
              "nota": "Nouns make it agree."
            }
          ]
        }
      ]
    },
    {
      "id": "parientes",
