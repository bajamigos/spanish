  "titulo": "Haber in the imperfect subjunctive",
  "subtitulo": "Hubiera, hubieras, hubiéramos.",
  "foto": "t01.jpg",
  "regla": "Haber in the imperfect subjunctive: hubiera, hubieras, hubiera, hubiéramos, hubieran (or hubiese...). It builds the pluperfect subjunctive (hubiera ido) and also works alone: ojalá hubiera más tiempo (there were).",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "From the preterite **hubieron** → **hubie-** + endings."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "haber (imperfect subjunctive)"
          ],
          "filas": [
            [
              "yo",
              "hubiera"
            ],
            [
              "tú",
              "hubieras"
            ],
            [
              "él, ella, usted",
              "hubiera"
            ],
            [
              "nosotros",
              "hubiéramos"
            ],
            [
              "ustedes, ellos",
              "hubieran"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "The **-se** forms: **hubiese, hubieses, hubiese, hubiésemos, hubiesen**; more formal."
        },
        {
          "tipo": "texto",
          "texto": "Two jobs:"
        },
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "auxiliary",
              "texto": "**hubiera** + participle = pluperfect subjunctive: **si hubiera sabido...**"
            },
            {
              "forma": "hay → hubiera",
              "texto": "_there were_, always singular: **ojalá hubiera más playas así**."
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **hubo** → **hubiera**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Si ==hubiera== sabido, te habría avisado.",
              "en": "If I'd known, I would have told you."
            },
