{
  "tema": 5054,
  "slug": "deberia-haber",
  "titulo": "Debería + haber + participle = should have",
  "subtitulo": "Deberías haberme avisado.",
  "foto": "t04.jpg",
  "regla": "Should have done = deber in the conditional (debería, deberías, debería, deberíamos, deberían) + haber + participle: Debería haber estudiado más. Used for advice or regret about the past. Pronouns go in front or attached to haber.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "debería / deberías / debería / deberíamos / deberían",
            "+ haber + participle"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Use it for **regret** or **advice** about something in the past."
        },
        {
          "tipo": "texto",
          "texto": "Pronouns: attached to **haber** (**deberías haberme avisado**) or in front of **debería** (**me deberías haber avisado**)."
        },
        {
          "tipo": "texto",
          "texto": "In Mexico you'll also hear **debí** + infinitive (**debí estudiar más**) or **hubiera** + participle (**hubiera estudiado más**) with the same meaning."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **debería** + **haber**: the advice arrived too late."
        }
      ]
    },
    {
      "id": "dialogo",
      "titulo": "A conversation",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "—¡Ayer terminé con Jaime! Y ahora me arrepiento...",
              "en": "—I broke up with Jaime yesterday! And now I regret it..."
            },
            {
              "es": "—Uy, ==deberías haber pensado== un poco más en las consecuencias.",
              "en": "—Oh, you should have thought a bit more about the consequences."
            }
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
