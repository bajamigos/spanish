{
  "tema": 6982,
  "slug": "posicion-adjetivos",
  "titulo": "Position of adjectives",
  "subtitulo": "Una camisa roja / la blanca nieve / un viejo amigo.",
  "foto": "t03.jpg",
  "regla": "Most adjectives go after the noun and distinguish it (una camisa roja). Before the noun, they stress a quality that's natural or for emphasis (la blanca nieve, hermosos paisajes), mostly in writing. Some change meaning: un viejo amigo (long-time) vs un amigo viejo (old).",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "noun + adjective",
              "texto": "The normal order. The adjective **distinguishes** this noun from others: **una computadora japonesa**, **una camisa roja**."
            },
            {
              "forma": "adjective + noun",
              "texto": "The quality is **natural** or **emphasized**, not used to distinguish: **la blanca nieve**, **hermosos paisajes**. More literary."
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "A few adjectives **change meaning** with position:"
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Adjective",
            "Before the noun",
            "After the noun"
          ],
          "filas": [
            [
              "antiguo",
              "former (mi antiguo jefe)",
              "old, antique (un mueble antiguo)"
            ],
            [
              "grande / gran",
              "great (un gran hombre)",
              "big (un hombre grande)"
            ],
            [
              "pobre",
              "unfortunate (el pobre señor)",
              "poor, no money (un señor pobre)"
            ],
            [
              "viejo",
              "long-time (un viejo amigo)",
              "old in age (un amigo viejo)"
            ],
            [
              "nuevo",
              "another, different (un nuevo carro)",
              "brand-new (un carro nuevo)"
            ],
            [
              "mismo",
              "same (el mismo día)",
              "itself, very (el día mismo)"
            ],
            [
              "único",
              "only (mi único hijo)",
              "unique (una oportunidad única)"
            ],
            [
              "cierto",
              "certain, some (cierta gente)",
              "true (una noticia cierta)"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: after the noun, adjectives describe; before it, they color."
        }
      ]
    },
    {
      "id": "despues",
      "titulo": "After the noun",
      "bloques": [
        {
          "tipo": "ejemplos",
