                  "t": "Tengo muchas cosas que hacer."
                }
              ],
              "nota": "**Para** is heard a lot, but **que** is the standard."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Tengo mucho a hacer."
                },
                {
                  "v": "bien",
                  "t": "Tengo mucho que hacer."
                }
              ]
            }
          ]
        }
      ]
    },
