  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To point out something **surprising** compared with what's normal for its kind, use **para**: _for a..._"
        },
        {
          "tipo": "texto",
          "texto": "Common patterns: **para ser** + noun / adjective, **para** + noun, **para** + time / age."
        },
        {
          "tipo": "texto",
          "texto": "Never **por** here."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **para ser...** sets the bar, and the rest of the sentence jumps over it, or doesn't."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Para ser== adolescente, es bastante responsable.",
              "en": "For a teenager, she's pretty responsible."
            },
            {
              "es": "==Para== una universidad tan prestigiosa, los resultados no fueron muy buenos.",
              "en": "For such a prestigious university, the results weren't very good."
            },
            {
              "es": "==Para== tener ochenta años, mi abuelo camina muchísimo.",
