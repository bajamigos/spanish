{
  "tema": 8948,
  "slug": "perder-perderse",
  "titulo": "Perder / perderse = to lose, to miss, to get lost",
  "subtitulo": "Perdí las llaves. Perdimos el camión. Nos perdimos.",
  "foto": "t05.jpg",
  "regla": "Perder + thing = to lose (perdí la cartera, perder peso). Perder + transport or chance = to miss (perdí el vuelo). Perderse = to get lost (nos perdimos), also to miss out on something (te perdiste la fiesta). Missing a person = extrañar.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "perder algo",
              "texto": "_to lose_: **perdí la cartera**, **perder peso**, **perder el control**."
            },
            {
              "forma": "perder + transport / chance",
              "texto": "_to miss_: **perdimos el camión**, **perdí la oportunidad**."
            },
            {
              "forma": "perderse",
              "texto": "_to get lost_: **nos perdimos en el centro**. Also **estar perdido**."
            },
            {
              "forma": "perderse algo",
              "texto": "_to miss out on_: **te perdiste la fiesta**."
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Perder** changes e → ie: **pierdo, pierdes, pierde, perdemos, pierden**."
        },
        {
          "tipo": "texto",
          "texto": "To **miss a person**: **extrañar** (in Mexico) or **echar de menos**, never **perder**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: you lose things, you miss the bus, and you get yourself lost."
        }
      ]
    },
