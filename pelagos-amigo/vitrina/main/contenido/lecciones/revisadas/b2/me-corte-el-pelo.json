{
  "tema": 8040,
  "slug": "me-corte-el-pelo",
  "titulo": "To have something done (beauty and body)",
  "subtitulo": "Me corté el pelo. Se hizo las uñas.",
  "foto": "t07.jpg",
  "regla": "For beauty or grooming done by a professional, Spanish uses the reflexive as if you did it yourself: me corté el pelo = I got my hair cut. Never tener + participle.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "English says _I had my hair cut_. Spanish just uses the **reflexive verb**, even though a professional did it: **me corté el pelo**."
        },
        {
          "tipo": "texto",
          "texto": "Context makes it clear someone else did it."
        },
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "cortarse el pelo",
              "texto": "_to get a haircut_"
            },
            {
              "forma": "pintarse / teñirse el pelo",
              "texto": "_to get your hair dyed_"
            },
            {
              "forma": "hacerse las uñas / el manicure",
              "texto": "_to get your nails done_"
            },
            {
              "forma": "hacerse el pedicure",
              "texto": "_to get a pedicure_"
            },
            {
              "forma": "depilarse",
              "texto": "_to get waxed_"
            },
            {
              "forma": "ponerse luces / rayitos",
              "texto": "_to get highlights_"
            },
            {
              "forma": "hacerse un facial",
              "texto": "_to get a facial_"
            },
            {
              "forma": "hacerse un tatuaje",
              "texto": "_to get a tattoo_"
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "Never translate word for word: ~~tengo el pelo cortado~~."
        },
        {
          "tipo": "texto",
          "texto": "Tip: in Spanish your stylist is invisible."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "—Te ves diferente. —Sí, ==me corté== el pelo.",
