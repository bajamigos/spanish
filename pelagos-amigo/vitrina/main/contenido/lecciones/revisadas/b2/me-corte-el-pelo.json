            },
            {
              "es": "¿==Te pintaste== de güera?",
              "en": "Did you dye your hair blond?"
            },
            {
              "es": "Elena ==se hizo== las uñas.",
              "en": "Elena got her nails done."
            },
            {
              "es": "Ayer ==me depilé== las piernas.",
              "en": "Yesterday I got my legs waxed."
            },
            {
              "es": "El sábado tengo cita. ==Me voy a hacer== el pedicure.",
