{
  "tema": 6212,
  "slug": "juegue",
  "titulo": "Jugar in the present subjunctive",
  "subtitulo": "Juegue, juegues, juguemos, jueguen.",
  "foto": "t06.jpg",
  "regla": "Jugar in the present subjunctive: u → ue (except nosotros) and g → gu before e: juegue, juegues, juegue, juguemos, jueguen.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Jugar** has two changes in the present subjunctive:"
        },
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "u → ue",
              "texto": "Like in the present: **juego → juegue**. Not in **nosotros**."
            },
            {
              "forma": "g → gu",
              "texto": "Before **e**, to keep the hard _g_ sound: **juegue**, **juguemos**."
            }
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "jugar (present subjunctive)"
          ],
          "filas": [
            [
              "yo",
              "juegue"
            ],
            [
              "tú",
              "juegues"
            ],
            [
              "él, ella, usted",
              "juegue"
            ],
            [
              "nosotros",
              "juguemos"
            ],
            [
              "ustedes, ellos",
              "jueguen"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **juegue** = **jue** (stem change) + **gue** (spelling)."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Mi mamá no quiere que ==juegue== en la calle.",
              "en": "My mom doesn't want me to play in the street."
            },
            {
              "es": "Es importante que los niños ==jueguen== al aire libre.",
              "en": "It's important for kids to play outdoors."
            },
            {
              "es": "Ojalá ==juguemos== la final.",
              "en": "I hope we play in the final."
            },
            {
              "es": "No ==juegues== con fuego.",
              "en": "Don't play with fire."
            },
            {
              "es": "Cuando ==juegue== México, vamos a ver el partido juntos.",
              "en": "When Mexico plays, we'll watch the game together."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
