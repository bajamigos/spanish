{
  "tema": 7589,
  "slug": "me-gustaria-que",
  "titulo": "Wish and feeling verbs in the conditional + imperfect subjunctive",
  "subtitulo": "Me gustaría que vinieras a mi boda.",
  "foto": "t10.jpg",
  "regla": "When the wish or feeling verb is in the conditional (me gustaría que, preferiría que, desearía que, me preocuparía que), the verb after que goes in the imperfect subjunctive. Same subject: infinitive.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "me gustaría / preferiría / desearía / me preocuparía",
            "+ que +",
            "imperfect subjunctive"
          ]
        },
        {
          "tipo": "texto",
          "texto": "What's wished for or felt is about now or the future, but the form is the **imperfect subjunctive** because the main verb is conditional."
        },
        {
          "tipo": "texto",
          "texto": "Same subject: **infinitive** without **que**: **me preocuparía tener que trabajar a los 70**."
        },
        {
          "tipo": "texto",
          "texto": "Sometimes **si** replaces **que**: **me encantaría si pudieras venir** (with **si**, the same imperfect subjunctive)."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **-ría** up front, **-ra** behind."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Desearía que todo ==pasara== rápido.",
              "en": "I wish everything would go by quickly."
            },
            {
              "es": "¿No le preocuparía que su hijo ==se quedara== soltero para siempre?",
              "en": "Wouldn't she worry that her son might stay single forever?"
            },
            {
              "es": "A ti no te gustaría que Ramiro te ==engañara==.",
              "en": "You wouldn't like Ramiro to cheat on you."
            },
            {
              "es": "Preferiría que ==fuéramos== al restaurante del centro.",
              "en": "I'd prefer that we go to the restaurant downtown."
            },
            {
              "es": "Me gustaría que ustedes ==vinieran== a mi boda.",
              "en": "I'd like you all to come to my wedding."
            },
            {
              "es": "A mí me preocuparía ==tener== que seguir trabajando a los 70.",
              "en": "I'd worry about having to keep working at 70. (same subject)"
            }
          ]
        }
      ]
    },
