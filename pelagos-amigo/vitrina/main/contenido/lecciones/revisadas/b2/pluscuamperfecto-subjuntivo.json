{
  "tema": 5842,
  "slug": "pluscuamperfecto-subjuntivo",
  "titulo": "Conjugating the pluperfect subjunctive",
  "subtitulo": "Hubiera ido, hubieras hecho, hubieran dicho.",
  "foto": "t02.jpg",
  "regla": "Pluperfect subjunctive = hubiera / hubieras / hubiera / hubiéramos / hubieran (or hubiese...) + participle. Used for past actions where the subjunctive is needed: si hubiera sabido, ojalá hubieras venido, como si hubiera visto un fantasma.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "hubiera / hubieras / hubiera / hubiéramos / hubieran",
            "+ participle"
          ]
        },
        {
          "tipo": "texto",
          "texto": "The **-ra** set is the everyday one in Mexico and all of Latin America; the **-se** set (**hubiese**) is more formal or written."
        },
        {
          "tipo": "texto",
          "texto": "Use it where the subjunctive is needed and the action happened **before** another past moment: **me sorprendió que no hubieran llegado**."
        },
        {
          "tipo": "texto",
          "texto": "Key use: impossible conditions in the past: **si hubiera sabido, habría venido**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: it's the pluperfect (**había ido**) in subjunctive clothes (**hubiera ido**)."
        }
      ]
    },
    {
      "id": "tabla",
      "titulo": "Full forms",
      "bloques": [
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "-ra",
            "-se"
          ],
          "filas": [
            [
              "yo",
              "hubiera + participle",
              "hubiese + participle"
            ],
            [
              "tú",
              "hubieras + participle",
              "hubieses + participle"
            ],
            [
              "él, ella, usted",
              "hubiera + participle",
              "hubiese + participle"
            ],
            [
              "nosotros",
              "hubiéramos + participle",
              "hubiésemos + participle"
            ],
            [
              "ustedes, ellos",
              "hubieran + participle",
              "hubiesen + participle"
            ]
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "A él no le importaba lo que yo ==hubiera dicho==.",
              "en": "He didn't care what I had said."
            },
            {
              "es": "Parece como si ==hubieras tenido== una pelea.",
              "en": "You look as if you'd been in a fight."
            },
            {
              "es": "Esperábamos que él ==hubiera hecho== lo mismo por ti.",
              "en": "We were hoping he'd have done the same for you."
            },
            {
              "es": "Si usted ==hubiera venido== antes, yo lo habría atendido.",
              "en": "If you'd come earlier, I would have helped you."
            },
            {
              "es": "Si ==hubiéramos hablado== con Raquel, estaría más contenta.",
              "en": "If we'd talked to Raquel, she'd be happier."
            },
            {
              "es": "Me sorprendió que no ==hubieran llegado==.",
              "en": "I was surprised they hadn't arrived."
            }
          ]
        }
      ]
    },
