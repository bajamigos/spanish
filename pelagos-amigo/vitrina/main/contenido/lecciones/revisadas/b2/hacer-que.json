{
  "tema": 8950,
  "slug": "hacer-que",
  "titulo": "Hacer + subjunctive or infinitive = to make someone do something",
  "subtitulo": "Me haces reír. Hizo que me sintiera mal.",
  "foto": "t06.jpg",
  "regla": "To make someone do / feel something: hacer que + subjunctive (hace que me sienta bien) or hacer + infinitive (me hace reír). With the infinitive, the person is a pronoun before hacer.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Two ways to say _make someone do something_ (cause or force):"
        },
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "hacer que + subjunctive",
              "texto": "**Haces que me sienta bien.** Present **hacer** → present subjunctive; past **hacer** → imperfect subjunctive; present perfect → either."
            },
            {
              "forma": "hacer + infinitive",
              "texto": "**Me haces reír.** The person is a pronoun before **hacer**: **lo hizo arrodillarse**, **la hizo llorar**."
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **hacer** is the push; the subjunctive or the infinitive is where you land."
        }
      ]
    },
    {
      "id": "que",
      "titulo": "Hacer que + subjunctive",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Estás haciendo que me ==ponga== nerviosa.",
              "en": "You're making me nervous."
            },
            {
              "es": "No sé cómo, pero siempre haces que me ==sienta== bien.",
              "en": "I don't know how, but you always make me feel good."
            },
            {
              "es": "Te vamos a ayudar y vamos a hacer que ==pases== este examen sin problema.",
              "en": "We'll help you and get you through this exam no problem."
            },
            {
              "es": "Siempre hacían que nos ==sintiéramos== culpables.",
              "en": "They always made us feel guilty."
            },
            {
              "es": "Con tus comentarios has hecho que se ==enojen== contigo.",
              "en": "With your comments you've made them angry with you."
            }
          ]
        }
      ]
    },
    {
      "id": "infinitivo",
      "titulo": "Hacer + infinitive",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Me haces reír==.",
              "en": "You make me laugh."
            },
            {
              "es": "==La hizo ponerse== nerviosa.",
              "en": "He made her nervous."
            },
            {
              "es": "==Lo hizo arrodillarse== para pedirle matrimonio.",
              "en": "She made him kneel to propose."
            },
            {
              "es": "La película ==nos hizo llorar==.",
              "en": "The movie made us cry."
            }
          ]
        }
      ]
    },
