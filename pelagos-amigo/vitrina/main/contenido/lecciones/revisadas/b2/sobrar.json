    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Sobrar** works like **gustar** in most uses: the thing that's left or extra is the **subject**, so the verb agrees with it."
        },
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "to be left over",
              "texto": "**Sobró pastel.**"
            },
            {
              "forma": "too much / too many",
              "texto": "**Sobran sillas.**"
            },
            {
              "forma": "not needed, unwelcome (a person)",
              "texto": "**Aquí sobras.**"
            },
            {
              "forma": "sobrarle a alguien con algo",
              "texto": "_to have more than enough with_: **te sobra con 200 pesos**. Always singular, always with **con**."
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **sobrar** is everything beyond enough."
        }
      ]
    },
