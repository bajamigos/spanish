  "tema": 9544,
  "slug": "a-lo-mejor",
  "titulo": "A lo mejor (+ indicative) = maybe",
  "subtitulo": "A lo mejor vamos a la playa.",
  "foto": "t09.jpg",
  "regla": "A lo mejor = maybe, and it always takes the indicative, even though it expresses doubt: A lo mejor llueve. It's very common and colloquial in Mexico. Lo mismo (maybe) works the same way but is rare in Mexico. Tal vez / quizás can take either mood.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**A lo mejor** means _maybe, perhaps_. It's colloquial and super common in Mexico."
        },
        {
          "tipo": "texto",
          "texto": "Even though it expresses doubt, it **always** takes the **indicative**."
        },
        {
          "tipo": "formula",
          "partes": [
            "a lo mejor",
            "+",
            "indicative"
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Lo mismo** can mean the same (_maybe_) and also takes the indicative, but you'll rarely hear it with this meaning in Mexico."
        },
        {
          "tipo": "texto",
          "texto": "Compare: **tal vez / quizás** take the indicative or the subjunctive; **puede que** takes only the subjunctive."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **a lo mejor** sounds unsure but grammatically it's confident: indicative."
        }
      ]
    },
    {
      "id": "ejemplos",
