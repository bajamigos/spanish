              "creamos",
              "creímos",
              "criamos"
            ],
            [
              "ustedes, ellos",
              "crearon",
              "creyeron",
              "criaron"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Crie, crio** have **no accent** (one syllable)."
        },
        {
          "tipo": "texto",
          "texto": "**Criarse** = _to grow up_: **me crie en Sonora**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **creyó** has the **y** of **leyó**; **crio** is short like the child it raised."
        }
