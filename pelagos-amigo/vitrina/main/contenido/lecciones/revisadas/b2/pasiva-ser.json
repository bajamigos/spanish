{
  "tema": 6173,
  "slug": "pasiva-ser",
  "titulo": "The passive voice with ser + participle (+ por)",
  "subtitulo": "Fue construido por los mayas.",
  "foto": "t04.jpg",
  "regla": "Passive voice: ser (any tense) + participle agreeing with the subject (+ por + agent): Los ladrones fueron arrestados por la policía. It's much less common than in English; Spanish often prefers the active or the passive se.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "ser (any tense)",
            "+ participle",
            "(+ por + agent)"
          ]
        },
        {
          "tipo": "texto",
          "texto": "The **participle agrees** with the subject: **la casa fue vendida**, **los ladrones fueron arrestados**."
        },
        {
          "tipo": "texto",
          "texto": "Use it when the action matters more than who did it (agent omitted), or to highlight the agent with **por**."
        },
        {
          "tipo": "texto",
          "texto": "It's **much less common** than in English, mostly in news, history and formal writing. In conversation, Spanish prefers the active voice (**la policía arrestó a los ladrones**) or the passive **se** (**se vendió la casa**)."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **ser** + participle + **por**: the classic passive, best for headlines and history books."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "El incendio ==será apagado== muy pronto.",
              "en": "The fire will be put out very soon."
            },
            {
              "es": "Los ladrones ==fueron arrestados==.",
              "en": "The thieves were arrested."
            },
            {
              "es": "Las faltas ==son anotadas por== la secretaria.",
              "en": "Absences are recorded by the secretary."
            },
            {
              "es": "El señor López ==era muy apreciado por== todos los vecinos.",
              "en": "Mr. López was well liked by all the neighbors."
            },
            {
              "es": "_Pedro Páramo_ ==fue escrito por== Juan Rulfo.",
              "en": "Pedro Páramo was written by Juan Rulfo."
            },
            {
              "es": "Las pruebas ==serán analizadas por== la policía.",
              "en": "The evidence will be analyzed by the police."
            },
            {
              "es": "Chichén Itzá ==fue construida por== los mayas.",
              "en": "Chichén Itzá was built by the Maya."
            }
          ]
        }
      ]
