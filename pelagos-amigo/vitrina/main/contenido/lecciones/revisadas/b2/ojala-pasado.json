{
  "tema": 9105,
  "slug": "ojala-pasado",
  "titulo": "Ojalá with past subjunctive tenses",
  "subtitulo": "Ojalá tuviera más tiempo. Ojalá hubieras venido.",
  "foto": "t07.jpg",
  "regla": "Ojalá + present subjunctive = I hope (likely). Ojalá + imperfect subjunctive = I wish (unlikely now or in the future, or an unknown past). Ojalá + haya + participle = I hope it happened. Ojalá + hubiera + participle = I wish it had happened (but it didn't).",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Ojalá** (optionally **ojalá que**) always takes the subjunctive. The tense tells you how likely the wish is:"
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Form",
            "Meaning",
            "Example"
          ],
          "filas": [
            [
              "ojalá + present subjunctive",
              "hope, possible",
              "Ojalá venga."
            ],
            [
              "ojalá + imperfect subjunctive",
              "wish, unlikely (now or future); or a hope about the past",
              "Ojalá viniera. Ojalá tuviéramos más dinero."
            ],
            [
              "ojalá + haya + participle",
              "hope it already happened",
              "Ojalá haya llegado bien."
            ],
            [
              "ojalá + hubiera + participle",
              "wish about the past, it didn't happen (regret)",
              "Ojalá hubieras venido."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: the further back the tense, the further away the wish."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Ojalá que nos ==dejaran== ir a la fiesta de la prepa.",
              "en": "I wish they'd let us go to the high school party."
            },
            {
              "es": "Ojalá ==tuviéramos== más dinero para irnos al Caribe.",
              "en": "I wish we had more money to go to the Caribbean."
            },
            {
              "es": "Ojalá ==llegaran== a tiempo a la central.",
              "en": "I hope they made it to the bus station on time."
            },
            {
              "es": "Ojalá ==haya aprobado== el examen.",
              "en": "I hope she passed the exam."
            },
            {
              "es": "Ojalá ==hubieras venido== a la boda.",
              "en": "I wish you had come to the wedding."
            },
            {
              "es": "Ojalá no le ==hubiera dicho== nada.",
              "en": "I wish I hadn't told him anything."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
