{
  "tema": 8526,
  "slug": "un-tanto-algo",
  "titulo": "Un tanto / algo + adjective = a bit, somewhat",
  "subtitulo": "Es un tanto raro. Estamos algo cansados.",
  "foto": "t08.jpg",
  "regla": "Un tanto + adjective and algo + adjective = a bit, somewhat, slightly: un lugar un tanto siniestro, algo cansados. Both are invariable; the adjective still agrees. Un poco is the everyday equivalent.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "un tanto / algo",
            "+ adjective (or adverb)"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Both mean _a bit, somewhat, slightly_. **Un poco** is the everyday version; **un tanto** sounds a bit more refined."
        },
        {
          "tipo": "texto",
          "texto": "**Un tanto** and **algo** never change; the **adjective agrees** with the noun."
        },
        {
          "tipo": "texto",
          "texto": "Don't confuse with **tanto** = _so much_ (**tanto dinero**)."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **un tanto** is a pinch, not a handful."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
