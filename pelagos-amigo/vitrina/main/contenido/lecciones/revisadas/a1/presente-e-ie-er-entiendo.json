{
  "tema": 5812,
  "slug": "presente-e-ie-er-entiendo",
  "titulo": "-er verbs with e > ie in the present",
  "subtitulo": "No entiendo, ¿me lo explicas?",
  "foto": "t04.jpg",
  "regla": "Some -er verbs change the stressed e of the stem to ie in the present, in every person except nosotros: entiendo, entiendes, entiende, entendemos, entienden.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Some -er verbs change **e → ie** in the stem: **entender**, **querer**, **perder**, **encender**, **defender**."
        },
        {
          "tipo": "texto",
          "texto": "The change happens in **every person except nosotros**, where the stress falls on the ending: **entendemos**, **queremos**."
        },
        {
          "tipo": "texto",
          "texto": "The endings are the regular -er ones: **-o, -es, -e, -emos, -en**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "entender",
            "querer"
          ],
          "filas": [
            [
              "yo",
              "entiendo",
              "quiero"
            ],
            [
              "tú",
              "entiendes",
              "quieres"
            ],
            [
              "él / ella / usted",
              "entiende",
              "quiere"
            ],
            [
              "nosotros",
              "entendemos",
              "queremos"
            ],
            [
              "ellos / ellas / ustedes",
              "entienden",
              "quieren"
            ]
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "No ==entiendo== la pregunta.",
              "en": "I don't understand the question."
            },
            {
              "es": "¿==Quieres== ir a surfear el sábado?",
              "en": "Do you want to go surfing on Saturday?"
            },
            {
              "es": "Mi hermano siempre ==pierde== las llaves.",
              "en": "My brother always loses his keys."
            },
            {
              "es": "Nosotros ==entendemos== el plan.",
              "en": "We understand the plan."
            },
            {
              "es": "¿Ustedes ==quieren== tacos o tortas?",
              "en": "Do you want tacos or tortas?"
            },
            {
              "es": "==Enciendo== la luz de la cocina.",
              "en": "I turn on the kitchen light."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
