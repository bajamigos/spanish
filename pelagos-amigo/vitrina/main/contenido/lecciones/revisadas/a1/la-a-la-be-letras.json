{
  "tema": 9318,
  "slug": "la-a-la-be-letras",
  "titulo": "Letters of the alphabet are feminine",
  "subtitulo": "La a, la be, la hache, la eñe.",
  "foto": "t09.jpg",
  "regla": "Letters of the alphabet are feminine, because they stand for la letra: la a, la eme, una hache. This stays true even for letters starting with a stressed a sound: la a, la hache, not el.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Letters are **feminine**, because they mean **la letra**: **la a**, **la be**, **una eme**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Letter",
            "Name"
          ],
          "filas": [
            [
              "a",
              "la a"
            ],
            [
              "b",
              "la be (be grande)"
            ],
            [
              "h",
              "la hache"
            ],
            [
              "j",
              "la jota"
            ],
            [
              "ñ",
              "la eñe"
            ],
            [
              "v",
              "la ve (ve chica)"
            ],
            [
              "x",
              "la equis"
            ],
            [
              "y",
              "la ye (i griega)"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "No exception for a stressed **a** sound: **la a**, **una a**, **la hache**. Never **el a** or **el hache**."
        },
        {
          "tipo": "texto",
          "texto": "Plural: **las aes**, **las emes**, **las erres**. **Equis** stays the same: **las equis**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==La hache== no suena.",
              "en": "The h is silent."
            },
            {
              "es": "Mi apellido empieza con ==la ge==.",
              "en": "My last name starts with g."
            },
            {
              "es": "Escribe ==una eme== mayúscula.",
              "en": "Write a capital M."
            },
            {
              "es": "Te faltó ==la ese== al final.",
              "en": "You left off the s at the end."
            },
            {
              "es": "«Perro» tiene dos ==erres==.",
              "en": "\"Perro\" has two r's."
            },
            {
              "es": "==La equis== de «México» suena como jota.",
              "en": "The x in \"México\" sounds like a j."
            }
          ]
        }
      ]
    },
