  "slug": "corrijo-elijo-presente",
  "titulo": "Corregir and elegir in the present",
  "subtitulo": "Yo elijo la tabla, tú eliges las olas.",
  "foto": "t06.jpg",
  "regla": "Corregir and elegir change e to i in every person except nosotros, and in yo the g becomes j: corrijo, corriges, corregimos; elijo, eliges, elegimos.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Corregir** (_to correct_) and **elegir** (_to choose_) have **two changes** in the present."
        },
        {
          "tipo": "texto",
          "texto": "**e → i** in the stem, in **every person except nosotros**: **corriges**, **eliges**, but **corregimos**, **elegimos**."
        },
        {
          "tipo": "texto",
          "texto": "**g → j** only in **yo**, to keep the soft sound before **o**: **corrijo**, **elijo**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "corregir",
            "elegir"
          ],
          "filas": [
            [
              "yo",
              "corrijo",
              "elijo"
            ],
            [
              "tú",
              "corriges",
              "eliges"
            ],
            [
              "él / ella / usted",
              "corrige",
              "elige"
            ],
            [
              "nosotros",
              "corregimos",
              "elegimos"
            ],
            [
              "ellos / ellas / ustedes",
              "corrigen",
              "eligen"
            ]
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "El maestro ==corrige== los exámenes.",
