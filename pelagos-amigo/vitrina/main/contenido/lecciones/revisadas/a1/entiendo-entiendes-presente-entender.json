{
  "tema": 5809,
  "slug": "entiendo-entiendes-presente-entender",
  "titulo": "Entender in the present",
  "subtitulo": "No entiendo la pregunta.",
  "foto": "t07.jpg",
  "regla": "Entender (to understand) changes the last e of the stem to ie in every form except nosotros: entiendo, entiendes, entiende, entendemos, entienden.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Entender** (_to understand_) is a stem-changing verb: the **second e** (en-**te**n-der) becomes **ie**."
        },
        {
          "tipo": "texto",
          "texto": "**Nosotros** keeps the e: **entendemos**. The endings are regular -er endings."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "entender"
          ],
          "filas": [
            [
              "yo",
              "**entiendo**"
            ],
            [
              "tú",
              "**entiendes**"
            ],
            [
              "él, ella, usted",
              "**entiende**"
            ],
            [
              "nosotros",
              "entendemos"
            ],
            [
              "ellos, ustedes",
              "**entienden**"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: the change happens where the stress falls: en-**TIEN**-do, but en-ten-**DE**-mos."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "No ==entiendo== la pregunta.",
              "en": "I don't understand the question."
            },
            {
              "es": "¿Me ==entiendes==?",
              "en": "Do you understand me?"
            },
            {
              "es": "Mi perro ==entiende== español e inglés.",
              "en": "My dog understands Spanish and English."
            },
            {
              "es": "==Entendemos== las reglas del jiu-jitsu.",
              "en": "We understand the rules of jiu-jitsu."
            },
            {
              "es": "Mis papás no ==entienden== mi trabajo.",
              "en": "My parents don't understand my job."
            },
            {
              "es": "Ah, ya ==entiendo==.",
              "en": "Oh, now I get it."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Yo no entendo."
                },
