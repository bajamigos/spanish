                  "t": "Nosotros entendemos todo."
                }
              ],
              "nota": "No change in nosotros."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "No entiendo a ti."
                },
                {
                  "v": "bien",
                  "t": "No te entiendo."
                }
              ],
              "nota": "Use the pronoun **te** before the verb."
            }
          ]
        }
      ]
    },
