{
  "tema": 5092,
  "slug": "estoy-estar-gerundio",
  "titulo": "Present progressive: estar + gerund",
  "subtitulo": "«Estoy manejando, te llamo al rato.»",
  "foto": "t07.jpg",
  "regla": "To say what is happening right now, use estar in the present + the gerund: estoy manejando, están comiendo. Never ser, never the gerund alone, and not for future plans.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "For an action **in progress right now**, use **estar** + **gerund**."
        },
        {
          "tipo": "formula",
          "partes": [
            "estar",
            "+",
            "gerund (-ando / -iendo)"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "",
            "estar",
            "+ gerund"
          ],
          "filas": [
            [
              "yo",
              "**estoy**",
              "trabajando"
            ],
            [
              "tú",
              "**estás**",
              "comiendo"
            ],
            [
              "él / ella / usted",
              "**está**",
              "escribiendo"
            ],
            [
              "nosotros",
              "**estamos**",
              "esperando"
            ],
            [
              "ustedes / ellos / ellas",
              "**están**",
              "entrenando"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Only **estar** changes; the gerund stays the same. It's **not** for plans: for tomorrow, use **voy a** or the simple present."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Estoy manejando==, te llamo al rato.",
              "en": "I'm driving, I'll call you later."
            },
            {
              "es": "¿Qué ==estás haciendo==?",
              "en": "What are you doing?"
            },
            {
              "es": "Mi papá ==está viendo== el partido.",
              "en": "My dad is watching the game."
            },
            {
              "es": "==Estamos esperando== el camión.",
              "en": "We're waiting for the bus."
            },
            {
              "es": "Las olas ==están creciendo==.",
              "en": "The waves are getting bigger."
            },
            {
              "es": "Mis amigos ==están entrenando== en el gym.",
              "en": "My friends are training at the gym."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
