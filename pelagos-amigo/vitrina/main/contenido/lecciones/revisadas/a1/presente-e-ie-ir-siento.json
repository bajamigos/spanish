{
  "tema": 5574,
  "slug": "presente-e-ie-ir-siento",
  "titulo": "-ir verbs with e > ie in the present",
  "subtitulo": "Lo siento mucho.",
  "foto": "t03.jpg",
  "regla": "Some -ir verbs change the stressed e of the stem to ie in the present, in every person except nosotros: siento, sientes, siente, sentimos, sienten.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Some -ir verbs change **e → ie** in the stem: **sentir**, **preferir**, **mentir**, **divertirse**, **sugerir**, **convertir**."
        },
        {
          "tipo": "texto",
          "texto": "The change happens in **every person except nosotros**: **prefiero**, but **preferimos**."
        },
        {
          "tipo": "texto",
          "texto": "The endings are the regular -ir ones: **-o, -es, -e, -imos, -en**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "sentir",
            "preferir"
          ],
          "filas": [
            [
              "yo",
              "siento",
              "prefiero"
            ],
            [
              "tú",
              "sientes",
              "prefieres"
            ],
            [
              "él / ella / usted",
              "siente",
              "prefiere"
            ],
            [
              "nosotros",
              "sentimos",
              "preferimos"
            ],
            [
              "ellos / ellas / ustedes",
              "sienten",
              "prefieren"
            ]
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Lo ==siento== mucho.",
              "en": "I'm very sorry."
            },
            {
              "es": "¿==Prefieres== café o té?",
              "en": "Do you prefer coffee or tea?"
            },
            {
              "es": "Ella nunca ==miente==.",
              "en": "She never lies."
            },
            {
              "es": "==Preferimos== la playa.",
              "en": "We prefer the beach."
            },
            {
              "es": "Ustedes se ==divierten== mucho en el torneo.",
              "en": "You all have a lot of fun at the tournament."
            },
            {
              "es": "¿Cómo te ==sientes== hoy?",
              "en": "How do you feel today?"
            }
          ]
        }
      ]
    },
    {
