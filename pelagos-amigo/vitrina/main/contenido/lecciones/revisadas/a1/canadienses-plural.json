{
  "tema": 6801,
  "slug": "canadienses-plural",
  "titulo": "Plural of nationalities in -e",
  "subtitulo": "«Mis primos son canadienses.»",
  "foto": "t09.jpg",
  "regla": "Nationality and origin adjectives ending in -e (canadiense, estadounidense) form the plural by adding -s, for masculine and feminine alike: canadienses.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Adjectives of origin ending in **-e** have one form for both genders: **canadiense**."
        },
        {
          "tipo": "texto",
          "texto": "For the plural, just add **-s**: **canadienses**, **estadounidenses**, **nicaragüenses**."
        },
        {
          "tipo": "formula",
          "partes": [
            "canadiense",
            "+ s =",
            "canadienses"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: men, women or a mixed group: always **-enses**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Mis primos son ==canadienses==.",
              "en": "My cousins are Canadian."
            },
            {
              "es": "Hay muchos turistas ==estadounidenses== en Rosarito.",
              "en": "There are lots of American tourists in Rosarito."
            },
            {
              "es": "Mis amigas son ==nicaragüenses==.",
              "en": "My friends are Nicaraguan."
            },
            {
              "es": "Los surfistas ==costarricenses== son muy buenos.",
              "en": "Costa Rican surfers are really good."
            },
            {
              "es": "Somos ==sonorenses==.",
              "en": "We're from Sonora."
            },
            {
              "es": "Me gustan las bandas ==sinaloenses==.",
              "en": "I like bands from Sinaloa."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
