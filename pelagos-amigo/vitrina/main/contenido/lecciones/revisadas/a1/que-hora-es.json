  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Ask: **¿Qué hora es?** Answer with **ser** + **la / las** + hour."
        },
        {
          "tipo": "texto",
          "texto": "**Es la una** (only 1:00 to 1:59). Every other hour: **son las** dos, tres, cuatro..."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Time",
            "Spanish"
          ],
          "filas": [
            [
              "1:00",
              "Es la una."
            ],
            [
              "2:00",
              "Son las dos."
            ],
            [
              "3:10",
              "Son las tres y diez."
            ],
            [
              "4:15",
              "Son las cuatro y cuarto."
            ],
            [
              "5:30",
              "Son las cinco y media."
            ],
            [
              "6:45",
              "Son las siete menos cuarto."
            ],
            [
              "8:50",
              "Son las nueve menos diez."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Add **de la mañana**, **de la tarde** or **de la noche**. In Mexico you'll also hear **diez para las nueve** (8:50)."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
