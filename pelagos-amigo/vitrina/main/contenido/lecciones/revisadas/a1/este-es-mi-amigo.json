{
  "tema": 5995,
  "slug": "este-es-mi-amigo",
  "titulo": "Ser to introduce people",
  "subtitulo": "Este es mi amigo Beto.",
  "foto": "t06.jpg",
  "regla": "To introduce someone (or yourself), use ser: soy Claude, este es Beto, esta es mi hermana, estos son mis papás. Never estar.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To **introduce** someone, use **ser**. Never **estar**."
        },
        {
          "tipo": "formula",
          "partes": [
            "este / esta / estos / estas",
            "+ es / son +",
            "person"
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Este** or **esta** matches the person: **este es** Beto, **esta es** Ana. For more than one: **estos son**, **estas son**."
        },
        {
          "tipo": "texto",
          "texto": "Yourself: **soy** + name. Tip: **ser** says _who_; **estar** only says _where_ or _how_."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Hola, ==soy== Claude.",
              "en": "Hi, I'm Claude."
            },
            {
              "es": "==Este es== mi amigo Beto.",
              "en": "This is my friend Beto."
            },
            {
              "es": "==Esta es== Mariana, mi novia.",
              "en": "This is Mariana, my girlfriend."
            },
            {
              "es": "==Estos son== mis papás.",
              "en": "These are my parents."
            },
            {
              "es": "==Estas son== mis compañeras de trabajo.",
              "en": "These are my coworkers."
            },
            {
              "es": "Mira, ==ella es== Sofía, mi entrenadora.",
              "en": "Look, this is Sofía, my coach."
            }
          ]
        }
      ]
    },
    {
