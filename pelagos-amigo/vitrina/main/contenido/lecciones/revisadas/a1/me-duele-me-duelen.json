{
  "tema": 5878,
  "slug": "me-duele-me-duelen",
  "titulo": "Doler: to say something hurts",
  "subtitulo": "«Me duele la cabeza.»",
  "foto": "t02.jpg",
  "regla": "Doler works like gustar: me duele + one thing, me duelen + several: me duele la cabeza, me duelen los pies. Body parts take el, la, los, las.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Doler** works like **gustar**: the body part is the subject. One thing: **duele**. Several: **duelen**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "What hurts",
            "Form",
            "Example"
          ],
          "filas": [
            [
              "one thing",
              "me duele",
              "Me duele la cabeza."
            ],
            [
              "several things",
              "me duelen",
              "Me duelen los pies."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Who it hurts: **me, te, le, nos, les**. To ask: **¿Qué te duele?**"
        },
        {
          "tipo": "texto",
          "texto": "Body parts take **el, la, los, las**: **me duele la espalda**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Me duele== la cabeza.",
              "en": "I have a headache."
            },
            {
              "es": "==Me duelen== las piernas después del entrenamiento.",
              "en": "My legs hurt after training."
            },
            {
              "es": "¿==Te duele== la rodilla?",
              "en": "Does your knee hurt?"
            },
            {
              "es": "A mi papá ==le duele== la espalda.",
              "en": "My dad's back hurts."
            },
            {
              "es": "¿Qué ==te duele==?",
              "en": "What hurts?"
            },
            {
              "es": "==Me duelen== los hombros de tanto remar.",
              "en": "My shoulders hurt from paddling so much."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
