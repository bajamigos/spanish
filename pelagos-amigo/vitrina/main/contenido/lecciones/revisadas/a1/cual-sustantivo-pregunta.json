        }
      ]
    },
    {
      "id": "kwiz",
      "titulo": "Check yourself",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Say it out loud, then open the answer."
        },
        {
          "tipo": "mini_kwiz",
          "lista": [
            {
              "p": "In Spanish, using cuál: _Which bus goes to the beach?_",
              "r": "¿Cuál camión va a la playa?",
              "nota": "cuál + singular noun."
            },
            {
              "p": "Fix it: _¿Cuál zapatos te gustan?_",
              "r": "¿Cuáles zapatos te gustan?",
              "nota": "Plural: cuáles."
            },
            {
              "p": "Fix it: _¿Cual tabla es tuya?_",
              "r": "¿Cuál tabla es tuya?",
              "nota": "Accent on cuál."
            }
