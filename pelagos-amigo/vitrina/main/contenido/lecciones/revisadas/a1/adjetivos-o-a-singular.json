              "nota": "mamá is feminine."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "El problema es complicada."
                },
                {
                  "v": "bien",
                  "t": "El problema es complicado."
                }
              ],
              "nota": "problema is masculine."
            }
          ]
        }
      ]
    },
