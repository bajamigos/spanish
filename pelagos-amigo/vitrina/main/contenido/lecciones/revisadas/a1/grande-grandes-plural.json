{
  "tema": 6051,
  "slug": "grande-grandes-plural",
  "titulo": "Plural of adjectives in -e and -a",
  "subtitulo": "«Mis amigas son muy alegres.»",
  "foto": "t04.jpg",
  "regla": "Adjectives ending in -e or -a (grande, idealista) have one form for masculine and feminine. To make them plural, just add -s: grandes, idealistas.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Adjectives ending in **-e** (**grande, alegre, inteligente**) or **-a** (**idealista, optimista**) are the same for masculine and feminine."
        },
        {
          "tipo": "texto",
          "texto": "For the plural, add **-s**. Nothing else changes."
        },
        {
          "tipo": "formula",
          "partes": [
            "grande / idealista",
            "+ s =",
            "grandes / idealistas"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **-ista** never turns into **-isto**, even with a masculine noun."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Las olas están ==grandes== hoy.",
              "en": "The waves are big today."
            },
            {
              "es": "Mis amigos son muy ==optimistas==.",
              "en": "My friends are very optimistic."
            },
            {
              "es": "Tengo dos perros muy ==inteligentes==.",
              "en": "I have two very smart dogs."
            },
            {
              "es": "Mis hermanas son muy ==alegres==.",
              "en": "My sisters are very cheerful."
            },
            {
              "es": "Las casas ==verdes== son de mis tíos.",
              "en": "The green houses belong to my aunt and uncle."
            },
            {
              "es": "Los burritos de aquí son ==enormes==.",
              "en": "The burritos here are huge."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Las casas son grandas."
                },
                {
                  "v": "bien",
                  "t": "Las casas son grandes."
                }
              ],
              "nota": "**-e** stays **-e**: just add **-s**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Mis amigos son optimistos."
                },
                {
                  "v": "bien",
                  "t": "Mis amigos son optimistas."
                }
              ],
              "nota": "**-ista** is for both genders."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Los niños son inteligente."
                },
                {
                  "v": "bien",
                  "t": "Los niños son inteligentes."
                }
              ],
              "nota": "Plural noun, plural adjective."
            }
          ]
        }
      ]
    },
    {
