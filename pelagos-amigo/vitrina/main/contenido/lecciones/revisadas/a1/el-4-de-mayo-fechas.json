{
  "tema": 6746,
  "slug": "el-4-de-mayo-fechas",
  "titulo": "Expressing dates",
  "subtitulo": "El 4 de mayo de 2026.",
  "foto": "t10.jpg",
  "regla": "Dates follow el + number + de + month (+ de + year): el 4 de mayo de 2026. Use plain numbers, except that the 1st is often el primero. Months are lowercase, and el already means on.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "The pattern is **el + number + de + month**, then **de + year** if you need it."
        },
        {
          "tipo": "formula",
          "partes": [
            "el 4",
            "+ de +",
            "mayo (+ de 2026)"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Use plain numbers: **el 4**, **el 20**. Only the 1st is usually **el primero** (**el 1** is fine too)."
        },
        {
          "tipo": "texto",
          "texto": "**El** already means _on_: **Nací el 3 de marzo**, never **en el**. Months are **lowercase**. With a day name: **el lunes 4 de mayo**."
        },
        {
          "tipo": "texto",
          "texto": "To ask: **¿Qué fecha es hoy?** Answer: **Hoy es 17 de octubre.**"
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Nací ==el 12 de julio de 1990==.",
              "en": "I was born on July 12th, 1990."
            },
            {
              "es": "Hoy es ==17 de octubre==.",
              "en": "Today is October 17th."
            },
            {
              "es": "La fiesta es ==el sábado 7 de noviembre==.",
              "en": "The party is on Saturday, November 7th."
            },
            {
              "es": "==El primero de enero== no trabajo.",
              "en": "I don't work on January 1st."
            },
            {
              "es": "El torneo es ==el 5 de diciembre==.",
              "en": "The tournament is on December 5th."
            },
            {
              "es": "Mi cumpleaños es ==el 30 de abril==.",
              "en": "My birthday is April 30th."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Mayo 4"
                },
                {
                  "v": "bien",
                  "t": "el 4 de mayo"
                }
              ],
              "nota": "Day first, then **de** + month."
            },
            {
