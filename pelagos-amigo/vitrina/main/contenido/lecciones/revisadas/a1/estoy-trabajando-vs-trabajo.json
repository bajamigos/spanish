{
  "tema": 5994,
  "slug": "estoy-trabajando-vs-trabajo",
  "titulo": "Present progressive vs present",
  "subtitulo": "«Trabajo en un banco, pero este mes estoy trabajando en casa.»",
  "foto": "t08.jpg",
  "regla": "Use the simple present for what is permanent or usual (trabajo en un banco) and estar + gerund for what is happening right now or only for a while (este mes estoy trabajando en casa). State verbs like tener, saber and ser usually don't go in the progressive.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Simple present**: what you **always** or **usually** do, what is permanent: **Vivo en Tijuana.**"
        },
        {
          "tipo": "texto",
          "texto": "**Estar + gerund**: what is happening **right now**, or a **temporary** situation: **Ahora estoy viviendo con mis papás.**"
        },
        {
          "tipo": "texto",
          "texto": "Words like **ahora, en este momento, este mes, estos días** often go with the progressive."
        },
        {
          "tipo": "texto",
          "texto": "Verbs of state (**tener** _to have_, **saber**, **ser**) usually stay in the simple present."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Trabajo== en un hotel.",
              "en": "I work at a hotel."
            },
            {
              "es": "Este verano ==estoy trabajando== en Rosarito.",
              "en": "This summer I'm working in Rosarito."
            },
            {
              "es": "==Vivo== en Tijuana desde niño.",
              "en": "I've lived in Tijuana since I was a kid."
            },
            {
              "es": "Ahora ==estoy viviendo== con mis papás.",
              "en": "Right now I'm living with my parents."
            },
            {
              "es": "Normalmente ==surfeo== los sábados.",
              "en": "I usually surf on Saturdays."
            },
            {
              "es": "Shh, el bebé ==está durmiendo==.",
              "en": "Shh, the baby is sleeping."
            }
          ]
        }
      ]
    },
