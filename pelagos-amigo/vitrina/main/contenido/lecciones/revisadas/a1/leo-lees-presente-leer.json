{
  "tema": 5589,
  "slug": "leo-lees-presente-leer",
  "titulo": "Leer in the present",
  "subtitulo": "Leo las noticias en el celular.",
  "foto": "t08.jpg",
  "regla": "Leer (to read) is regular in the present: le- + -o, -es, -e, -emos, -en gives leo, lees, lee, leemos, leen. Every form except leo has two e's in a row.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Leer** (_to read_) is a **regular -er verb** in the present."
        },
        {
          "tipo": "texto",
          "texto": "The stem **le-** ends in e, so the -er endings add a second e: **lees, lee, leemos, leen**. Only **leo** has one."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "leer"
          ],
          "filas": [
            [
              "yo",
              "leo"
            ],
            [
              "tú",
              "lees"
            ],
            [
              "él, ella, usted",
              "lee"
            ],
            [
              "nosotros",
              "leemos"
            ],
            [
              "ellos, ustedes",
              "leen"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Creer** (_to believe_) works the same way: creo, crees, cree, creemos, creen."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Leo== las noticias en el celular.",
              "en": "I read the news on my phone."
            },
            {
              "es": "¿==Lees== novelas de ciencia ficción?",
              "en": "Do you read science fiction novels?"
            },
            {
              "es": "Mi hija ==lee== muy rápido.",
              "en": "My daughter reads very fast."
            },
            {
              "es": "==Leemos== el menú antes de pedir.",
              "en": "We read the menu before ordering."
            },
            {
              "es": "Los alumnos ==leen== en voz alta.",
              "en": "The students read out loud."
            },
            {
              "es": "¿==Crees== que va a llover?",
              "en": "Do you think it's going to rain?"
            }
          ]
        }
      ]
    },
    {
