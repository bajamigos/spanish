  "titulo": "Ser in the present",
  "subtitulo": "Soy de Tijuana. ¿Tú eres de aquí?",
  "foto": "t04.jpg",
  "regla": "Ser (to be) is irregular in every person: soy, eres, es, somos, son. Usted shares es with él and ella; ustedes shares son with ellos.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Ser** (_to be_) is irregular in **every** form. Learn the five forms by heart."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "ser"
          ],
          "filas": [
            [
              "yo",
              "**soy**"
            ],
            [
              "tú",
              "**eres**"
            ],
            [
              "él, ella, usted",
              "**es**"
            ],
            [
              "nosotros",
              "**somos**"
            ],
            [
              "ellos, ustedes",
              "**son**"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Usted** uses the same form as él and ella (**es**); **ustedes** the same as ellos (**son**)."
        },
        {
          "tipo": "texto",
          "texto": "Use it for what someone or something **is**: name, origin, job, description."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Soy== de Tijuana.",
              "en": "I'm from Tijuana."
            },
            {
              "es": "¿==Eres== surfista?",
              "en": "Are you a surfer?"
            },
            {
              "es": "Mi hermana ==es== doctora.",
              "en": "My sister is a doctor."
            },
            {
              "es": "==Somos== amigos desde la prepa.",
              "en": "We've been friends since high school."
            },
            {
              "es": "Ustedes ==son== muy amables.",
              "en": "You're all very kind."
            },
            {
              "es": "La clase de jiu-jitsu ==es== a las siete.",
              "en": "Jiu-jitsu class is at seven."
            }
          ]
        }
      ]
    },
