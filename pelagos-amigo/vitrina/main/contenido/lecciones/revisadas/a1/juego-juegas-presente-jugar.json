{
  "tema": 5855,
  "slug": "juego-juegas-presente-jugar",
  "titulo": "Jugar in the present",
  "subtitulo": "Juego futbol los sábados.",
  "foto": "t09.jpg",
  "regla": "Jugar (to play a game or sport) changes u to ue in every form except nosotros: juego, juegas, juega, jugamos, juegan. It is the only verb with u > ue.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Jugar** (_to play_ a game or sport) changes **u → ue** in the stem."
        },
        {
          "tipo": "texto",
          "texto": "**Nosotros** keeps the u: **jugamos**. The endings are regular -ar endings."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "jugar"
          ],
          "filas": [
            [
              "yo",
              "**juego**"
            ],
            [
              "tú",
              "**juegas**"
            ],
            [
              "él, ella, usted",
              "**juega**"
            ],
            [
              "nosotros",
              "jugamos"
            ],
            [
              "ellos, ustedes",
              "**juegan**"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "It's the only verb with **u → ue**, so it works like o → ue verbs (puedo, cuento). In Mexico you usually say **jugar futbol**, without _a_."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Juego== futbol los sábados.",
              "en": "I play soccer on Saturdays."
            },
            {
              "es": "¿==Juegas== ajedrez?",
              "en": "Do you play chess?"
            },
            {
              "es": "Mi sobrino ==juega== videojuegos toda la tarde.",
              "en": "My nephew plays video games all afternoon."
            },
            {
              "es": "==Jugamos== lotería con mis tíos.",
              "en": "We play lotería with my aunts and uncles."
            },
            {
              "es": "Los niños ==juegan== en la playa.",
              "en": "The kids play on the beach."
            },
            {
              "es": "¿A qué hora ==juegan== las Chivas?",
              "en": "What time do the Chivas play?"
            }
          ]
        }
      ]
    },
    {
