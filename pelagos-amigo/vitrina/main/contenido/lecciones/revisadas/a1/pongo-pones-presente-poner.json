{
  "tema": 5305,
  "slug": "pongo-pones-presente-poner",
  "titulo": "Poner in the present",
  "subtitulo": "Yo pongo la música.",
  "foto": "t02.jpg",
  "regla": "Poner (to put) is regular in the present except yo: pongo. The rest: pones, pone, ponemos, ponen.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Poner** means _to put_ or _to place_. It's also _to turn on_ (music, the TV) and _to set_ (the table)."
        },
        {
          "tipo": "texto",
          "texto": "Only **yo** is irregular: **pongo**, with a **g**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "Present"
          ],
          "filas": [
            [
              "yo",
              "**pongo**"
            ],
            [
              "tú",
              "pones"
            ],
            [
              "él / ella / usted",
              "pone"
            ],
            [
              "nosotros / nosotras",
              "ponemos"
            ],
            [
              "ellos / ellas / ustedes",
              "ponen"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "The other forms follow the regular **-er** pattern."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Pongo== la tabla en el carro.",
              "en": "I put the board in the car."
            },
            {
              "es": "¿Dónde ==pones== las llaves?",
              "en": "Where do you put the keys?"
            },
            {
              "es": "Mi mamá ==pone== la mesa.",
              "en": "My mom sets the table."
            },
            {
              "es": "==Ponemos== música mientras cocinamos.",
              "en": "We put music on while we cook."
            },
            {
              "es": "Ellos ==ponen== las plantas al sol.",
              "en": "They put the plants in the sun."
            },
            {
              "es": "Siempre ==pongo== mucha salsa en los tacos.",
              "en": "I always put a lot of salsa on my tacos."
            }
          ]
        }
      ]
    },
    {
