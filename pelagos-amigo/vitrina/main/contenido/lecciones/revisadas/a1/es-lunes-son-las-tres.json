    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To say **what time, day, date or season it is**, use **ser**."
        },
        {
          "tipo": "texto",
          "texto": "Time: **es** la una, **son** las dos, las tres... Days, dates and seasons: **es**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "What",
            "Example"
          ],
          "filas": [
            [
              "time",
              "Son las tres."
            ],
            [
              "day",
              "Hoy es lunes."
            ],
            [
              "date",
              "Hoy es 4 de mayo."
            ],
            [
              "season",
              "Es verano."
            ],
            [
              "early / late",
              "Ya es tarde."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **ser** is the calendar on the wall. You just read it."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Son== las seis y ya hay olas.",
              "en": "It's six and there are already waves."
            },
            {
              "es": "==Es== la una. Vamos a comer.",
              "en": "It's one o'clock. Let's go eat."
            },
            {
              "es": "Hoy ==es== viernes.",
              "en": "Today is Friday."
            },
            {
