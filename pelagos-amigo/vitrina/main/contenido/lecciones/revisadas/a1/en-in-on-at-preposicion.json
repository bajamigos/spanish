{
  "tema": 7919,
  "slug": "en-in-on-at-preposicion",
  "titulo": "En = in, on, at",
  "subtitulo": "Estoy en la playa.",
  "foto": "t02.jpg",
  "regla": "En means in, on, inside or at for where someone or something is (estoy en casa, las llaves están en la mesa). It also goes with transport (en camión), months and years (en octubre).",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**En** = _in, on, inside, at_ for **where** something is or happens: **Vivo en Tijuana.** **Está en la mesa.**"
        },
        {
          "tipo": "texto",
          "texto": "**En** is for **being** somewhere; for **going** somewhere, use **a**: **Estoy en la playa** but **Voy a la playa**."
        },
        {
          "tipo": "texto",
          "texto": "Also: transport (**en carro**, **en camión**), months and years (**en octubre**, **en 2025**)."
        },
        {
          "tipo": "texto",
          "texto": "Not with days of the week: **el lunes**, never **en el lunes**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Vivo ==en== Tijuana.",
              "en": "I live in Tijuana."
            },
            {
              "es": "Las llaves están ==en== la mesa.",
              "en": "The keys are on the table."
            },
            {
              "es": "Estoy ==en== casa.",
              "en": "I'm at home."
            },
            {
              "es": "Trabajo ==en== una escuela.",
              "en": "I work at a school."
            },
            {
              "es": "Vamos ==en== camión.",
              "en": "We're going by bus."
            },
            {
              "es": "Mi cumpleaños es ==en== octubre.",
              "en": "My birthday is in October."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Estoy a casa."
                },
                {
                  "v": "bien",
                  "t": "Estoy en casa."
                }
              ],
              "nota": "Being somewhere: **en**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Vivo a Tijuana."
                },
                {
                  "v": "bien",
                  "t": "Vivo en Tijuana."
                }
              ],
              "nota": "Live _in_ = vivir **en**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Mi cumpleaños es en el lunes."
                },
                {
                  "v": "bien",
                  "t": "Mi cumpleaños es el lunes."
                }
              ],
              "nota": "Days take **el**, no **en**."
            }
          ]
        }
      ]
    },
    {
      "id": "parientes",
      "titulo": "Related rules",
