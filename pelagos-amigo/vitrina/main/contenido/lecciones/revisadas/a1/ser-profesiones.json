{
  "tema": 6090,
  "slug": "ser-profesiones",
  "titulo": "Ser for professions",
  "subtitulo": "Soy cerrajero, ella es doctora.",
  "foto": "t08.jpg",
  "regla": "To say what someone does for a living, use ser + the profession, with no un or una: soy cerrajero, es doctora. Never estar.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To say what someone **does for a living**, use **ser** + profession."
        },
        {
          "tipo": "formula",
          "partes": [
            "ser",
            "+",
            "profession (no un / una)"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Most jobs change for women: **doctor / doctora**, **maestro / maestra**. Jobs in **-ista** don't: **el / la dentista**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: your job is part of _who_ you are on your ID, so it takes **ser**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Soy== cerrajero.",
              "en": "I'm a locksmith."
            },
            {
              "es": "Mi hermana ==es== doctora.",
              "en": "My sister is a doctor."
            },
            {
              "es": "¿Tú ==eres== ingeniero?",
              "en": "Are you an engineer?"
            },
            {
              "es": "Mi papá ==es== mecánico.",
              "en": "My dad is a mechanic."
            },
            {
              "es": "==Somos== maestros de inglés.",
              "en": "We're English teachers."
            },
            {
              "es": "La novia de Beto ==es== dentista.",
              "en": "Beto's girlfriend is a dentist."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Estoy maestro."
                },
                {
                  "v": "bien",
                  "t": "Soy maestro."
                }
              ]
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Mi mamá está enfermera."
                },
                {
                  "v": "bien",
                  "t": "Mi mamá es enfermera."
                }
              ],
              "nota": "For a temporary job, see **estar de** below."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Ella es abogado."
                },
                {
                  "v": "bien",
                  "t": "Ella es abogada."
                }
              ],
              "nota": "The job agrees with the person."
            }
          ]
        }
      ]
    },
    {
      "id": "parientes",
      "titulo": "Related rules",
      "bloques": [
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "soy maestro",
              "texto": "No un / una: [[6131|zero article with professions]]."
            },
            {
              "forma": "está de mesero",
              "texto": "A temporary job: [[5982|estar de]]."
            }
          ]
        }
      ]
    },
    {
      "id": "kwiz",
      "titulo": "Check yourself",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Say it out loud, then open the answer."
        },
        {
          "tipo": "mini_kwiz",
          "lista": [
            {
              "p": "In Spanish: _She's an engineer._",
              "r": "Es ingeniera.",
