{
  "tema": 10695,
  "slug": "cuando-pregunta",
  "titulo": "How to ask when: ¿cuándo?",
  "subtitulo": "¿Cuándo es tu cumpleaños?",
  "foto": "t02.jpg",
  "regla": "To ask when, use ¿Cuándo + verb + subject? Cuándo always has a written accent in questions, and the verb comes right after it. For an exact clock time, ask ¿A qué hora?",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "_When?_ = **¿Cuándo?**, always with a written accent in questions."
        },
        {
          "tipo": "formula",
          "partes": [
            "¿Cuándo",
            "+ verb +",
            "(subject)?"
          ]
        },
        {
          "tipo": "texto",
          "texto": "The verb comes **right after cuándo**: **¿Cuándo llega tu hermano?**"
        },
        {
          "tipo": "texto",
          "texto": "For an exact time, ask **¿A qué hora...?** Without the accent, **cuando** isn't a question: **Surfeo cuando hay olas.**"
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "¿==Cuándo== es tu cumpleaños?",
              "en": "When is your birthday?"
            },
            {
              "es": "¿==Cuándo== vas a Ensenada?",
              "en": "When are you going to Ensenada?"
            },
            {
              "es": "¿==Cuándo== empiezan las clases?",
              "en": "When do classes start?"
            },
            {
              "es": "¿==Cuándo== llega tu hermano?",
              "en": "When is your brother arriving?"
            },
            {
              "es": "¿==Cuándo== entrenas jiu-jitsu? Los martes y los jueves.",
              "en": "When do you train jiu-jitsu? On Tuesdays and Thursdays."
            },
            {
              "es": "¿==Desde cuándo== vives en Tijuana?",
              "en": "How long have you lived in Tijuana?"
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Cuando es tu cumpleaños?"
                },
                {
                  "v": "bien",
                  "t": "¿Cuándo es tu cumpleaños?"
                }
              ],
              "nota": "Question: accent."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Cuándo tu hermano llega?"
                },
                {
                  "v": "bien",
                  "t": "¿Cuándo llega tu hermano?"
                }
              ],
              "nota": "Verb right after **cuándo**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Cuándo hora empieza la clase?"
                },
                {
                  "v": "bien",
                  "t": "¿A qué hora empieza la clase?"
                }
              ],
              "nota": "Exact time: **a qué hora**."
            }
          ]
        }
      ]
    },
