{
  "tema": 5484,
  "slug": "salgo-sales-presente-salir",
  "titulo": "Salir in the present",
  "subtitulo": "Salgo a las siete, ¿y tú?",
  "foto": "t04.jpg",
  "regla": "Salir (to leave, to go out) is regular in the present except yo: salgo. The rest: sales, sale, salimos, salen.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Salir** means _to leave_ or _to go out_. Only **yo** is irregular: **salgo**, with a **g**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "Present"
          ],
          "filas": [
            [
              "yo",
              "**salgo**"
            ],
            [
              "tú",
              "sales"
            ],
            [
              "él / ella / usted",
              "sale"
            ],
            [
              "nosotros / nosotras",
              "salimos"
            ],
            [
              "ellos / ellas / ustedes",
              "salen"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "The other forms follow the regular **-ir** pattern: **salimos**, never _salemos_."
        },
        {
          "tipo": "texto",
          "texto": "Leaving a place takes **de**: **salgo de** la casa. Going out with someone: **salir con**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Salgo== de la casa a las seis para surfear.",
              "en": "I leave the house at six to go surfing."
            },
            {
              "es": "¿A qué hora ==sales== del trabajo?",
              "en": "What time do you get off work?"
            },
            {
              "es": "El camión ==sale== de la central a las ocho.",
              "en": "The bus leaves the station at eight."
            },
            {
              "es": "Los viernes ==salimos== a cenar tacos.",
              "en": "On Fridays we go out for tacos."
            },
            {
              "es": "Mis amigos ==salen== mucho a los antros.",
              "en": "My friends go out to clubs a lot."
            },
            {
              "es": "¿==Sales== con alguien?",
              "en": "Are you seeing someone?"
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Yo salo temprano."
                },
                {
