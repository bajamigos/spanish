{
  "tema": 5485,
  "slug": "doy-das-presente-dar",
  "titulo": "Dar in the present",
  "subtitulo": "Te doy mi número.",
  "foto": "t04.jpg",
  "regla": "Dar (to give) is regular in the present except yo, which ends in -oy: doy, das, da, damos, dan. None of these forms has a written accent.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Dar** (_to give_) is irregular only in **yo**: **doy**."
        },
        {
          "tipo": "texto",
          "texto": "The rest follow the -ar pattern: **das, da, damos, dan**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "dar"
          ],
          "filas": [
            [
              "yo",
              "**doy**"
            ],
            [
              "tú",
              "das"
            ],
            [
              "él, ella, usted",
              "da"
            ],
            [
              "nosotros",
              "damos"
            ],
            [
              "ellos, ustedes",
              "dan"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **doy** rhymes with **voy, soy, estoy**. And no accents: **da** and **das** are one syllable."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Te ==doy== mi número.",
              "en": "I'll give you my number."
            },
            {
              "es": "¿Me ==das== un aventón al centro?",
              "en": "Will you give me a ride downtown?"
            },
            {
              "es": "La maestra nos ==da== mucha tarea.",
              "en": "The teacher gives us a lot of homework."
            },
            {
              "es": "Los sábados ==damos== clases de surf.",
              "en": "On Saturdays we give surf lessons."
            },
            {
              "es": "Mis papás me ==dan== dinero para el camión.",
              "en": "My parents give me money for the bus."
            },
            {
              "es": "Siempre les ==doy== agua a mis plantas en la mañana.",
              "en": "I always water my plants in the morning."
            }
          ]
        }
      ]
    },
