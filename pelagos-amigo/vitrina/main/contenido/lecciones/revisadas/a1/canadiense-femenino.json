{
  "tema": 6802,
  "slug": "canadiense-femenino",
  "titulo": "Nationalities in -e: same form for women",
  "subtitulo": "«Mi novia es canadiense.»",
  "foto": "t08.jpg",
  "regla": "Nationality and origin adjectives ending in -e (canadiense, estadounidense, nicaragüense) have one form for masculine and feminine: they don't change.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Most nationalities end in **-o** and change: **mexicano → mexicana**."
        },
        {
          "tipo": "texto",
          "texto": "But adjectives of origin ending in **-e** stay the same: **un chavo canadiense**, **una chava canadiense**."
        },
        {
          "tipo": "texto",
          "texto": "Common ones: **canadiense, estadounidense, nicaragüense, costarricense**, and many Mexican states: **sonorense, sinaloense, chihuahuense**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **-ense** is like a team jersey: men and women wear the same one."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Mi novia es ==canadiense==.",
              "en": "My girlfriend is Canadian."
            },
            {
              "es": "Mi vecina es ==estadounidense==.",
              "en": "My neighbor is American."
            },
            {
              "es": "La maestra es ==nicaragüense==.",
              "en": "The teacher is Nicaraguan."
            },
            {
              "es": "Tengo una amiga ==costarricense==.",
              "en": "I have a Costa Rican friend."
            },
            {
              "es": "Mi abuela es ==sonorense==.",
              "en": "My grandma is from Sonora."
            },
            {
              "es": "Me encanta la comida ==sinaloense==.",
              "en": "I love food from Sinaloa."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Ella es canadiensa."
                },
                {
                  "v": "bien",
                  "t": "Ella es canadiense."
                }
              ],
              "nota": "**-e** doesn't change to **-a**."
            },
            {
              "filas": [
                {
                  "v": "mal",
