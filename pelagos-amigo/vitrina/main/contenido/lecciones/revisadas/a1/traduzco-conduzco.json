  "titulo": "Traducir and conducir in the present",
  "subtitulo": "Traduzco del inglés al español.",
  "foto": "t01.jpg",
  "regla": "Verbs ending in -ducir (traducir, conducir, producir, reducir) add a z only in yo: traduzco, conduzco. The other persons are regular: traduces, traduce, traducimos, traducen.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Verbs ending in **-ducir**: **traducir** (_to translate_), **conducir** (_to drive_), **producir**, **reducir**, **introducir**."
        },
        {
          "tipo": "texto",
          "texto": "Only **yo** changes: **c → zc**: **traduzco**, **conduzco**."
        },
        {
          "tipo": "texto",
          "texto": "The other persons are regular -ir forms."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "traducir",
            "conducir"
          ],
          "filas": [
            [
              "yo",
              "traduzco",
              "conduzco"
            ],
            [
              "tú",
              "traduces",
              "conduces"
            ],
            [
              "él / ella / usted",
              "traduce",
              "conduce"
            ],
            [
              "nosotros",
              "traducimos",
              "conducimos"
            ],
            [
              "ellos / ellas / ustedes",
              "traducen",
              "conducen"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "In Mexico, **manejar** is the everyday verb for _to drive_; **conducir** sounds more formal."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Traduzco== documentos del inglés al español.",
              "en": "I translate documents from English to Spanish."
            },
            {
              "es": "==Conduzco== con cuidado cuando llueve.",
              "en": "I drive carefully when it rains."
            },
            {
              "es": "Mi papá ==conduce== un camión.",
              "en": "My dad drives a truck."
            },
            {
              "es": "¿Tú ==traduces== la canción?",
              "en": "Are you translating the song?"
            },
            {
              "es": "==Traducimos== los menús para los turistas.",
              "en": "We translate the menus for the tourists."
            },
            {
              "es": "Mis plantas ==producen== muchos jitomates.",
              "en": "My plants produce lots of tomatoes."
            }
          ]
        }
      ]
    },
