{
  "tema": 5094,
  "slug": "este-esta-estos-estas",
  "titulo": "Este, esta, estos, estas (this, these)",
  "subtitulo": "Este libro, esta casa, estos días, estas playas.",
  "foto": "t06.jpg",
  "regla": "This and these before a noun: este + masculine singular, esta + feminine singular, estos + masculine plural, estas + feminine plural. They agree with the noun.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**This / these** before a noun agrees with the noun in gender and number."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "",
            "Singular (this)",
            "Plural (these)"
          ],
          "filas": [
            [
              "Masculine",
              "**este** libro",
              "**estos** días"
            ],
            [
              "Feminine",
              "**esta** casa",
              "**estas** playas"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "The masculine singular is **este**, never **esto**. **Esto** never goes before a noun."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **est-** is _here, close to me_. Then match the noun's gender and number."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Este== libro es de mi hermano.",
              "en": "This book is my brother's."
            },
            {
              "es": "==Esta== tabla es nueva.",
              "en": "This board is new."
            },
            {
              "es": "==Estos== tacos están buenísimos.",
              "en": "These tacos are delicious."
            },
            {
              "es": "==Estas== playas son muy bonitas.",
              "en": "These beaches are very pretty."
            },
            {
              "es": "==Este== fin de semana voy a Ensenada.",
              "en": "This weekend I'm going to Ensenada."
            },
            {
              "es": "==Esta== mañana entrené jiu-jitsu.",
              "en": "This morning I trained jiu-jitsu."
            }
          ]
        }
      ]
    },
