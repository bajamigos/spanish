{
  "tema": 5106,
  "slug": "tener-que-infinitivo",
  "titulo": "Tener que: to have to",
  "subtitulo": "«Tengo que trabajar.»",
  "foto": "t09.jpg",
  "regla": "To say you have to do something, use tener que + infinitive: tengo que trabajar. Conjugate tener, keep the infinitive, and never drop que.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "tener (conjugated)",
            "+ que +",
            "infinitive"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "Tener que"
          ],
          "filas": [
            [
              "yo",
              "tengo que"
            ],
            [
              "tú",
              "tienes que"
            ],
            [
              "él / ella / usted",
              "tiene que"
            ],
            [
              "nosotros",
              "tenemos que"
            ],
            [
              "ellos / ellas / ustedes",
              "tienen que"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**No tengo que** = _I don't have to_."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **que** is the hinge. Without it, the door falls off."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Tengo que trabajar== mañana.",
              "en": "I have to work tomorrow."
            },
            {
              "es": "¿==Tienes que estudiar== hoy?",
              "en": "Do you have to study today?"
            },
            {
              "es": "Mi hermana ==tiene que ir== al doctor.",
              "en": "My sister has to go to the doctor."
            },
            {
              "es": "==Tenemos que regar== el jardín.",
              "en": "We have to water the garden."
            },
            {
              "es": "Ustedes no ==tienen que pagar== nada.",
              "en": "You don't have to pay anything."
            },
            {
              "es": "==Tengo que levantarme== temprano para surfear.",
              "en": "I have to get up early to surf."
            }
          ]
        }
      ]
    },
