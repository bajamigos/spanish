{
  "tema": 6052,
  "slug": "ingles-inglesa",
  "titulo": "Feminine of nationalities ending in -s",
  "subtitulo": "Él es inglés, ella es inglesa.",
  "foto": "t09.jpg",
  "regla": "Nationality and origin adjectives ending in -és add -a for the feminine and lose the written accent: inglés → inglesa, francés → francesa. They are written in lowercase.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Nationalities ending in **-és** add **-a** for the feminine."
        },
        {
          "tipo": "texto",
          "texto": "The written accent **disappears**: **inglés → inglesa**. The stress doesn't move; the word just doesn't need the accent anymore."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Masculine",
            "Feminine"
          ],
          "filas": [
            [
              "inglés",
              "**inglesa**"
            ],
            [
              "francés",
              "**francesa**"
            ],
            [
              "japonés",
              "**japonesa**"
            ],
            [
              "portugués",
              "**portuguesa**"
            ],
            [
              "irlandés",
              "**irlandesa**"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "In Spanish, nationalities are written in **lowercase**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Mi vecina es ==inglesa==.",
              "en": "My neighbor is English."
            },
            {
              "es": "La maestra de cocina es ==francesa==.",
              "en": "The cooking teacher is French."
            },
            {
              "es": "Me encanta la comida ==japonesa==.",
              "en": "I love Japanese food."
            },
            {
              "es": "Mi entrenadora es ==portuguesa==.",
              "en": "My coach is Portuguese."
            },
            {
              "es": "Ella es ==irlandesa==, de Dublín.",
              "en": "She's Irish, from Dublin."
            },
            {
              "es": "Tengo una guitarra ==holandesa==.",
              "en": "I have a Dutch guitar."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Ella es inglés."
                },
                {
                  "v": "bien",
                  "t": "Ella es inglesa."
                }
              ],
              "nota": "Feminine: add **-a**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "La comida francésa es rica."
                },
                {
