                }
              ],
              "nota": "Drop the accent."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Mi novia es Japonesa."
                },
                {
                  "v": "bien",
                  "t": "Mi novia es japonesa."
                }
              ],
              "nota": "Lowercase."
            }
          ]
        }
      ]
    },
