{
  "tema": 5773,
  "slug": "he-has-ha-haber-presente",
  "titulo": "Haber in the present",
  "subtitulo": "¿Has visto The Expanse?",
  "foto": "t02.jpg",
  "regla": "Haber is the helper verb of the present perfect: he, has, ha, hemos, han + past participle. For there is / there are it has one form only: hay.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Haber** is a **helper verb**: it goes with a past participle to make the present perfect (**he comido** _I have eaten_)."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "haber"
          ],
          "filas": [
            [
              "yo",
              "he"
            ],
            [
              "tú",
              "has"
            ],
            [
              "él / ella / usted",
              "ha"
            ],
            [
              "nosotros",
              "hemos"
            ],
            [
              "ellos / ellas / ustedes",
              "han"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "It is **not** _to have_ in the sense of owning: that's **tener**."
        },
        {
          "tipo": "texto",
          "texto": "For **there is / there are**, use the special form **hay**, for singular and plural."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==He== comido demasiado.",
              "en": "I've eaten too much."
            },
            {
              "es": "¿==Has== visto The Expanse?",
              "en": "Have you seen The Expanse?"
            },
            {
              "es": "Mi hermana ==ha== viajado a Oaxaca.",
              "en": "My sister has traveled to Oaxaca."
            },
            {
              "es": "==Hemos== plantado jitomates en el huerto.",
              "en": "We've planted tomatoes in the garden."
            },
            {
              "es": "¿Ustedes ==han== estado en Ensenada?",
              "en": "Have you all been to Ensenada?"
            },
            {
              "es": "==Hay== olas grandes hoy.",
              "en": "There are big waves today."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Yo ha comido."
                },
                {
                  "v": "bien",
                  "t": "Yo he comido."
                }
              ],
              "nota": "yo: **he**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Ella a llegado."
                },
                {
                  "v": "bien",
                  "t": "Ella ha llegado."
                }
              ],
              "nota": "**a** is a preposition; the verb is **ha**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Han muchos carros en la línea."
                },
                {
                  "v": "bien",
                  "t": "Hay muchos carros en la línea."
                }
              ],
              "nota": "There are: always **hay**."
            }
          ]
        }
      ]
    },
    {
