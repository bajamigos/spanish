{
  "tema": 5811,
  "slug": "cierro-cerramos-e-ie-ar",
  "titulo": "-ar verbs with e > ie in the present",
  "subtitulo": "Cierro la puerta, cerramos la tienda.",
  "foto": "t05.jpg",
  "regla": "Some -ar verbs change the stressed e of the stem to ie in the present: cierro, cierras, cierra, cierran. Nosotros keeps the e: cerramos.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "In some **-ar** verbs, the **e** of the stem becomes **ie** when it is stressed."
        },
        {
          "tipo": "texto",
          "texto": "It happens in **yo, tú, él** and **ellos**. **Nosotros** keeps the **e**, because the stress moves to the ending."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "cerrar",
            "empezar",
            "regar"
          ],
          "filas": [
            [
              "yo",
              "**cierro**",
              "**empiezo**",
              "**riego**"
            ],
            [
              "tú",
              "**cierras**",
              "**empiezas**",
              "**riegas**"
            ],
            [
              "él / ella / usted",
              "**cierra**",
              "**empieza**",
              "**riega**"
            ],
            [
              "nosotros / nosotras",
              "cerramos",
              "empezamos",
              "regamos"
            ],
            [
              "ellos / ellas / ustedes",
              "**cierran**",
              "**empiezan**",
              "**riegan**"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Others: **pensar** (pienso), **despertar** (despierto), **comenzar** (comienzo), **recomendar** (recomiendo), **calentar** (caliento)."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Cierro== la ventana porque hace frío.",
              "en": "I close the window because it's cold."
            },
            {
              "es": "¿A qué hora ==empieza== la clase?",
              "en": "What time does the class start?"
            },
            {
              "es": "==Riego== las plantas del jardín cada mañana.",
              "en": "I water the garden plants every morning."
            },
            {
              "es": "¿Qué restaurante nos ==recomiendas==?",
              "en": "Which restaurant do you recommend to us?"
            },
            {
              "es": "Nosotros ==cerramos== la tienda a las nueve.",
              "en": "We close the store at nine."
            },
            {
              "es": "Los bebés ==despiertan== a toda la familia.",
              "en": "The babies wake up the whole family."
            }
          ]
        }
      ]
