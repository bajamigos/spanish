{
  "tema": 6668,
  "slug": "cada-sustantivo",
  "titulo": "Cada + noun (each)",
  "subtitulo": "Cada ola es diferente.",
  "foto": "t01.jpg",
  "regla": "Cada + singular noun = each. Cada never changes for gender or number, takes no article, and the verb is singular: cada alumno tiene, cada casa tiene.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Cada** + **singular noun** = _each_."
        },
        {
          "tipo": "formula",
          "partes": [
            "cada",
            "+",
            "singular noun"
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Cada** never changes: **cada chavo**, **cada chava**. No article after it, and the verb is **singular**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Cada== ola es diferente.",
              "en": "Each wave is different."
            },
            {
              "es": "==Cada== alumno tiene un libro.",
              "en": "Each student has a book."
            },
            {
              "es": "Hay una tabla para ==cada== persona.",
              "en": "There's a board for each person."
            },
            {
              "es": "==Cada== casa de la calle tiene un jardín.",
              "en": "Each house on the street has a garden."
            },
            {
              "es": "Le doy un taco a ==cada== niño.",
              "en": "I give each kid a taco."
            },
            {
              "es": "==Cada== clase cuesta doscientos pesos.",
              "en": "Each class costs two hundred pesos."
            }
          ]
        }
      ]
    },
