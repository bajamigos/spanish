{
  "tema": 10481,
  "slug": "el-lunes-los-sabados",
  "titulo": "The article with days of the week",
  "subtitulo": "El sábado voy a surfear. Los martes entreno.",
  "foto": "t01.jpg",
  "regla": "To say on which day something happens, put el before the day for one occasion (el lunes = on Monday) and los for a habit (los lunes = on Mondays). Never use en.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**El + day** = one occasion: **el sábado** = _on Saturday_ (this coming one, or the last one)."
        },
        {
          "tipo": "texto",
          "texto": "**Los + day** = every week: **los sábados** = _on Saturdays_."
        },
        {
          "tipo": "texto",
          "texto": "No **en**: the article already means _on_."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Singular",
            "Plural"
          ],
          "filas": [
            [
              "el lunes … el viernes",
              "los lunes … los viernes"
            ],
            [
              "el sábado",
              "los sábados"
            ],
            [
              "el domingo",
              "los domingos"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Lunes** to **viernes** already end in **-s**, so they don't change in the plural."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==El sábado== voy a surfear.",
              "en": "On Saturday I'm going surfing."
            },
            {
              "es": "==Los martes== tengo jiu-jitsu.",
              "en": "On Tuesdays I have jiu-jitsu."
            },
            {
              "es": "La reunión es ==el jueves==.",
              "en": "The meeting is on Thursday."
            },
            {
              "es": "==Los domingos== comemos con mi familia.",
              "en": "On Sundays we eat with my family."
            },
            {
              "es": "Te veo ==el lunes== en la mañana.",
              "en": "See you Monday morning."
            },
            {
              "es": "==Los viernes== riego el huerto.",
              "en": "On Fridays I water the garden."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
