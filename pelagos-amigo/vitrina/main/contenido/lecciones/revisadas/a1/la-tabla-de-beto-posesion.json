{
  "tema": 7272,
  "slug": "la-tabla-de-beto-posesion",
  "titulo": "De for possession",
  "subtitulo": "la tabla de Beto",
  "foto": "t08.jpg",
  "regla": "Spanish has no 's. To say whose something is, use thing + de + owner: la tabla de Beto. De + el contracts to del.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "English _Beto's board_ becomes **la tabla de Beto**: the thing first, then **de**, then the owner."
        },
        {
          "tipo": "formula",
          "partes": [
            "el / la + thing",
            "+ de +",
            "owner"
          ]
        },
        {
          "tipo": "texto",
          "texto": "**De** + **el** = **del**: **el carro del maestro**. But **de él** (_his_) never contracts."
        },
        {
          "tipo": "texto",
          "texto": "To ask whose: **¿De quién es?** Answer: **Es de Ana.**"
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Es la tabla ==de Beto==.",
              "en": "It's Beto's board."
            },
            {
              "es": "La casa ==de mis papás== está en Playas.",
              "en": "My parents' house is in Playas."
            },
            {
              "es": "El perro ==del vecino== ladra mucho.",
              "en": "The neighbor's dog barks a lot."
            },
            {
              "es": "¿==De quién== es esta mochila?",
              "en": "Whose backpack is this?"
            },
            {
              "es": "Es ==de Ana==.",
              "en": "It's Ana's."
            },
            {
              "es": "Me gusta el jardín ==de la escuela==.",
              "en": "I like the school's garden."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Beto tabla / Beto's tabla"
                },
                {
                  "v": "bien",
                  "t": "la tabla de Beto"
                }
              ],
              "nota": "No 's in Spanish."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "el perro de el vecino"
                },
                {
                  "v": "bien",
                  "t": "el perro del vecino"
                }
              ],
              "nota": "**de + el = del**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Quién es esta mochila?"
                },
                {
                  "v": "bien",
                  "t": "¿De quién es esta mochila?"
                }
              ],
              "nota": "Whose = **de quién**."
            }
          ]
        }
      ]
    },
    {
