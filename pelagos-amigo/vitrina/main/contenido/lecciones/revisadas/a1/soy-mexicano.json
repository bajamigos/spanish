{
  "tema": 6806,
  "slug": "soy-mexicano",
  "titulo": "Ser for origin and nationality",
  "subtitulo": "Soy mexicano, soy de Tijuana.",
  "foto": "t10.jpg",
  "regla": "For nationality and origin, use ser: ser + nationality (soy mexicano) or ser de + place (soy de Tijuana). Nationalities are lowercase and agree with the person.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "For **nationality** and **origin**, use **ser**. Where you're from doesn't change."
        },
        {
          "tipo": "formula",
          "partes": [
            "ser",
            "+",
            "nationality / de + place"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Nationalities are **lowercase** and **agree**: mexican**o**, mexican**a**, mexican**os**."
        },
        {
          "tipo": "texto",
          "texto": "**Estar en** + place is where someone is right now: **soy de** Tijuana, but **estoy en** Ensenada."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Soy== mexicano.",
              "en": "I'm Mexican."
            },
            {
              "es": "==Soy de== Tijuana.",
              "en": "I'm from Tijuana."
            },
            {
              "es": "¿De dónde ==eres==?",
              "en": "Where are you from?"
            },
            {
              "es": "Mi entrenador ==es== brasileño.",
              "en": "My coach is Brazilian."
            },
            {
              "es": "Mis vecinas ==son== colombianas.",
              "en": "My neighbors are Colombian."
            },
            {
              "es": "Ella ==es de== San Diego, pero vive aquí.",
              "en": "She's from San Diego, but she lives here."
            }
          ]
        }
      ]
    },
    {
