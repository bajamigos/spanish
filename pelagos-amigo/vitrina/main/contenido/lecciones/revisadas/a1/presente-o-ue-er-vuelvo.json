  "titulo": "-er verbs with o > ue in the present",
  "subtitulo": "Vuelvo a las seis.",
  "foto": "t09.jpg",
  "regla": "Some -er verbs change the stressed o of the stem to ue in the present, in every person except nosotros: vuelvo, vuelves, vuelve, volvemos, vuelven.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Some -er verbs change **o → ue** in the stem: **volver**, **poder**, **mover**, **llover**, **devolver**, **resolver**, **morder**."
        },
        {
          "tipo": "texto",
          "texto": "The change happens in **every person except nosotros**: **puedo**, but **podemos**."
        },
        {
          "tipo": "texto",
          "texto": "The endings are the regular -er ones: **-o, -es, -e, -emos, -en**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "volver",
            "poder"
          ],
          "filas": [
            [
              "yo",
              "vuelvo",
              "puedo"
            ],
            [
              "tú",
              "vuelves",
              "puedes"
            ],
            [
              "él / ella / usted",
              "vuelve",
              "puede"
            ],
            [
              "nosotros",
              "volvemos",
              "podemos"
            ],
            [
              "ellos / ellas / ustedes",
              "vuelven",
              "pueden"
            ]
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Vuelvo== a casa a las seis.",
              "en": "I come back home at six."
            },
            {
              "es": "¿==Puedes== venir mañana?",
              "en": "Can you come tomorrow?"
            },
            {
              "es": "Aquí casi nunca ==llueve==.",
              "en": "It almost never rains here."
            },
            {
              "es": "==Podemos== surfear en la mañana.",
              "en": "We can surf in the morning."
            },
            {
              "es": "Mis amigos ==vuelven== del gimnasio.",
              "en": "My friends come back from the gym."
            },
            {
              "es": "¿Me ==devuelves== mi libro?",
              "en": "Will you give me back my book?"
            }
          ]
        }
      ]
    },
    {
