{
  "tema": 5873,
  "slug": "presente-o-ue-ir-duermo",
  "titulo": "-ir verbs with o > ue in the present",
  "subtitulo": "Duermo como bebé.",
  "foto": "t10.jpg",
  "regla": "Dormir and morir change the stressed o of the stem to ue in the present, in every person except nosotros: duermo, duermes, duerme, dormimos, duermen.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Two -ir verbs change **o → ue** in the stem: **dormir** (_to sleep_) and **morir** (_to die_)."
        },
        {
          "tipo": "texto",
          "texto": "The change happens in **every person except nosotros**: **duermo**, but **dormimos**."
        },
        {
          "tipo": "texto",
          "texto": "The endings are the regular -ir ones: **-o, -es, -e, -imos, -en**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "dormir",
            "morir"
          ],
          "filas": [
            [
              "yo",
              "duermo",
              "muero"
            ],
            [
              "tú",
              "duermes",
              "mueres"
            ],
            [
              "él / ella / usted",
              "duerme",
              "muere"
            ],
            [
              "nosotros",
              "dormimos",
              "morimos"
            ],
            [
              "ellos / ellas / ustedes",
              "duermen",
              "mueren"
            ]
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Duermo== ocho horas.",
              "en": "I sleep eight hours."
            },
            {
              "es": "¿Cuántas horas ==duermes==?",
              "en": "How many hours do you sleep?"
            },
            {
              "es": "El bebé ==duerme== en la tarde.",
              "en": "The baby sleeps in the afternoon."
            },
            {
              "es": "==Dormimos== en una casa de campaña en la playa.",
              "en": "We sleep in a tent on the beach."
            },
            {
              "es": "Las plantas ==mueren== sin agua.",
              "en": "Plants die without water."
            },
            {
              "es": "¡Me ==muero== de hambre!",
              "en": "I'm starving!"
            }
          ]
        }
      ]
    },
    {
