      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Days are **masculine**: **el lunes**, **un viernes**, **este domingo**, **todos los martes**."
        },
        {
          "tipo": "texto",
          "texto": "They're written in **lowercase**."
        },
        {
          "tipo": "texto",
          "texto": "Plural: **lunes** to **viernes** don't change (**los lunes**); **sábado** and **domingo** add **-s**."
