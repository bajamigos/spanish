{
  "tema": 6014,
  "slug": "adjetivos-os-as-plural",
  "titulo": "Plural of regular adjectives: -os / -as",
  "subtitulo": "«Los carros rojos, las casas rojas.»",
  "foto": "t03.jpg",
  "regla": "Regular adjectives add -s for the plural: -os for masculine, -as for feminine (perros negros, olas altas). For a mixed group of masculine and feminine, use the masculine plural: Juan y María son altos.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To make an adjective plural, add **-s**: **-o → -os**, **-a → -as**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "",
            "Masculine",
            "Feminine"
          ],
          "filas": [
            [
              "Singular",
              "un carro roj**o**",
              "una casa roj**a**"
            ],
            [
              "Plural",
              "dos carros roj**os**",
              "dos casas roj**as**"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "It agrees with the noun in **gender and number**: **las olas altas**."
        },
        {
          "tipo": "texto",
          "texto": "A **mixed group** (male + female) takes the **masculine plural**: **mi papá y mi mamá son altos**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Tengo dos perros ==negros==.",
              "en": "I have two black dogs."
            },
            {
              "es": "Las olas están ==altas== hoy.",
              "en": "The waves are high today."
            },
            {
              "es": "Mis amigos son muy ==simpáticos==.",
              "en": "My friends are really nice."
            },
            {
              "es": "Las playas de Baja son ==bonitas==.",
              "en": "The beaches in Baja are beautiful."
            },
            {
              "es": "Mi papá y mi mamá son ==altos==.",
              "en": "My dad and my mom are tall."
            },
            {
              "es": "Compro jitomates ==rojos== y lechugas ==frescas==.",
              "en": "I buy red tomatoes and fresh lettuce."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Las casas rojo."
                },
                {
                  "v": "bien",
                  "t": "Las casas rojas."
                }
              ],
              "nota": "Feminine plural: -as."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Los niños son simpático."
                },
                {
                  "v": "bien",
                  "t": "Los niños son simpáticos."
                }
              ],
              "nota": "Plural noun, plural adjective."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Mi hermano y mi hermana son altas."
                },
                {
                  "v": "bien",
                  "t": "Mi hermano y mi hermana son altos."
                }
              ],
              "nota": "Mixed group: -os."
            }
          ]
        }
      ]
    },
