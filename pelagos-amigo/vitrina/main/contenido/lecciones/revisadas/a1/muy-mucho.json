              "nota": "**Hambre** is a noun (feminine): **mucha**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Es mucho bonito."
                },
                {
                  "v": "bien",
                  "t": "Es muy bonito."
                }
              ],
              "nota": "Before an adjective: **muy**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Me gusta muy."
                },
                {
                  "v": "bien",
                  "t": "Me gusta mucho."
                }
              ],
              "nota": "**Muy** never stands alone."
            }
          ]
        }
      ]
