{
  "tema": 5166,
  "slug": "estoy-estas-esta-estar-presente",
  "titulo": "Estar in the present",
  "subtitulo": "Estoy en la playa. ¿Dónde estás?",
  "foto": "t05.jpg",
  "regla": "Estar (to be) goes estoy, estás, está, estamos, están. Yo ends in -oy, and estás, está and están carry a written accent.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Estar** (_to be_) is irregular in **yo** (**estoy**) and stresses the ending, so **estás**, **está** and **están** carry a written accent."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "estar"
          ],
          "filas": [
            [
              "yo",
              "**estoy**"
            ],
            [
              "tú",
              "**estás**"
            ],
            [
              "él, ella, usted",
              "**está**"
            ],
            [
              "nosotros",
              "**estamos**"
            ],
            [
              "ellos, ustedes",
              "**están**"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Use it for **where** someone or something is and **how** they are right now."
        },
        {
          "tipo": "texto",
          "texto": "Watch the accent: **está** = _is_, **esta** = _this_ (esta casa)."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Estoy== en la playa.",
              "en": "I'm at the beach."
            },
            {
              "es": "¿Cómo ==estás==?",
              "en": "How are you?"
            },
            {
              "es": "Mi mamá ==está== en Ensenada.",
              "en": "My mom is in Ensenada."
            },
            {
              "es": "==Estamos== muy cansados después del entrenamiento.",
              "en": "We're very tired after training."
            },
            {
              "es": "¿Dónde ==están== las llaves?",
              "en": "Where are the keys?"
            },
            {
              "es": "El agua ==está== fría hoy.",
              "en": "The water is cold today."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Mi papá esta en la casa."
                },
                {
                  "v": "bien",
                  "t": "Mi papá está en la casa."
                }
              ],
              "nota": "Without the accent, **esta** means _this_."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Yo esto cansado."
                },
                {
                  "v": "bien",
                  "t": "Yo estoy cansado."
                }
              ],
              "nota": "yo is **estoy**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Nosotros están listos."
                },
                {
                  "v": "bien",
                  "t": "Nosotros estamos listos."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "parientes",
