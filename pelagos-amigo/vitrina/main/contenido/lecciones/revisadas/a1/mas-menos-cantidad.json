  "slug": "mas-menos-cantidad",
  "titulo": "Más / menos: more, less, fewer",
  "subtitulo": "«Necesito más tiempo y menos tráfico.»",
  "foto": "t07.jpg",
  "regla": "Más (more) and menos (less, fewer) never change. Before a noun they are adjectives (más tortillas), alone they are pronouns (quiero más), and after a verb they are adverbs (corre más).",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Más** = _more_. **Menos** = _less_ or _fewer_. They **never change** for gender or number: no **menas**, no **mases**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Use",
            "Pattern",
            "Example"
          ],
          "filas": [
            [
              "adjective",
              "más / menos + noun",
              "más tortillas, menos tiempo"
            ],
            [
              "pronoun",
              "más / menos alone",
              "Quiero más."
            ],
            [
              "adverb",
              "verb + más / menos",
              "Corre más."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Más** has an accent. Without it, **mas** is an old word for _but_."
        },
        {
          "tipo": "texto",
          "texto": "Tip: Spanish uses **menos** for both _less_ and _fewer_."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Quiero ==más== tortillas, por favor.",
              "en": "I want more tortillas, please."
            },
            {
              "es": "Hoy hay ==menos== olas que ayer.",
              "en": "There are fewer waves today than yesterday."
            },
            {
              "es": "Necesito ==más== tiempo.",
              "en": "I need more time."
            },
            {
              "es": "¿Quieres ==más==?",
              "en": "Do you want more?"
            },
            {
              "es": "Mi hermano come ==menos== que yo.",
              "en": "My brother eats less than me."
            },
            {
              "es": "Tienes que entrenar ==más==.",
              "en": "You have to train more."
            }
          ]
        }
      ]
    },
