  "slug": "el-hijo-la-hija-plural",
  "titulo": "Masculine and feminine nouns: -o and -a",
  "subtitulo": "El hijo, la hija, los hijos, las hijas.",
  "foto": "t06.jpg",
  "regla": "Many nouns for people and animals end in -o for males and -a for females (el hijo, la hija); nouns ending in a consonant add -a (el doctor, la doctora). Plural: add -s after a vowel, -es after a consonant. A mixed group uses the masculine plural.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Many nouns for people and animals: **-o** for males, **-a** for females: **el hijo** → **la hija**."
        },
        {
          "tipo": "texto",
          "texto": "If the masculine ends in a **consonant**, add **-a**: **el doctor** → **la doctora**."
        },
        {
          "tipo": "texto",
          "texto": "Plural: add **-s** after a vowel, **-es** after a consonant. A **mixed** group uses the masculine: **mis hijos** = _my sons and daughters_."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Masc. singular",
            "Fem. singular",
            "Masc. plural",
            "Fem. plural"
          ],
          "filas": [
            [
              "el hijo",
              "la hija",
              "los hijos",
              "las hijas"
            ],
            [
              "el amigo",
              "la amiga",
              "los amigos",
              "las amigas"
            ],
            [
              "el perro",
              "la perra",
              "los perros",
              "las perras"
            ],
            [
              "el doctor",
              "la doctora",
              "los doctores",
              "las doctoras"
            ]
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
