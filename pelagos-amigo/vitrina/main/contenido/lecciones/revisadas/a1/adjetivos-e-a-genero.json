{
  "tema": 6015,
  "slug": "adjetivos-e-a-genero",
  "titulo": "Adjectives ending in -e and -a",
  "subtitulo": "Un chavo inteligente, una chava inteligente.",
  "foto": "t03.jpg",
  "regla": "Most adjectives ending in -e, and those ending in -a (like optimista), have one form for masculine and feminine singular: un chavo inteligente, una chava inteligente; un hombre optimista, una mujer optimista.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Most adjectives ending in **-e** don't change for gender: **grande**, **inteligente**, **verde**, **interesante**, **triste**."
        },
        {
          "tipo": "texto",
          "texto": "Adjectives ending in **-a** don't change either: **optimista**, **pesimista**, **realista**, **egoísta**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Masculine",
            "Feminine"
          ],
          "filas": [
            [
              "un chavo **inteligente**",
              "una chava **inteligente**"
            ],
            [
              "un hombre **optimista**",
              "una mujer **optimista**"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **-o** adjectives switch to **-a** (**alto → alta**), but if it ends in **-e** or **-a**, leave it alone."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Mi hermano es muy ==inteligente==.",
              "en": "My brother is very smart."
            },
            {
              "es": "Mi hermana también es ==inteligente==.",
              "en": "My sister is smart too."
            },
            {
              "es": "Hoy hay una ola ==enorme==.",
              "en": "There's a huge wave today."
            },
            {
              "es": "Tengo un jardín ==grande==.",
              "en": "I have a big garden."
            },
            {
              "es": "Mi entrenador es muy ==optimista==.",
              "en": "My coach is very optimistic."
            },
            {
              "es": "La maestra es ==optimista== también.",
              "en": "The teacher is optimistic too."
            }
          ]
        }
      ]
    },
    {
