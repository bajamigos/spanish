{
  "tema": 5083,
  "slug": "me-gusta-infinitivo",
  "titulo": "Gustar + infinitive: to like doing",
  "subtitulo": "«Me gusta surfear.»",
  "foto": "t06.jpg",
  "regla": "To say you like doing something, use me gusta + infinitive: me gusta surfear. It's always gusta (singular), even with two or more activities: me gusta leer y cocinar.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "me / te gusta",
            "+",
            "infinitive"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Use the **infinitive** (-ar, -er, -ir), never the -ing form: **me gusta surfear** = _I like surfing_."
        },
        {
          "tipo": "texto",
          "texto": "Always **gusta**, even with several activities: **me gusta leer y cocinar**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: English says _surfing_; Spanish says _to surf_."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Me gusta surfear== en la mañana.",
              "en": "I like surfing in the morning."
            },
            {
              "es": "¿==Te gusta cocinar==?",
              "en": "Do you like to cook?"
            },
            {
              "es": "No ==me gusta correr==.",
              "en": "I don't like running."
            },
            {
              "es": "==Me gusta leer== novelas de ciencia ficción.",
              "en": "I like reading sci-fi novels."
            },
            {
              "es": "==Me gusta== entrenar jiu-jitsu y nadar.",
              "en": "I like training jiu-jitsu and swimming."
            },
            {
              "es": "¿==Te gusta trabajar== en el jardín?",
              "en": "Do you like working in the garden?"
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Me gusta surfeando."
                },
                {
                  "v": "bien",
