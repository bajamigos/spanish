              "r**í**es"
            ],
            [
              "él / ella / usted",
              "comp**i**te",
              "s**i**rve",
              "r**í**e"
            ],
            [
              "nosotros",
              "competimos",
              "servimos",
              "reímos"
            ],
            [
              "ustedes / ellos / ellas",
              "comp**i**ten",
              "s**i**rven",
              "r**í**en"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Reír** (and **sonreír**) always writes the accent: **río, ríes, ríe, reímos, ríen**. Same pattern: **repetir, vestir, medir**."
        }
