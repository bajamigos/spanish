      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "In some **-ir** verbs, the last **e** of the stem becomes **i** in the present."
        },
        {
          "tipo": "texto",
          "texto": "It happens in every person **except nosotros**, which keeps the **e**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "",
            "competir",
            "servir",
            "reír"
