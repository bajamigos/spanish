        {
          "tipo": "mini_kwiz",
          "lista": [
            {
              "p": "In Spanish: _those boards_ (tablas)",
              "r": "esas tablas",
              "nota": "Feminine plural."
            },
            {
              "p": "Fix it: _Eso libro es mío._",
