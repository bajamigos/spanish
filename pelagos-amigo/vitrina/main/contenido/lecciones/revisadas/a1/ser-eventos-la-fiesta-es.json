  "titulo": "Ser for where and when events take place",
  "subtitulo": "«La fiesta es en mi casa.»",
  "foto": "t03.jpg",
  "regla": "To say where or when an event takes place (a party, a concert, a class), use ser, not estar: la fiesta es en mi casa, el concierto es el sábado. People and things still take estar for location.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Events** (party, wedding, concert, class, game, meeting) use **ser** to say where and when they **take place**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "",
            "Event: ser",
            "Person or thing: estar"
          ],
          "filas": [
            [
              "where",
              "La fiesta es en mi casa.",
              "Mi casa está en Playas."
            ],
            [
              "when",
              "La boda es el sábado.",
              "—"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: if you can say _takes place_, use **ser**."
        }
      ]
    },
    {
