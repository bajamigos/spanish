{
  "tema": 5991,
  "slug": "presente-hechos-generales",
  "titulo": "The present for general facts",
  "subtitulo": "«El agua hierve a cien grados.»",
  "foto": "t05.jpg",
  "regla": "Use the simple present (el presente) for general facts and things that are always true, just like in English. When the subject is a general noun, it takes the article: el agua, los gatos.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "For **general facts** and truths that don't change, Spanish uses the **simple present**, like English."
        },
        {
          "tipo": "texto",
          "texto": "General nouns keep the **article**: **Los gatos** duermen mucho, not _Gatos duermen mucho_."
        },
        {
          "tipo": "texto",
          "texto": "No **estar + gerund** here: that is for what's happening right now."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "El agua ==hierve== a cien grados.",
              "en": "Water boils at one hundred degrees."
            },
            {
              "es": "La Tierra ==gira== alrededor del Sol.",
              "en": "The Earth goes around the Sun."
            },
            {
              "es": "En México ==se habla== español.",
              "en": "Spanish is spoken in Mexico."
            },
            {
              "es": "Tijuana ==está== en la frontera con Estados Unidos.",
              "en": "Tijuana is on the border with the United States."
            },
            {
              "es": "Los jitomates ==necesitan== mucho sol.",
              "en": "Tomatoes need a lot of sun."
            },
            {
              "es": "Los gatos ==duermen== mucho.",
              "en": "Cats sleep a lot."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
