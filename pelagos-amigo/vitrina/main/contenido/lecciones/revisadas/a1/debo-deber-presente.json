      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Deber** is a **regular -er** verb."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "",
            "deber"
          ],
          "filas": [
            [
              "yo",
