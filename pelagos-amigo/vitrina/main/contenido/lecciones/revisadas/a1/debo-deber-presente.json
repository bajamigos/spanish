              "tú",
              "deb**es**"
            ],
            [
              "él / ella / usted",
              "deb**e**"
            ],
            [
              "nosotros",
              "deb**emos**"
            ],
            [
              "ustedes / ellos / ellas",
              "deb**en**"
            ]
          ]
        },
        {
          "tipo": "formula",
          "partes": [
            "deber",
            "+",
            "infinitive"
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Deber + infinitive** = _should, must_: **Debes descansar.** **Deber + noun** = _to owe_: **Te debo cien pesos.**"
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Debo== estudiar para el examen.",
              "en": "I must study for the exam."
            },
            {
              "es": "No ==debes== manejar tan rápido.",
              "en": "You shouldn't drive so fast."
            },
            {
              "es": "Mi hermano ==debe== descansar más.",
              "en": "My brother should rest more."
            },
            {
              "es": "==Debemos== regar las plantas todos los días.",
              "en": "We should water the plants every day."
            },
            {
              "es": "Ustedes ==deben== llegar a las ocho.",
              "en": "You must arrive at eight."
            },
            {
              "es": "Te ==debo== doscientos pesos.",
              "en": "I owe you two hundred pesos."
            }
