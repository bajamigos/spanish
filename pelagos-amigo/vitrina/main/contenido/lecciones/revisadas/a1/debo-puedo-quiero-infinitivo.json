  "slug": "debo-puedo-quiero-infinitivo",
  "titulo": "Deber, poder, querer + infinitive",
  "subtitulo": "«Quiero comer, pero debo trabajar.»",
  "foto": "t10.jpg",
  "regla": "Deber (must, should), poder (can) and querer (to want) go straight into an infinitive, with nothing in between: debo trabajar, puedo nadar, quiero comer.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "deber / poder / querer (conjugated)",
            "+",
            "infinitive"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "deber",
            "poder",
            "querer"
          ],
          "filas": [
            [
              "yo",
              "debo",
              "puedo",
              "quiero"
            ],
            [
              "tú",
              "debes",
              "puedes",
              "quieres"
            ],
            [
              "él / ella / usted",
              "debe",
              "puede",
              "quiere"
            ],
            [
              "nosotros",
              "debemos",
              "podemos",
              "queremos"
            ],
            [
              "ellos / ellas / ustedes",
              "deben",
              "pueden",
              "quieren"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Conjugate the first verb only. The second stays in the **infinitive**, with no **que**, **a** or **de**."
        },
        {
          "tipo": "texto",
          "texto": "**Poder** (o → ue) and **querer** (e → ie) change their stem, except with **nosotros**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Debo trabajar== el sábado.",
              "en": "I must work on Saturday."
            },
            {
              "es": "==Puedo nadar== una hora sin parar.",
              "en": "I can swim for an hour without stopping."
            },
            {
              "es": "==Quiero comer== tacos de birria.",
              "en": "I want to eat birria tacos."
            },
            {
              "es": "¿==Puedes ayudarme==?",
              "en": "Can you help me?"
            },
            {
              "es": "No ==debes manejar== tan rápido.",
              "en": "You shouldn't drive so fast."
            },
            {
              "es": "==Queremos aprender== a surfear.",
              "en": "We want to learn to surf."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
