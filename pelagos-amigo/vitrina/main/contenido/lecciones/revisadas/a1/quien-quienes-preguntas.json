{
  "tema": 9922,
  "slug": "quien-quienes-preguntas",
  "titulo": "How to ask \"who\"",
  "subtitulo": "¿Quién es? ¿Con quién vas?",
  "foto": "t03.jpg",
  "regla": "Who is quién for one person and quiénes for more than one, always with an accent in questions. Any preposition goes in front: ¿con quién?, ¿para quién?, and ¿de quién? means whose.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**¿Quién?** for one person, **¿Quiénes?** for more than one. The verb agrees: **¿Quién es?** / **¿Quiénes son?**"
        },
        {
          "tipo": "texto",
          "texto": "Always with an **accent** in questions."
        },
        {
          "tipo": "texto",
          "texto": "A **preposition** goes **first**, never at the end: **¿Con quién?**, **¿Para quién?**, **¿A quién?**"
        },
        {
          "tipo": "texto",
          "texto": "**¿De quién es…?** = _Whose is…?_"
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "¿==Quién== es tu maestro?",
              "en": "Who's your teacher?"
            },
            {
              "es": "¿==Quiénes== son esos chavos?",
              "en": "Who are those guys?"
            },
            {
              "es": "¿==Con quién== vas a la playa?",
              "en": "Who are you going to the beach with?"
            },
            {
              "es": "¿==De quién== es esta tabla?",
              "en": "Whose board is this?"
            },
            {
              "es": "¿==Para quién== es el regalo?",
              "en": "Who's the present for?"
            },
            {
              "es": "¿==Quién== quiere café?",
              "en": "Who wants coffee?"
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Quien es?"
                },
                {
                  "v": "bien",
                  "t": "¿Quién es?"
                }
              ],
              "nota": "Accent in questions."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Quién son ellos?"
                },
                {
                  "v": "bien",
                  "t": "¿Quiénes son ellos?"
                }
              ],
              "nota": "Plural: **quiénes**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Quién vas con?"
                },
                {
                  "v": "bien",
                  "t": "¿Con quién vas?"
                }
              ],
              "nota": "The preposition goes first."
            }
          ]
        }
      ]
    },
    {
