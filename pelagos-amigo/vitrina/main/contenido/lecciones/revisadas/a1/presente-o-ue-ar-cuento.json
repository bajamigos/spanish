  "titulo": "-ar verbs with o > ue in the present",
  "subtitulo": "¿Cuánto cuesta?",
  "foto": "t08.jpg",
  "regla": "Some -ar verbs change the stressed o of the stem to ue in the present, in every person except nosotros: cuento, cuentas, cuenta, contamos, cuentan.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Some -ar verbs change **o → ue** in the stem: **contar**, **costar**, **encontrar**, **recordar**, **almorzar**, **mostrar**, **volar**, **probar**."
        },
        {
          "tipo": "texto",
          "texto": "The change happens in **every person except nosotros**: **cuento**, but **contamos**."
        },
        {
          "tipo": "texto",
          "texto": "The endings are the regular -ar ones: **-o, -as, -a, -amos, -an**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "contar",
            "encontrar"
          ],
          "filas": [
            [
              "yo",
              "cuento",
              "encuentro"
            ],
            [
              "tú",
              "cuentas",
              "encuentras"
            ],
            [
              "él / ella / usted",
              "cuenta",
              "encuentra"
            ],
            [
              "nosotros",
              "contamos",
              "encontramos"
            ],
            [
              "ellos / ellas / ustedes",
              "cuentan",
              "encuentran"
            ]
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Mi abuelo ==cuenta== historias de Tijuana.",
              "en": "My grandpa tells stories about Tijuana."
            },
            {
              "es": "¿Cuánto ==cuesta== la tabla?",
              "en": "How much does the board cost?"
            },
            {
              "es": "No ==encuentro== mis llaves.",
              "en": "I can't find my keys."
            },
            {
              "es": "==Almorzamos== en el mercado.",
              "en": "We have lunch at the market."
            },
            {
              "es": "¿==Recuerdas== su nombre?",
              "en": "Do you remember his name?"
            },
            {
              "es": "Los aviones ==vuelan== muy bajo aquí.",
              "en": "The planes fly very low here."
            }
          ]
        }
      ]
    },
    {
