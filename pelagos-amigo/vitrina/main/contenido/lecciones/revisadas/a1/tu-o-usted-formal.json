  "titulo": "Tú vs usted (informal vs formal)",
  "subtitulo": "¿Tú quieres un taco? ¿Usted quiere un café, señora?",
  "foto": "t10.jpg",
  "regla": "Use tú with friends, family, kids and people your age; usted with older people, strangers, bosses and customers. Usted takes the él/ella verb form, and your is su. For more than one person, use ustedes.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Tú** is informal: friends, family, kids, people your age. **Usted** is formal: older people, strangers, your boss, customers."
        },
        {
          "tipo": "texto",
          "texto": "**Usted** uses the **él / ella** verb form, and _your_ is **su**, not tu."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "",
            "tú",
            "usted"
          ],
          "filas": [
            [
              "ser",
              "tú eres",
              "usted es"
            ],
            [
              "tener",
              "tú tienes",
              "usted tiene"
            ],
            [
              "How are you?",
              "¿Cómo estás?",
              "¿Cómo está?"
            ],
            [
              "your house",
              "tu casa",
              "su casa"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Plural: **ustedes** for everyone, formal or not."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "¿==Tú== quieres un taco?",
