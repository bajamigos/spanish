{
  "tema": 8860,
  "slug": "pensar-infinitivo",
  "titulo": "Pensar + infinitive to express intention",
  "subtitulo": "No pienso ir. ¿Qué piensas hacer?",
  "foto": "t08.jpg",
  "regla": "Pensar + infinitive = to intend to, to plan to: ¿Qué piensas hacer? No pienso ir (I'm not going, I have no intention). Pensaba decírtelo = I was planning to tell you. For thinking about something, use pensar en or estar pensando.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "pensar (conjugated)",
            "+",
            "infinitive"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Expresses a **plan or intention**: _to intend to, to plan to, to be going to_."
        },
        {
          "tipo": "texto",
          "texto": "**No pienso** + infinitive is strong: _no way am I..._"
        },
        {
          "tipo": "texto",
          "texto": "**Pensaba** + infinitive = _I was planning to_ (and maybe didn't)."
        },
        {
          "tipo": "texto",
          "texto": "Don't confuse with **pensar en** (_to think about_) or **estar pensando que** (_to be thinking that_)."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **pienso ir** = it's already in my calendar."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Mi ex me invitó a su cumpleaños, pero yo ==no pienso ir==.",
              "en": "My ex invited me to his birthday, but I'm not going."
            },
            {
              "es": "Te pasaste. ==Pienso contarle== todo a tus papás.",
              "en": "You crossed the line. I'm going to tell your parents everything."
            },
            {
              "es": "¿Qué ==piensas hacer==?",
              "en": "What do you plan to do?"
            },
            {
              "es": "¿==No piensas saludarme==?",
              "en": "Aren't you going to say hi?"
            },
            {
              "es": "==Pensaba decírtelo==, pero me daba pena.",
              "en": "I was planning to tell you, but I was embarrassed."
            },
            {
              "es": "==Estoy pensando en== rentar un departamento.",
              "en": "I'm thinking about renting an apartment. (thinking, not plan)"
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
