{
  "tema": 7257,
  "slug": "que-subjuntivo-deseo",
  "titulo": "¡Que + subjunctive! = wishes and repeated orders",
  "subtitulo": "¡Que te vaya bien! ¡Que te comas la sopa!",
  "foto": "t07.jpg",
  "regla": "Que + present subjunctive, with no main verb, has three uses: a wish (¡Que te vaya bien! = I hope it goes well), an insistent repeated order (¡Que te comas la sopa! = I said eat your soup!), and an indirect order for someone else (Que lo haga Juan = let Juan do it).",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "¡Que",
            "+ present subjunctive!"
          ]
        },
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "wish",
              "texto": "The hidden verb is **espero / ojalá**: **¡Que te mejores!**, **¡Que disfruten la comida!**"
            },
            {
              "forma": "repeated order",
              "texto": "The hidden verb is **te dije**: **¡Que te metas a bañar!** Parents' favorite."
            },
            {
              "forma": "indirect order",
              "texto": "For a third person: **Que pase el siguiente.** **Que lo arregle él.**"
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "Always present subjunctive, any person: **que seas, que pase usted, que ganen**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: imagine **ojalá** or **te dije** in front."
        }
      ]
    },
    {
