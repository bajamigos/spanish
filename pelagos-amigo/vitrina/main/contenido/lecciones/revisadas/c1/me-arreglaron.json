{
  "tema": 8149,
  "slug": "me-arreglaron",
  "titulo": "Me arreglaron el carro: ellos form + indirect pronoun to have something done (to you)",
  "subtitulo": "Ayer me sacaron una muela. Me robaron la cartera.",
  "foto": "t06.jpg",
  "regla": "Indirect pronoun + verb in the ellos form (no subject) = something was done to you or for you: Me sacaron una muela (I had a tooth pulled). Me robaron el celular (I had my phone stolen). English often uses have something done or the passive.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "me / te / le / nos / les",
            "+ verb (ellos form)",
            "+ thing"
          ]
        },
        {
          "tipo": "texto",
          "texto": "**They** is impersonal: whoever did it doesn't matter. The pronoun shows **who it affected**."
        },
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "a service",
              "texto": "**Me arreglaron el carro.** (_I had my car fixed._)"
            },
            {
              "forma": "something bad",
              "texto": "**Me robaron la cartera.** (_I had my wallet stolen. / My wallet got stolen._)"
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **me** + **-aron** = it happened to me."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Le arreglaron== todas las imperfecciones de la cara.",
              "en": "She had all the blemishes on her face fixed."
            },
            {
              "es": "Ayer ==me sacaron== una muela.",
              "en": "Yesterday I had a tooth pulled."
            },
            {
              "es": "==Le diseñaron== el vestido a su gusto.",
              "en": "She had the dress designed to her taste."
            },
            {
