                }
              ]
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Tal que lo dijiste."
                },
                {
                  "v": "bien",
                  "t": "Tal como lo dijiste."
                }
              ]
            }
          ]
        }
      ]
    },
    {
