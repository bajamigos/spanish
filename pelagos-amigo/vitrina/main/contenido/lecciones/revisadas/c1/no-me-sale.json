{
  "tema": 7623,
  "slug": "no-me-sale",
  "titulo": "No salirle algo a alguien = can't get something right",
  "subtitulo": "No me sale este ejercicio.",
  "foto": "t02.jpg",
  "regla": "(No) salirle algo a alguien = (not) to manage to do something, after trying: No me sale este problema. No le sale pararse de manos. Works like gustar: salir agrees with the thing; the person is the indirect pronoun. Usually negative.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "(no) + me / te / le... + sale / salen",
            "+ thing / infinitive"
          ]
        },
        {
          "tipo": "texto",
          "texto": "_I can't get it, it won't come out right_, after some effort. Mostly **negative**."
        },
        {
          "tipo": "texto",
          "texto": "Like **gustar**: **salir** agrees with the thing: **no me sale el problema**, **no me salen las cuentas**."
        },
        {
          "tipo": "texto",
          "texto": "Positive use exists too: **¡Ya me salió!** (_I got it!_)"
        },
        {
          "tipo": "texto",
          "texto": "Tip: you try and try, and it just won't come out."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==No me sale== este problema de matemáticas.",
              "en": "I can't work out this math problem."
            },
            {
              "es": "Mi hija lleva todo el día tratando de pararse de manos, pero ==no le sale==.",
              "en": "My daughter's been trying to do a handstand all day, but she can't."
