      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "el porqué / los porqués",
              "texto": "A masculine noun = _reason, cause_. Takes an article or determiner: **el porqué, su porqué, los porqués**."
            },
            {
              "forma": "por que",
              "texto": "**por** (from a verb or noun) + **que**: **preocuparse por que, luchar por que, apostar por que**. Also **la razón por que** = _the reason why_ (= por la que)."
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: if you can put **el** in front, it's **porqué**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "No entiendo ==el porqué== de su actitud tan negativa.",
              "en": "I don't understand the reason for his negative attitude."
            },
            {
              "es": "No te voy a explicar ==los porqués== de mi decisión.",
