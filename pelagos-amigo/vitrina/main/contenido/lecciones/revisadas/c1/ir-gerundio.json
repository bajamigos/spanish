{
  "tema": 6769,
  "slug": "ir-gerundio",
  "titulo": "Ir + gerund to stress gradual progress",
  "subtitulo": "Poco a poco voy entendiendo.",
  "foto": "t04.jpg",
  "regla": "Ir + gerund stresses that an action progresses bit by bit: Voy entendiendo, fueron llegando los invitados, ve poniendo la mesa. Works in any tense.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "ir (any tense)",
            "+",
            "gerund"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Like **estar** + gerund, but it adds the idea of **gradual progress**: _little by little, one by one, getting on with_."
        },
        {
          "tipo": "texto",
          "texto": "Common with **poco a poco**, **cada vez más**, and for preparation: **ve calentando el agua** (_start heating the water_)."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **ir** + gerund = progress you can watch growing."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Ella ==va poniendo== la mesa mientras yo termino de cocinar.",
              "en": "She's setting the table while I finish cooking."
            },
            {
              "es": "Los alumnos ==fueron terminando== las últimas preguntas del examen.",
              "en": "The students finished the last exam questions one by one."
            },
            {
              "es": "Nosotros ==iremos pintando== los huevos para la fiesta.",
              "en": "We'll get on with painting the eggs for the party."
            },
            {
              "es": "Carmen ==ha ido llamando== a los clientes mientras yo hablaba con el jefe.",
              "en": "Carmen has been calling the clients one by one while I talked to the boss."
            },
            {
              "es": "Qué bueno que te ==hayas ido despidiendo== de todos antes del viaje.",
              "en": "Good thing you've been saying goodbye to everyone before the trip."
            },
            {
              "es": "Poco a poco ==voy entendiendo== el subjuntivo.",
              "en": "Little by little I'm getting the subjunctive."
            },
            {
              "es": "==Ve calentando== el comal, ya voy.",
              "en": "Start heating the griddle, I'm coming."
            }
          ]
        }
      ]
