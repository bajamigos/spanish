{
  "tema": 7934,
  "slug": "la-de",
  "titulo": "¡La de + noun + que...! = so much / so many",
  "subtitulo": "¡La de veces que te lo dije!",
  "foto": "t08.jpg",
  "regla": "La de + noun + que + verb stresses a large quantity with surprise: ¡La de veces que te lo dije! La de never changes, whatever the noun (it stands for la cantidad de). Mexico often says ¡La cantidad de...! or ¡Cuántas...!",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "¡la de",
            "+ noun + que +",
            "verb!"
          ]
        },
        {
          "tipo": "texto",
          "texto": "_So much, so many_, with surprise or exasperation."
        },
        {
          "tipo": "texto",
          "texto": "**La de** never changes: **la de vino**, **la de besos**, **la de problemas**. It's short for **la cantidad de**."
        },
        {
          "tipo": "texto",
          "texto": "Works as a statement too: **no te imaginas la de vueltas que di**."
        },
        {
          "tipo": "texto",
          "texto": "In Mexico you'll often hear the full **¡la cantidad de...!** or **¡cuántas veces...!**"
        },
        {
          "tipo": "texto",
          "texto": "Tip: **la de** = the amount of."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "¡==La de== vino ==que== se tomó Miguel hoy!",
              "en": "Miguel drank so much wine today!"
            },
            {
              "es": "¡==La de== besos ==que== me da mi abuela!",
              "en": "My grandma gives me so many kisses!"
            },
            {
