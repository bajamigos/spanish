      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "dicho / dicha / dichos / dichas",
            "+ noun just mentioned"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Means _this, said, the aforementioned_. Formal written style."
        },
        {
          "tipo": "texto",
          "texto": "Agrees with the noun; **no article** in front: **dicha empresa**, not ~~la dicha empresa~~."
        },
        {
          "tipo": "texto",
          "texto": "Also: **dicho esto** = _that said_; **dicho y hecho** = _no sooner said than done_."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **dicho** = _already said_, so it points back."
        }
