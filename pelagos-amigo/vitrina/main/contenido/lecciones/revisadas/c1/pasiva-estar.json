            "Example"
          ],
          "filas": [
            [
              "ser + participle",
              "the action (often with por)",
              "La casa fue construida en 1990."
            ],
            [
              "estar + participle",
              "the resulting state",
              "La casa está construida sobre una colina."
            ],
            [
              "se + verb",
              "the action, everyday",
              "Se construyó la casa."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "The participle agrees in both."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **ser** shows the hammer; **estar** shows the finished house."
        }
