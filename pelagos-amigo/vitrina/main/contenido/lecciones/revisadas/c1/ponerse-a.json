  "slug": "ponerse-a",
  "titulo": "Poner(se) a + infinitive = to start doing",
  "subtitulo": "Se puso a llorar. Pon la ropa a secar.",
  "foto": "t06.jpg",
  "regla": "Ponerse a + infinitive = to start doing something, often suddenly: se puso a llover, me pongo a estudiar. Poner algo / a alguien a + infinitive = to set something or someone to do: pon la ropa a secar, pon a los niños a ver la tele.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "ponerse a + infinitive",
              "texto": "_to start, set about, get down to_: **me pongo a estudiar**. Often sudden: **se puso a llover**."
            },
            {
              "forma": "poner algo / a alguien a + infinitive",
              "texto": "_to put something to..., to get someone doing_: **pon la ropa a secar**, **puso a los niños a limpiar**."
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "Very common in conversation, more natural than **comenzar a** or **empezar a** for a sudden start."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **ponerse a** = you hit the start button."
        }
      ]
    },
