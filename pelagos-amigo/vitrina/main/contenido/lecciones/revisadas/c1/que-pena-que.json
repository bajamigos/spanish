{
  "tema": 8215,
  "slug": "que-pena-que",
  "titulo": "¡Qué + noun / adjective + que + subjunctive! to express feelings",
  "subtitulo": "¡Qué pena que no vengas! ¡Qué bueno que llegaste!",
  "foto": "t07.jpg",
  "regla": "¡Qué pena / bien / raro / alegría + que + subjunctive! reacts with a feeling: ¡Qué pena que no puedas venir! Past: ¡Qué bien que te hayan elegido! The indicative also appears when you're stating a fact: ¡Qué bueno que llegaste! (very common in Mexico).",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "¡qué + noun / adjective / adverb",
            "+ que +",
            "subjunctive!"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Reacting with a **feeling**: _what a shame / how great / how strange that..._"
        },
        {
          "tipo": "texto",
          "texto": "Present or future: present subjunctive. Past: **haya** + participle or imperfect subjunctive."
        },
        {
          "tipo": "texto",
          "texto": "The **indicative** is possible when you're mainly stating what happened: **¡Qué bueno que llegaste!** is everyday Mexican Spanish."
        },
        {
          "tipo": "texto",
          "texto": "Tip: feeling first, then the subjunctive."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "¡==Qué pena que== no ==puedas== venir a mi boda!",
              "en": "What a shame you can't come to my wedding!"
            },
            {
              "es": "¡==Qué raro que== las luces ==estén== prendidas! ¿Habrá alguien?",
              "en": "How strange that the lights are on! Could someone be here?"
            },
            {
              "es": "¡==Qué bien que== te ==hayan elegido==!",
              "en": "How great that they picked you!"
            },
            {
              "es": "¡==Qué alegría que== te ==dijera== que sí!",
              "en": "I'm so glad she said yes!"
            },
            {
              "es": "¡==Qué bueno que== ==llegaste==!",
              "en": "So glad you made it! (indicative, common in Mexico)"
            }
          ]
        }
      ]
    },
