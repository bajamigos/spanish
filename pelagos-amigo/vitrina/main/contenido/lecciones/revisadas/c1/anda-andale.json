          "lista": [
            {
              "forma": "urging",
              "texto": "**¡Anda, levántate!** In Mexico: **¡Ándale, apúrate!**, **¡Ándale, ven!**"
            },
            {
              "forma": "surprise, admiration",
              "texto": "**¡Anda, qué bonito te quedó el pelo!**"
            },
            {
              "forma": "irony (anda que, anda que no)",
              "texto": "**—Yo no soy nada vanidoso. —¡Anda que no!** (_Yeah, right!_) Less common in Mexico."
            },
            {
              "forma": "Mexican extras",
              "texto": "**¡Ándale!** = _exactly, that's it_; **¡Órale!** = _wow / OK / come on_."
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "They never change: **anda, ándale, órale**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: in Mexico, if in doubt, **¡ándale!**"
        }
