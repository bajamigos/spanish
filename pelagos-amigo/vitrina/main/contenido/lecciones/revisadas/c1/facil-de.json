                {
                  "v": "mal",
                  "t": "El ropero es fácil armar."
                },
                {
                  "v": "bien",
                  "t": "El ropero es fácil de armar."
                }
              ],
              "nota": "Thing as subject: **de**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Es fácil de armarlo."
                },
                {
                  "v": "bien",
                  "t": "Es fácil de armar."
                }
              ],
              "nota": "No object after **de** + infinitive."
            }
          ]
        }
      ]
