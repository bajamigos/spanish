            {
              "es": "Ya he ==hecho== la tarea.",
              "en": "I've already done my homework."
            },
            {
              "es": "Esta mesa está ==hecha== a mano.",
              "en": "This table is handmade."
            },
            {
              "es": "==De hecho==, ya lo sabía.",
              "en": "In fact, I already knew."
            },
            {
