  "slug": "tengo-anos",
  "titulo": "Saying your age with tener … años",
  "subtitulo": "«Tengo treinta años.»",
  "foto": "t03.jpg",
  "regla": "In Spanish you have years: tener + number + años (Tengo 30 años). Never use ser or estar for age, and say años (un año, not uno año); ask with ¿Cuántos años tienes? / ¿Cuántos años tiene usted?",
  "comparada_kwiziq": "2026-10-17",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "formula",
          "partes": [
            "(yo) tengo",
            "+ number +",
            "años"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Literally _I have 30 years_. Age is **tener**, never **ser** or **estar**."
        },
        {
          "tipo": "texto",
          "texto": "Say **años** in a full sentence. **Yo** is optional, and the number can be in words or digits."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Who",
            "Say it",
            "Ask it"
          ],
          "filas": [
            [
              "I",
              "tengo … años",
              "—"
            ],
            [
              "you (tú)",
              "tienes … años",
              "¿Cuántos años tienes?"
            ],
            [
              "you (usted), he, she",
              "tiene … años",
              "¿Cuántos años tiene usted?"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "With one year: **un año** (not **uno año**)."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Tengo== treinta y dos ==años==.",
              "en": "I'm thirty-two."
            },
            {
              "es": "Yo ==tengo== 45 ==años==.",
              "en": "I'm 45."
            },
            {
              "es": "¿Cuántos ==años tienes==?",
