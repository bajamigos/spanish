{
  "tema": 5986,
  "slug": "ser-de-posesion",
  "titulo": "Ser de (not estar) to indicate ownership",
  "subtitulo": "Es de Beto: ownership always takes ser.",
  "foto": "t04.jpg",
  "regla": "To say who something belongs to: thing + ser + de + person. Never estar: la tabla es de Beto.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To say **who something belongs to**, use **ser** + **de** + the owner. Never **estar**."
        },
        {
          "tipo": "formula",
          "partes": [
            "thing",
            "**ser**",
            "**de**",
            "owner"
          ]
        },
        {
          "tipo": "texto",
          "texto": "It works in any tense: **era de mi abuelo**, **será de nuestros hijos**."
        },
        {
          "tipo": "texto",
          "texto": "To ask, flip it: **¿De quién es?** (_Whose is it?_)."
        },
        {
          "tipo": "texto",
          "texto": "Tip: belonging is a permanent label, so it goes with **ser**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Estas medallas ==eran de== mi abuelo.",
              "en": "These medals were my grandfather's."
            },
            {
              "es": "No es tu problema. ==Es problema de== Andrés.",
              "en": "It's not your problem. It's Andrés's problem."
            },
            {
              "es": "La casa ==será de== nuestros hijos.",
              "en": "The house will be our kids'."
            },
            {
              "es": "Esta tabla ==es de== Beto.",
              "en": "This board is Beto's."
            },
            {
              "es": "—¿==De quién es== la llave? —==Es del== cliente.",
              "en": "\"Whose key is it?\" \"It's the customer's.\""
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "La tabla está de Beto."
                },
                {
                  "v": "bien",
                  "t": "La tabla es de Beto."
                }
              ],
              "nota": "Ownership: **ser**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Quién es de la llave?"
                },
                {
                  "v": "bien",
                  "t": "¿De quién es la llave?"
                }
              ],
              "nota": "**De quién** at the start."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Es de el cliente."
                },
                {
                  "v": "bien",
                  "t": "Es del cliente."
                }
              ],
              "nota": "**de + el** = **del**."
            }
          ]
        }
      ]
    },
    {
      "id": "parientes",
      "titulo": "Related rules",
      "bloques": [
