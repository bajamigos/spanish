{
  "tema": 7071,
  "slug": "condicional-estar",
  "titulo": "Conjugate estar in the conditional",
  "subtitulo": "Estaría, estarías, estaríamos: completely regular.",
  "foto": "t04.jpg",
  "regla": "Estar is regular in the conditional: estaría, estarías, estaría, estaríamos, estarían.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Estar** (_to be_) is **regular** in the conditional: the regular endings go on the whole infinitive."
        },
        {
          "tipo": "formula",
          "partes": [
            "**estar**",
            "**-ía, -ías, -ía, -íamos, -ían**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "estar"
          ],
          "filas": [
            [
              "yo",
              "estaría"
            ],
            [
              "tú",
              "estarías"
            ],
            [
              "él, ella, usted",
              "estaría"
            ],
            [
              "nosotros",
              "estaríamos"
            ],
            [
              "ustedes, ellos",
              "estarían"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Use it as usual for **estar**: places, feelings, states, and progressive forms (**estaría surfeando**)."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **estar** keeps the infinitive whole and adds **-ía**, same as **ser**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Yo ==estaría== un mes de vacaciones.",
              "en": "I'd be on vacation for a month."
            },
            {
              "es": "Tú ==estarías== muy feliz en esa casa junto a la playa.",
              "en": "You'd be very happy in that house by the beach."
            },
            {
              "es": "Holden no ==estaría== con Naomi en Ceres.",
              "en": "Holden wouldn't be with Naomi on Ceres."
            },
            {
              "es": "Nosotros ==estaríamos== equivocados.",
              "en": "We'd be wrong."
            },
            {
              "es": "Ellos ==estarían== nerviosos antes del torneo.",
              "en": "They'd be nervous before the tournament."
            },
            {
              "es": "Ustedes ==estarían== muy cómodos en este depa.",
              "en": "You'd be very comfortable in this apartment."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Yo sería muy cansado después de rolar."
                },
                {
                  "v": "bien",
                  "t": "Yo estaría muy cansado después de rolar."
                }
              ],
              "nota": "To say _tired_, use **estar**."
            },
            {
              "filas": [
                {
                  "v": "mal",
