  "titulo": "The imperfect vs the preterite: time markers",
  "subtitulo": "Siempre iba (imperfect) vs ayer fui (preterite): the time words give it away.",
  "foto": "t05.jpg",
  "regla": "Time markers of frequency or ongoing time (siempre, todos los días, cada mes, de niño) → imperfect. Specific, closed times (ayer, el año pasado, una vez) → preterite.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Both the imperfect and the preterite talk about the past, and English often translates them the same way. The time words in the sentence are a big clue."
        },
        {
          "tipo": "texto",
          "texto": "The **imperfect** says in general when, or how often, something happened: an ongoing stretch or a habit, with no clear start or end. The **preterite** says specifically when: a finished event with a clear time."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Imperfect markers",
            "Preterite markers"
          ],
          "filas": [
            [
              "siempre",
              "ayer, anteayer, anoche"
            ],
            [
              "todos los días, todas las semanas",
              "el año pasado, la semana pasada"
            ],
            [
              "cada mes, cada verano",
              "una vez, dos veces"
            ],
            [
              "a menudo, muchas veces",
              "en 2019, el lunes"
            ],
            [
              "de niño, cuando era joven",
              "de repente, en ese momento"
            ],
            [
              "normalmente, generalmente",
              "desde el primer momento"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: if you could add _used to_ in English, it's probably the imperfect."
        }
      ]
    },
    {
      "id": "ejemplos",
