                  "t": "Debido a que la lluvia."
                },
                {
                  "v": "bien",
                  "t": "Debido a la lluvia."
                }
              ],
              "nota": "Noun: no **que**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Debido a llovía mucho."
                },
                {
                  "v": "bien",
                  "t": "Debido a que llovía mucho."
                }
              ],
              "nota": "Verb: **que**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Debido a el viento."
                },
                {
                  "v": "bien",
                  "t": "Debido al viento."
                }
              ],
              "nota": "**a + el = al**."
            }
          ]
        }
      ]
    },
