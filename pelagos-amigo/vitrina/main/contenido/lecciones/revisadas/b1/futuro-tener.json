{
  "tema": 5050,
  "slug": "futuro-tener",
  "titulo": "Conjugate tener in the simple future",
  "subtitulo": "Tendré, tendrás, tendremos: the stem changes, the endings don't.",
  "foto": "t06.jpg",
  "regla": "Tener has the irregular future stem tendr- with the regular endings: tendré, tendrás, tendrá, tendremos, tendrán.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Tener** is irregular in the future: its stem is **tendr-** instead of **tener-**. The endings are the regular future ones."
        },
        {
          "tipo": "formula",
          "partes": [
            "**tendr-**",
            "**-é, -ás, -á, -emos, -án**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "tener"
          ],
          "filas": [
            [
              "yo",
              "tendré"
            ],
            [
              "tú",
              "tendrás"
            ],
            [
              "él, ella, usted",
              "tendrá"
            ],
            [
              "nosotros",
              "tendremos"
            ],
            [
              "ustedes, ellos",
              "tendrán"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Every verb built on **tener** has the same stem: **obtener** → **obtendré**, **detener** → **detendré**, **retener** → **retendré**, **mantener** → **mantendré**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: the **e** of **tener** falls out and a **d** jumps in to hold the door: **ten-d-ré**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Cuando sea mayor, ==tendré== un huerto enorme.",
              "en": "When I'm older, I'll have a huge garden."
            },
            {
              "es": "==Tendrás== más dinero el sábado, después de trabajar.",
              "en": "You'll have more money on Saturday, after work."
            },
            {
              "es": "El cliente ==tendrá== un carro rentado.",
              "en": "The customer will have a rental car."
            },
            {
              "es": "==Tendremos== un verano muy caluroso.",
              "en": "We'll have a very hot summer."
            },
            {
              "es": "Ellos ==tendrán== las tablas en el carro.",
              "en": "They'll have the boards in the car."
            },
            {
              "es": "Ustedes ==tendrán== media hora de descanso.",
              "en": "You'll have a half-hour break."
            },
            {
              "es": "Holden ==mantendrá== el rumbo.",
              "en": "Holden will keep the course."
            }
          ]
        }
      ]
    },
