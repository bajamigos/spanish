{
  "tema": 5232,
  "slug": "subjuntivo-presente-saber",
  "titulo": "Conjugate saber in the present subjunctive",
  "subtitulo": "Sepa, sepas, sepamos: an irregular stem nothing like saber.",
  "foto": "t04.jpg",
  "regla": "Saber has the irregular stem sep- with regular endings: sepa, sepas, sepa, sepamos, sepan.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Saber** (_to know_) is irregular in the present subjunctive because its stem is **sep-**. The endings are the regular **-er** ones."
        },
        {
          "tipo": "formula",
          "partes": [
            "**sep-**",
            "**-a, -as, -a, -amos, -an**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "saber"
          ],
          "filas": [
            [
              "yo",
              "sepa"
            ],
            [
              "tú",
              "sepas"
            ],
            [
              "él, ella, usted",
              "sepa"
            ],
            [
              "nosotros",
              "sepamos"
            ],
            [
              "ustedes, ellos",
              "sepan"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "The **yo** trick doesn't help here: **sé** gives you nothing. Learn **sep-** by heart."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **sepa** sounds like _sepia_, the color of old photos that _know_ the past."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Ella no quiere que yo ==sepa== la verdad.",
              "en": "She doesn't want me to know the truth."
            },
            {
              "es": "Es mejor que ==sepas== las consecuencias.",
              "en": "It's better that you know the consequences."
            },
            {
              "es": "Es posible que él ==sepa== dónde está la llave.",
              "en": "It's possible he knows where the key is."
            },
            {
              "es": "Te llamamos en cuanto lo ==sepamos==.",
              "en": "We'll call you as soon as we know."
            },
            {
              "es": "En cuanto ==sepan== las condiciones, nos avisan.",
              "en": "As soon as they know the conditions, they'll let us know."
            },
            {
              "es": "Dudo que ustedes ==sepan== lo que pasa.",
              "en": "I doubt you know what's going on."
            },
            {
              "es": "Quiero que ==sepas== que eres increíble.",
              "en": "I want you to know you're amazing."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
