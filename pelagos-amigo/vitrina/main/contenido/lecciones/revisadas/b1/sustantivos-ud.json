{
  "tema": 9542,
  "slug": "sustantivos-ud",
  "titulo": "Most nouns ending in -ud are feminine",
  "subtitulo": "La actitud, la salud, la virtud: feminine, plural in -es.",
  "foto": "t03.jpg",
  "regla": "Most nouns ending in -ud are feminine and abstract: la salud, la actitud, la juventud. Plural: -udes. Exceptions: el ataúd, el laúd, el alud.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Most nouns ending in **-ud** are **feminine**, and they're usually **abstract**: **la actitud**, **la virtud**, **la salud**, **la juventud**, **la multitud**, **la solicitud**, **la exactitud**, **la inquietud**."
        },
        {
          "tipo": "texto",
          "texto": "The plural adds **-es**: **la actitud** → **las actitudes**."
        },
        {
          "tipo": "texto",
          "texto": "Adjectives agree in the feminine: **una actitud positiva**, **una solicitud complicada**."
        },
        {
          "tipo": "texto",
          "texto": "Exceptions (masculine): **el ataúd** (_coffin_), **el laúd** (_lute_), **el alud** (_avalanche_)."
        },
        {
          "tipo": "texto",
          "texto": "Tip: health, youth, attitude: all **la**. Only the coffin (and a couple of rare words) is **el**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Traes ==una actitud== muy negativa.",
              "en": "You've got a very negative attitude."
            },
            {
              "es": "Mi esposo tiene ==una virtud==: es súper generoso.",
              "en": "My husband has one virtue: he's super generous."
            },
            {
              "es": "No veía a mi amiga entre ==la multitud==.",
              "en": "I couldn't see my friend in the crowd."
            },
            {
              "es": "==La salud== es más importante que el dinero.",
              "en": "Health is more important than money."
            },
            {
              "es": "Ayer mandé ==la solicitud== para ese trabajo.",
              "en": "Yesterday I sent the application for that job."
            },
            {
              "es": "Hay que dibujar el mapa con ==mucha exactitud==.",
              "en": "You have to draw the map very precisely."
            },
            {
              "es": "==Las actitudes== positivas ayudan en el tatami.",
              "en": "Positive attitudes help on the mat."
            }
          ]
        }
