  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Estar** is almost regular in the present subjunctive: the stem and the endings are the regular **-ar** ones. What's special is the **written accent**: the stress falls on the last syllable, so most forms carry an accent."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "estar"
          ],
          "filas": [
            [
              "yo",
              "esté"
            ],
            [
              "tú",
              "estés"
            ],
            [
              "él, ella, usted",
              "esté"
            ],
            [
              "nosotros",
              "estemos"
            ],
            [
              "ustedes, ellos",
              "estén"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "All forms are stressed on the last syllable and carry an accent **except nosotros**, **estemos**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **estar** leans forward: **es-TÉ**, **es-TÉN**. Only **estemos** stands up straight."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Beto no quiere que ==esté== triste.",
              "en": "Beto doesn't want me to be sad."
            },
            {
              "es": "A mi papá no le gusta que ==estés== aquí.",
              "en": "My dad doesn't like you being here."
            },
            {
              "es": "Espero que él ==esté== bien.",
              "en": "I hope he's okay."
            },
            {
              "es": "Me alegra que ==estemos== todos juntos.",
              "en": "I'm glad we're all together."
            },
            {
              "es": "Es increíble que ==estén== a salvo.",
              "en": "It's great that they're safe."
            },
            {
              "es": "Les pido que ==estén== atentos en el agua.",
              "en": "I'm asking you to stay alert in the water."
            }
          ]
        }
      ]
    },
