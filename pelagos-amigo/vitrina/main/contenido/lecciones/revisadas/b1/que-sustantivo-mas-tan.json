{
  "tema": 7280,
  "slug": "que-sustantivo-mas-tan",
  "titulo": "Exclamations: qué + noun + más / tan + adjective",
  "subtitulo": "¡Qué ola más grande! ¡Qué día tan bonito!",
  "foto": "t07.jpg",
  "regla": "What a + adjective + noun = ¡Qué + noun + más / tan + adjective! No article after qué; qué and más / tan never change; the adjective agrees.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To say _What a [adjective] [noun]!_, Spanish uses:"
        },
        {
          "tipo": "formula",
          "partes": [
            "**¡qué**",
            "noun",
            "**más / tan**",
            "adjective**!**"
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Más** or **tan**: same meaning, use either."
        },
        {
          "tipo": "texto",
          "texto": "**Qué**, **más** and **tan** never change. The **adjective agrees** with the noun: **¡qué olas más grandes!**"
        },
        {
          "tipo": "texto",
          "texto": "No article after **qué**, unlike English _what **a**_: **¡qué día tan bonito!**, never **¡qué un día!**"
        },
        {
          "tipo": "texto",
          "texto": "This **qué** always carries its accent."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **qué**, the thing, then **más** or **tan**, then how it is."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "¡==Qué== casa ==más== bonita!",
              "en": "What a pretty house!"
            },
            {
              "es": "¡==Qué== casa ==tan== bonita!",
              "en": "What a pretty house!"
            },
            {
              "es": "¡==Qué== señor ==más== grosero!",
              "en": "What a rude man!"
            },
            {
              "es": "¡==Qué== verduras ==tan== frescas!",
              "en": "What fresh vegetables!"
            },
            {
              "es": "¡==Qué== tacos ==más== ricos!",
              "en": "What delicious tacos!"
            },
            {
              "es": "¡==Qué== ola ==tan== perfecta!",
              "en": "What a perfect wave!"
            }
          ]
        }
      ]
    },
