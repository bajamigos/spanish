  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Decir** (_to say, to tell_) is irregular in the conditional (**el condicional simple**). It uses the same irregular stem as the future, **dir-**, and the regular conditional endings."
        },
        {
          "tipo": "formula",
          "partes": [
            "**dir-**",
            "**-ía, -ías, -ía, -íamos, -ían**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "decir"
          ],
          "filas": [
            [
              "yo",
              "diría"
            ],
            [
              "tú",
              "dirías"
            ],
            [
              "él, ella, usted",
              "diría"
            ],
            [
              "nosotros",
              "diríamos"
            ],
            [
              "ustedes, ellos",
              "dirían"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Every form has a written accent on the **í** of the ending."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **decir** keeps only **dir-**: say less, mean more."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Yo ==diría== que no hay olas hoy.",
              "en": "I'd say there are no waves today."
            },
            {
              "es": "Tú nunca ==dirías== una mentira.",
              "en": "You'd never tell a lie."
            },
            {
              "es": "Ella ==diría== que no.",
              "en": "She'd say no."
            },
            {
              "es": "Nosotros ==diríamos== que sí.",
              "en": "We'd say yes."
            },
            {
              "es": "Ellos ==dirían== que está roto.",
              "en": "They'd say it's broken."
            }
          ]
        }
      ]
    },
