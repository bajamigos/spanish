{
  "tema": 6147,
  "slug": "si-presente-imperativo",
  "titulo": "Si + present indicative, then a command, request or advice",
  "subtitulo": "Si ves a Beto, dile que venga. Si tomas, no manejes.",
  "foto": "t06.jpg",
  "regla": "Si + present, then a command: affirmative imperative (dile) or negative with the subjunctive (no manejes). Advice can also use debería / tendrías que.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To give a command, request or piece of advice that depends on a condition, use **si** + the **present**, then the **command**."
        },
        {
          "tipo": "formula",
          "partes": [
            "**si** + present",
            "command"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Affirmative commands use the imperative: **si ves a Beto, dile que venga**."
        },
        {
          "tipo": "texto",
          "texto": "Negative commands use **no** + the present subjunctive: **si tomas, no manejes**."
        },
        {
          "tipo": "texto",
          "texto": "For advice, you can also use **deber** or **tener que** in the conditional: **si estás cansado, deberías dormir**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **si** sets the trap, the command springs it."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Si ==ves== a Beto, ==dile== que venga.",
              "en": "If you see Beto, tell him to come."
            },
            {
              "es": "Si ==cocinas== hoy, ==ponte== el mandil.",
              "en": "If you cook today, put on the apron."
            },
            {
              "es": "Si ==estudias== español, ==cómprate== un buen diccionario.",
              "en": "If you study Spanish, buy yourself a good dictionary."
            },
            {
              "es": "Si ==salen==, ==cierren== la puerta.",
              "en": "If you go out, close the door."
            },
            {
              "es": "Si ==tomas==, no ==manejes==.",
              "en": "If you drink, don't drive."
            },
            {
              "es": "Si ==vas== a la playa, no ==te asolees== demasiado.",
              "en": "If you go to the beach, don't sunbathe too long."
            },
            {
              "es": "Si te ==duele== el hombro, ==deberías== descansar.",
              "en": "If your shoulder hurts, you should rest."
            }
          ]
        }
      ]
    },
    {
