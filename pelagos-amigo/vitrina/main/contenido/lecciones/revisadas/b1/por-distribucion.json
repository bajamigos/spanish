      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To express how something is **shared or distributed**, _per, each, for each_, use **por**: **dos tacos por persona**, **una tabla por alumno**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **por** cuts the cake: one slice **por** person."
        }
      ]
    },
