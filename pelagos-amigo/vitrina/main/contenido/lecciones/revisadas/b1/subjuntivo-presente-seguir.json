    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Seguir** (_to follow, to keep on_) and its family, **conseguir** (_to get, to manage_) and **perseguir** (_to chase_), take **two changes** in every form of the present subjunctive:"
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Change",
            "Why"
          ],
          "filas": [
            [
              "**e** → **i**",
              "it's an e > i verb"
            ],
            [
              "**gu** → **g**",
              "before **a**, the **u** isn't needed to keep the hard g"
            ]
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "seguir",
            "conseguir",
            "perseguir"
          ],
          "filas": [
            [
              "yo",
              "siga",
              "consiga",
              "persiga"
            ],
            [
              "tú",
              "sigas",
              "consigas",
              "persigas"
            ],
            [
              "él, ella, usted",
              "siga",
              "consiga",
              "persiga"
            ],
            [
              "nosotros",
              "sigamos",
              "consigamos",
              "persigamos"
            ],
            [
              "ustedes, ellos",
              "sigan",
              "consigan",
              "persigan"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: the **u** was only a bodyguard against **e** and **i**. Next to **a** it goes home."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
