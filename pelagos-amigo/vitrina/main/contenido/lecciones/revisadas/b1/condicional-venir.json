{
  "tema": 5879,
  "slug": "condicional-venir",
  "titulo": "Conjugate venir in the conditional",
  "subtitulo": "Vendría, vendrías, vendríamos: the future stem vendr- with the conditional endings.",
  "foto": "t01.jpg",
  "regla": "Venir has the irregular stem vendr- in the conditional, with the regular endings: vendría, vendrías, vendría, vendríamos, vendrían.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Venir** (_to come_) is irregular in the conditional. It uses the same stem as the future, **vendr-**, plus the regular conditional endings."
        },
        {
          "tipo": "formula",
          "partes": [
            "**vendr-**",
            "**-ía, -ías, -ía, -íamos, -ían**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "venir"
          ],
          "filas": [
            [
              "yo",
              "vendría"
            ],
            [
              "tú",
              "vendrías"
            ],
            [
              "él, ella, usted",
              "vendría"
            ],
            [
              "nosotros",
              "vendríamos"
            ],
            [
              "ustedes, ellos",
              "vendrían"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Verbs built on **venir** do the same: **intervenir** → **intervendría**, **provenir** → **provendría**, **prevenir** → **prevendría**, **convenir** → **convendría**."
        },
        {
          "tipo": "texto",
          "texto": "Every form has a written accent on the **í** of the ending."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **venir** swaps its **i** for a **d**, like **tener**: **ven-d-ría**, **ten-d-ría**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Yo ==vendría== al partido contigo.",
              "en": "I'd come to the game with you."
            },
            {
              "es": "Tú ==vendrías== a la playa con nosotros.",
              "en": "You'd come to the beach with us."
            },
            {
              "es": "Mi vecino ==vendría== a Tijuana todos los días.",
              "en": "My neighbor would come to Tijuana every day."
            },
            {
              "es": "Nosotros ==vendríamos== siempre aquí a comer.",
              "en": "We'd always come here to eat."
            },
            {
              "es": "Tus profes ==vendrían== de la universidad.",
              "en": "Your teachers would come from the university."
            },
            {
              "es": "¿Ustedes ==vendrían== disfrazados?",
              "en": "Would you come in costume?"
            },
            {
              "es": "Te ==convendría== descansar.",
              "en": "It would be good for you to rest."
            }
          ]
        }
      ]
    },
    {
