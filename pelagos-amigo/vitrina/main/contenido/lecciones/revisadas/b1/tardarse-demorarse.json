              "es": "==Me demoro== cinco minutos en llegar al taller.",
              "en": "It takes me five minutes to get to the shop."
            },
            {
              "es": "¿Cuánto tiempo ==tardaste== en abrir el carro?",
              "en": "How long did it take you to open the car?"
            },
            {
              "es": "¿Cuánto ==te tardaste== en corregir los exámenes?",
              "en": "How long did it take you to grade the exams?"
            },
            {
              "es": "El camión ==tarda== una hora en llegar a Rosarito.",
              "en": "The bus takes an hour to get to Rosarito."
            }
          ]
        }
