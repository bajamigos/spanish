      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Some **-zar** verbs take **two changes at once** in the present subjunctive:"
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Change",
            "Where"
          ],
          "filas": [
            [
              "**z** → **c**",
              "every form (z almost never comes before e)"
            ],
            [
              "**e** → **ie**",
              "every form except **nosotros**"
            ]
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "empezar",
            "comenzar"
          ],
          "filas": [
            [
              "yo",
              "empiece",
              "comience"
            ],
            [
              "tú",
              "empieces",
              "comiences"
            ],
            [
              "él, ella, usted",
              "empiece",
              "comience"
            ],
            [
              "nosotros",
              "empecemos",
              "comencemos"
            ],
            [
              "ustedes, ellos",
              "empiecen",
              "comiencen"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: two locks on one door. The **c** lock is always on; the **ie** lock is off for **nosotros**."
        }
      ]
    },
    {
