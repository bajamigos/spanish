{
  "tema": 6236,
  "slug": "subjuntivo-presente-e-ie-ar",
  "titulo": "Conjugate stem-changing -ar verbs (e > ie) in the present subjunctive",
  "subtitulo": "Cierre, recomiende, cerremos: ie everywhere except nosotros.",
  "foto": "t03.jpg",
  "regla": "-ar verbs with e > ie in the present keep it in the subjunctive except nosotros: cierre, cierres, cerremos, cierren.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**-ar** verbs with an **e > ie** stem change in the present keep it in the present subjunctive. The **e** closest to the end of the stem becomes **ie** in every form **except nosotros**. Endings: the regular **-ar** subjunctive ones."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "cerrar",
            "recomendar"
          ],
          "filas": [
            [
              "yo",
              "cierre",
              "recomiende"
            ],
            [
              "tú",
              "cierres",
              "recomiendes"
            ],
            [
              "él, ella, usted",
              "cierre",
              "recomiende"
            ],
            [
              "nosotros",
              "cerremos",
              "recomendemos"
            ],
            [
              "ustedes, ellos",
              "cierren",
              "recomienden"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Other verbs like this: **pensar**, **acertar**, **despertar**, **empezar** (also z > c), **sentarse**, **calentar**."
        },
        {
          "tipo": "texto",
          "texto": "In **recomendar**, only the **e** nearest the end changes: **recom-ie-nde**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Mis amigos quieren que les ==recomiende== una buena taquería.",
              "en": "My friends want me to recommend a good taquería."
            },
            {
              "es": "No ==cierres== la ventana, por favor; tengo calor.",
              "en": "Don't close the window, please; I'm hot."
            },
            {
              "es": "Espero que el jefe me ==recomiende== con sus clientes.",
              "en": "I hope the boss recommends me to his clients."
            },
            {
              "es": "==Recomendemos== a Beto para la chamba.",
              "en": "Let's recommend Beto for the job."
            },
            {
              "es": "Señores, ==cierren== las carpetas ahora.",
              "en": "Gentlemen, close your folders now."
            },
            {
              "es": "Ojalá que ==pienses== en mí.",
              "en": "I hope you think of me."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
