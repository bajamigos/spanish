{
  "tema": 5818,
  "slug": "condicional-valer",
  "titulo": "Conjugate valer in the conditional",
  "subtitulo": "Valdría, valdrías, valdríamos: the future stem valdr- with the conditional endings.",
  "foto": "t04.jpg",
  "regla": "Valer has the irregular stem valdr- in the conditional, with the regular endings: valdría, valdrías, valdría, valdríamos, valdrían.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Valer** (_to cost, to be worth_) is irregular in the conditional (**el condicional simple**). It uses the same irregular stem as the future, **valdr-**, and the regular conditional endings."
        },
        {
          "tipo": "formula",
          "partes": [
            "**valdr-**",
            "**-ía, -ías, -ía, -íamos, -ían**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "valer"
          ],
          "filas": [
            [
              "yo",
              "valdría"
            ],
            [
              "tú",
              "valdrías"
            ],
            [
              "él, ella, usted",
              "valdría"
            ],
            [
              "nosotros",
              "valdríamos"
            ],
            [
              "ustedes, ellos",
              "valdrían"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Valer para** means _to be good at, to be cut out for_. In Mexico you'll more often hear **servir para** or **ser bueno para**."
        },
        {
          "tipo": "texto",
          "texto": "Every form has a written accent on the **í** of the ending."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **valer** gets a **d** too, like **salir**: **val-d-ría**, **sal-d-ría**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Yo ==valdría== millones como ingeniero.",
              "en": "I'd be worth millions as an engineer."
            },
            {
              "es": "Tú no ==valdrías== para eso.",
              "en": "You wouldn't be cut out for that."
            },
            {
              "es": "Este carro ==valdría== mucho en el mercado negro.",
              "en": "This car would be worth a lot on the black market."
            },
            {
              "es": "Nosotros ==valdríamos== para cantar.",
              "en": "We'd be good at singing."
            },
            {
              "es": "Las joyas ==valdrían== una fortuna.",
              "en": "The jewels would be worth a fortune."
            },
            {
              "es": "¿No ==valdría== la pena esperar?",
              "en": "Wouldn't it be worth waiting?"
            }
          ]
        }
      ]
    },
    {
