{
  "tema": 5064,
  "slug": "condicional-hacer",
  "titulo": "Conjugate hacer in the conditional",
  "subtitulo": "Haría, harías, haríamos: the future stem har- with the conditional endings.",
  "foto": "t07.jpg",
  "regla": "Hacer has the irregular stem har- in the conditional, with the regular endings: haría, harías, haría, haríamos, harían.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Hacer** (_to do, to make_) is irregular in the conditional (**el condicional simple**). It uses the same irregular stem as the future, **har-**, and the regular conditional endings."
        },
        {
          "tipo": "formula",
          "partes": [
            "**har-**",
            "**-ía, -ías, -ía, -íamos, -ían**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "hacer"
          ],
          "filas": [
            [
              "yo",
              "haría"
            ],
            [
              "tú",
              "harías"
            ],
            [
              "él, ella, usted",
              "haría"
            ],
            [
              "nosotros",
              "haríamos"
            ],
            [
              "ustedes, ellos",
              "harían"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Use it to say that someone _would do_ something."
        },
        {
          "tipo": "texto",
          "texto": "Every form has a written accent on the **í** of the ending."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **hacer** gets cut short to **har-**: like a board you trimmed, it fits faster."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Yo ==haría== cualquier cosa por ti.",
              "en": "I would do anything for you."
            },
            {
              "es": "¿Qué ==harías== tú en mi lugar?",
              "en": "What would you do in my place?"
            },
            {
              "es": "Amos nunca ==haría== eso.",
              "en": "Amos would never do that."
            },
            {
              "es": "¡Qué ==haríamos== sin ti!",
              "en": "What would we do without you!"
            },
            {
              "es": "Ellos lo ==harían== sin problema.",
              "en": "They'd do it, no problem."
            },
            {
              "es": "Ustedes ==harían== una buena pareja.",
              "en": "You two would make a nice couple."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
