              "filas": [
                {
                  "v": "mal",
                  "t": "Yo hacería lo mismo."
                },
                {
                  "v": "bien",
                  "t": "Yo haría lo mismo."
                }
              ],
              "nota": "The stem is **har-**, not **hacer-**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Qué harias?"
                },
                {
                  "v": "bien",
                  "t": "¿Qué harías?"
                }
              ],
              "nota": "Keep the accent on the **í**."
            }
          ]
        }
      ]
    },
