{
  "tema": 6673,
  "slug": "como-con-y-sin-acento",
  "titulo": "Cómo vs como (with and without an accent)",
  "subtitulo": "¿Cómo estás? / Como te decía… / Yo como tacos.",
  "foto": "t09.jpg",
  "regla": "Cómo (accent) = how, in direct and indirect questions and exclamations: no sé cómo se llama. Como (no accent) = as / like, or I eat (from comer).",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "usos",
          "lista": [
            {
              "forma": "cómo",
              "texto": "**How**: direct questions, indirect questions (**no recuerdo cómo...**) and exclamations (**¡Cómo canta!**)."
            },
            {
              "forma": "como",
              "texto": "**As, like**: comparisons and linking clauses."
            },
            {
              "forma": "como (verb)",
              "texto": "**I eat**, from **comer**."
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **cómo** = how; **como** = like, or lunch."
        }
      ]
    },
    {
      "id": "con-acento",
      "titulo": "Cómo (with accent)",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "¿==Cómo== tomas el café? ¿Con leche y sin azúcar?",
              "en": "How do you take your coffee? With milk and no sugar?"
            },
            {
              "es": "No me acuerdo ==cómo== tomas el café.",
              "en": "I don't remember how you take your coffee."
            },
            {
              "es": "¡==Cómo== canta Natalia Lafourcade!",
              "en": "Natalia Lafourcade sings so beautifully!"
            },
            {
              "es": "Explícame ==cómo== llegaste aquí.",
              "en": "Explain to me how you got here."
            }
          ]
        }
      ]
    },
    {
      "id": "sin-acento",
      "titulo": "Como (no accent)",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Como== te decía, esa chava es muy presumida.",
              "en": "As I was telling you, that girl is really vain."
            },
            {
              "es": "Nunca he conocido a nadie ==como== tú.",
              "en": "I've never met anyone like you."
            },
            {
              "es": "Es tan alto ==como== su papá.",
              "en": "He's as tall as his dad."
            },
            {
              "es": "Yo nunca ==como== verduras.",
              "en": "I never eat vegetables."
            }
          ]
        }
      ]
    },
