      "bloques": [
        {
          "tipo": "texto",
          "texto": "To say _should_ or _ought to_, conjugate **deber** in the **conditional** and add the second verb in the **infinitive**."
        },
        {
          "tipo": "formula",
          "partes": [
            "**deber** in the conditional",
            "infinitive"
          ]
