              "-ía"
            ],
            [
              "nosotros",
              "-íamos"
            ],
            [
              "ustedes, ellos",
              "-ían"
            ]
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "deber"
          ],
          "filas": [
            [
              "yo",
              "debería"
            ],
            [
              "tú",
              "deberías"
            ],
            [
              "él, ella, usted",
              "debería"
            ],
            [
              "nosotros",
              "deberíamos"
            ],
            [
              "ustedes, ellos",
              "deberían"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "The second verb never changes: it stays in the infinitive. Never put **que** in between. You'll hear **deberías de** a lot in Mexico, but the standard form, and the one the quiz wants, has no **de**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **debería** is the voice of good advice: soft, polite, and always followed by a plain infinitive."
        }
      ]
    },
