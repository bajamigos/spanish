          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Debería probar== la salsa antes de servirla.",
              "en": "I should taste the salsa before serving it."
            },
            {
              "es": "¿Qué ==deberías hacer== si te agarra una corriente?",
