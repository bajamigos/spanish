{
  "tema": 5161,
  "slug": "futuro-decir",
  "titulo": "Conjugate decir in the simple future",
  "subtitulo": "Diré, dirás, diremos: a short stem, regular endings.",
  "foto": "t07.jpg",
  "regla": "Decir has the irregular future stem dir- with the regular endings: diré, dirás, dirá, diremos, dirán.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Decir** (_to say, to tell_) is irregular in the future because its stem is **dir-**. The endings are the regular future ones."
        },
        {
          "tipo": "formula",
          "partes": [
            "**dir-**",
            "**-é, -ás, -á, -emos, -án**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "decir"
          ],
          "filas": [
            [
              "yo",
              "diré"
            ],
            [
              "tú",
              "dirás"
            ],
            [
              "él, ella, usted",
              "dirá"
            ],
            [
              "nosotros",
              "diremos"
            ],
            [
              "ustedes, ellos",
              "dirán"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: **decir** loses its middle and keeps only **dir-**: say less, mean more."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Le ==diré== a Beto que llamaste.",
              "en": "I'll tell Beto you called."
            },
            {
              "es": "==Dirás== la verdad.",
              "en": "You'll tell the truth."
            },
            {
              "es": "Me pregunto qué ==dirá== la gente del precio.",
              "en": "I wonder what people will say about the price."
            },
            {
              "es": "No te preocupes, no se lo ==diremos==.",
              "en": "Don't worry, we won't tell him."
            },
            {
              "es": "Los profes ==dirán== cuánto tiempo tenemos.",
              "en": "The teachers will tell us how much time we have."
            },
            {
              "es": "Ustedes ==dirán== que no estuve ahí.",
              "en": "You'll say I wasn't there."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Deciré la verdad."
                },
                {
                  "v": "bien",
                  "t": "Diré la verdad."
                }
              ]
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Diremós que no."
                },
                {
                  "v": "bien",
                  "t": "Diremos que no."
                }
              ],
              "nota": "No accent on **nosotros**."
            }
          ]
        }
      ]
    },
