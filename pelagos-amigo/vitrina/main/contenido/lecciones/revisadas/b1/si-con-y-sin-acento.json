{
  "tema": 6603,
  "slug": "si-con-y-sin-acento",
  "titulo": "Sí vs si: with and without an accent",
  "subtitulo": "Sí = yes; si = if, whether.",
  "foto": "t05.jpg",
  "regla": "Sí with an accent = yes (and the emphatic sí, sí mismo). Si without an accent = if (conditions) and whether (indirect questions).",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Some Spanish words change meaning with just a written accent. **Sí** and **si** are one pair."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Form",
            "Meaning",
            "Example"
          ],
          "filas": [
            [
              "sí",
              "_yes_",
              "—¿Quieres una cerveza? —Sí, gracias."
            ],
            [
              "",
              "emphasis: _really do_",
              "Ella sí sabe surfear."
            ],
            [
              "si",
              "_if_, in conditions",
              "Si quieres, vamos."
            ],
            [
              "",
              "_whether_, in indirect questions",
              "No sé si viene."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Sí** can also be a noun: **dar el sí** = _to say yes, to agree_ (at a wedding, for example)."
        },
        {
          "tipo": "texto",
          "texto": "**Si** is also the musical note B."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **sí** says yes with a nod (the accent). **Si** only wonders."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "—¿Quieres una cerveza? —==Sí==, gracias.",
              "en": "\"Do you want a beer?\" \"Yes, thanks.\""
            },
            {
              "es": "==Si== quieres, nos tomamos unas cervezas.",
              "en": "If you want, we can have a few beers."
            },
            {
              "es": "No sabe ==si== prefiere surf o jiu-jitsu.",
              "en": "He doesn't know whether he prefers surfing or jiu-jitsu."
            },
            {
              "es": "Pregúntale a Beto ==si== va a venir.",
              "en": "Ask Beto whether he's coming."
            },
            {
              "es": "Yo no sé surfear, pero mi hermana ==sí==.",
              "en": "I can't surf, but my sister can."
            },
            {
              "es": "Le dio el ==sí== en el altar.",
              "en": "She said yes at the altar."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Si, claro."
                },
                {
                  "v": "bien",
                  "t": "Sí, claro."
                }
              ],
              "nota": "_Yes_ needs the accent."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Sí llueve, no vamos."
                },
                {
                  "v": "bien",
                  "t": "Si llueve, no vamos."
                }
              ],
              "nota": "_If_: no accent."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "No sé sí viene."
                },
                {
                  "v": "bien",
                  "t": "No sé si viene."
                }
              ],
              "nota": "_Whether_: no accent."
            }
          ]
        }
      ]
    },
