      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Ser** (_to be_) is **regular** in the conditional: the whole infinitive plus the regular endings, like any regular verb."
        },
        {
          "tipo": "formula",
          "partes": [
            "**ser**",
            "**-ía, -ías, -ía, -íamos, -ían**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "ser"
          ],
          "filas": [
            [
              "yo",
              "sería"
            ],
            [
              "tú",
              "serías"
            ],
            [
              "él, ella, usted",
              "sería"
            ],
            [
              "nosotros",
              "seríamos"
            ],
            [
              "ustedes, ellos",
              "serían"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**¿Serías tan amable de…?** is a polite way to ask a favor: _would you be so kind as to…?_"
        },
        {
          "tipo": "texto",
          "texto": "Tip: **ser** is wild in the present but calm in the conditional."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Yo ==sería== más prudente que tú.",
              "en": "I'd be more careful than you."
            },
            {
              "es": "¿==Serías== tan amable de pasarme la chamarra?",
              "en": "Would you be so kind as to pass me my jacket?"
            },
            {
              "es": "Naomi ==sería== una capitana increíble.",
              "en": "Naomi would be an amazing captain."
            },
            {
              "es": "Nosotros no ==seríamos== buenos roomies.",
              "en": "We wouldn't be good roommates."
            },
            {
              "es": "Ellas no ==serían== muy competitivas.",
              "en": "They wouldn't be very competitive."
            },
            {
              "es": "Ustedes ==serían== un buen ejemplo para mis hijos.",
              "en": "You'd be a good example for my kids."
            }
          ]
        }
