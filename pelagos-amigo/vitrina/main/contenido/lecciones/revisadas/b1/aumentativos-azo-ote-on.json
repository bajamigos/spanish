            },
            {
              "es": "Me di un ==cabezazo== y me mareé.",
              "en": "I banged my head and got dizzy."
            },
            {
              "es": "En el rol me dio un ==codazo== sin querer.",
              "en": "He elbowed me by accident while rolling."
            },
            {
              "es": "Salió dando un ==portazo==.",
