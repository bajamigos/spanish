                  "v": "bien",
                  "t": "Están bien cansados."
                }
              ],
              "nota": "**Bien** never changes."
            },
            {
              "filas": [
                {
                  "v": "bien",
                  "t": "Está bien."
                },
                {
                  "v": "bien",
                  "t": "Está bien rico."
                }
              ],
              "nota": "Alone, **bien** means _well, fine_. Before an adjective, it means _very_."
            }
          ]
        }
      ]
