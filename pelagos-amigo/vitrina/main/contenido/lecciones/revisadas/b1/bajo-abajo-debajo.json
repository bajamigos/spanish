    {
      "id": "bajo",
      "titulo": "Bajo: formal and figurative",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Bajo** means the same as **debajo de**, a little more formal or literary:"
        },
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Los novios se sentaron ==bajo== el árbol.",
              "en": "The couple sat beneath the tree."
            },
            {
              "es": "Me escondía ==bajo== la falda de mi mamá.",
              "en": "I used to hide under my mom's skirt."
            }
          ]
        },
        {
          "tipo": "texto",
          "texto": "It's also used **figuratively**, for control, influence or conditions:"
        },
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Manejó ==bajo== los efectos del alcohol.",
