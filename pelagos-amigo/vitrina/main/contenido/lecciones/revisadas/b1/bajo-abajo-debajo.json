          ]
        },
        {
          "tipo": "texto",
          "texto": "**Debajo de** needs **de**. **Bajo** never takes **de**."
        },
        {
          "tipo": "texto",
          "texto": "**Debajo** and **abajo** stand alone, with no noun after them."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **abajo** points down the stairs; **debajo de** looks under the table."
        }
      ]
