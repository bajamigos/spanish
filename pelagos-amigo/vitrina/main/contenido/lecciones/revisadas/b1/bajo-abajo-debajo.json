              "debajo de + noun",
              "preposition",
              "under something (most common)"
            ],
            [
              "bajo + noun",
              "preposition",
              "under something (more formal), and figurative uses"
            ],
            [
              "debajo",
              "adverb",
              "underneath, below (more precise)"
