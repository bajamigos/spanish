  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Salir** (_to leave, to go out_) is irregular in the future because its stem is **saldr-**. The endings are regular."
        },
        {
          "tipo": "formula",
          "partes": [
            "**saldr-**",
            "**-é, -ás, -á, -emos, -án**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "salir"
          ],
          "filas": [
            [
              "yo",
              "saldré"
            ],
            [
              "tú",
              "saldrás"
            ],
            [
              "él, ella, usted",
              "saldrá"
            ],
            [
              "nosotros",
              "saldremos"
            ],
            [
              "ustedes, ellos",
              "saldrán"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Tip: just like **tener** → **tendré** and **venir** → **vendré**, the vowel goes and a **d** comes in: **sal-d-ré**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Estoy cansado, así que no ==saldré== hoy en la noche.",
              "en": "I'm tired, so I won't go out tonight."
            },
            {
              "es": "¿==Saldrás== con tus amigos?",
              "en": "Will you go out with your friends?"
            },
            {
              "es": "Seguro que Beto ==saldrá== con esa chava.",
              "en": "I'm sure Beto will go out with that girl."
            },
            {
              "es": "==Saldremos== temprano, antes del viento.",
              "en": "We'll leave early, before the wind."
            },
            {
              "es": "El Rocinante ==saldrá== de la estación a las seis.",
              "en": "The Rocinante will leave the station at six."
            },
            {
              "es": "==Saldrán== del laberinto sin problema.",
              "en": "They'll get out of the maze with no problem."
            }
          ]
        }
      ]
