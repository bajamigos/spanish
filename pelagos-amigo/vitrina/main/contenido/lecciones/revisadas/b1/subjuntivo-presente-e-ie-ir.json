            },
            {
              "es": "Quizás ==prefieran== tacos de pescado.",
              "en": "Maybe they'd rather have fish tacos."
            },
            {
              "es": "Te sugiero que no le ==mientas== al profe.",
              "en": "I suggest you don't lie to the coach."
            }
          ]
        }
      ]
