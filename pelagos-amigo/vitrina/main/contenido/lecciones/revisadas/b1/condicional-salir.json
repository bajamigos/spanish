  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Salir** (_to go out, to leave_) is irregular in the conditional (**el condicional simple**). It uses the same irregular stem as the future, **saldr-**, and the regular conditional endings."
        },
        {
          "tipo": "formula",
          "partes": [
            "**saldr-**",
            "**-ía, -ías, -ía, -íamos, -ían**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "salir"
          ],
          "filas": [
            [
              "yo",
              "saldría"
            ],
            [
              "tú",
              "saldrías"
            ],
            [
              "él, ella, usted",
              "saldría"
            ],
            [
              "nosotros",
              "saldríamos"
            ],
            [
              "ustedes, ellos",
              "saldrían"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Every form has a written accent on the **í** of the ending."
        },
        {
          "tipo": "texto",
          "texto": "Tip: the **i** of **salir** steps out and a **d** steps in: **sal-d-ría**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Yo no ==saldría== con ese chavo.",
              "en": "I wouldn't go out with that guy."
            },
            {
              "es": "Tú ==saldrías== así a la fiesta.",
              "en": "You'd go out to the party like that."
            },
            {
              "es": "Mi examen ==saldría== muy mal.",
              "en": "My exam would go really badly."
            },
            {
              "es": "Mis primos y yo ==saldríamos== bien vestidos.",
              "en": "My cousins and I would go out well dressed."
            },
            {
              "es": "Ustedes ==saldrían== del hotel a las doce.",
              "en": "You'd leave the hotel at twelve."
            }
          ]
        }
      ]
    },
