  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Venir** (_to come_) is irregular in the **simple future** (**futuro imperfecto**) because of its stem: **vendr-**. The **i** of the infinitive turns into a **d**. The endings are the regular ones."
        },
        {
          "tipo": "formula",
          "partes": [
            "irregular stem **vendr-**",
            "**-é, -ás, -á, -emos, -án**"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "Ending",
            "venir → vendr-"
          ],
          "filas": [
            [
              "yo",
              "-é",
              "vendré"
            ],
            [
              "tú",
              "-ás",
              "vendrás"
            ],
            [
              "él, ella, usted",
              "-á",
              "vendrá"
            ],
            [
              "nosotros",
              "-emos",
              "vendremos"
            ],
            [
              "ustedes, ellos",
              "-án",
              "vendrán"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Verbs built on **venir** do the same: **convenir** → **convendrá**, **prevenir** → **prevendré**, **intervenir** → **intervendré**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **venir** and **tener** are twins in the future: **vendré**, **tendré**. Same shape, one letter apart."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
