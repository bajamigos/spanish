{
  "tema": 7179,
  "slug": "mas-con-y-sin-acento",
  "titulo": "Más vs mas: with and without an accent",
  "subtitulo": "Más = more; mas = but (formal, written).",
  "foto": "t08.jpg",
  "regla": "Más with an accent = more (comparisons, quantities, also plus). Mas without an accent = but, a formal, written synonym of pero.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Más** and **mas** change meaning with the accent."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Form",
            "Meaning",
            "Example"
          ],
          "filas": [
            [
              "más",
              "_more_ (comparisons, quantities)",
              "Beto es más alto que yo."
            ],
            [
              "",
              "_plus_ (math)",
              "Dos más dos son cuatro."
            ],
            [
              "mas",
              "_but_ (formal, written, like pero)",
              "Nos invitaron, mas no fuimos."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "You'll use **más** all the time; **mas** without an accent is rare, mostly in formal or literary writing. In everyday speech, use **pero**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: if you mean _more_, give it the accent. If you mean _but_, just say **pero**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Beto siempre ha sido ==más== generoso que su hermano.",
              "en": "Beto has always been more generous than his brother."
            },
            {
              "es": "Necesito media hora ==más== para terminar el examen.",
              "en": "I need half an hour more to finish the exam."
            },
            {
              "es": "—¿Quieres otro café? —No, ya no quiero ==más==, gracias.",
              "en": "\"Do you want another coffee?\" \"No, I don't want any more, thanks.\""
            },
            {
              "es": "Recibimos la invitación a la ceremonia, ==mas== no asistimos.",
              "en": "We received the invitation to the ceremony, but we didn't attend."
            },
            {
              "es": "Recibimos la invitación, ==pero== no fuimos.",
              "en": "We got the invitation, but we didn't go. (everyday)"
            }
          ]
        }
      ]
    },
