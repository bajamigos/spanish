{
  "tema": 5982,
  "slug": "estar-de-trabajo-temporal",
  "titulo": "Estar de (not ser) for a temporary job",
  "subtitulo": "Estoy de mesero en Rosarito: a job for now, not a profession.",
  "foto": "t05.jpg",
  "regla": "For a temporary job, use estar de + job (no article): estoy de mesero. For a permanent profession, use ser: soy cerrajero.",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To talk about a **temporary job**, what you're working as for now, use **estar** + **de** + the job."
        },
        {
          "tipo": "formula",
          "partes": [
            "**estar**",
            "**de**",
            "job"
          ]
        },
        {
          "tipo": "texto",
          "texto": "No article: **estoy de mesero**, not **estoy de un mesero**. The job agrees with the person: **está de recepcionista**, **estamos de mecánicos**."
        },
        {
          "tipo": "texto",
          "texto": "For your **permanent profession**, use **ser** without **de**: **soy cerrajero** (see [[6090|ser for what you do for a living]])."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **ser** is the career; **estar de** is the side gig."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Estoy de== recepcionista en un hotel.",
              "en": "I'm working as a receptionist at a hotel."
            },
            {
              "es": "Mario ==estaba de== mesero en un restaurante.",
              "en": "Mario was working as a waiter in a restaurant."
            },
            {
