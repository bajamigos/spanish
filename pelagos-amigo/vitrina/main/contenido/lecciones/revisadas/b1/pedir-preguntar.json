  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "English _to ask_ is two verbs in Spanish:"
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Verb",
            "Use",
            "Example"
          ],
          "filas": [
            [
              "pedir",
              "to ask **for** a thing",
              "Le pedí sal."
            ],
            [
              "",
              "to order",
              "Pedí dos libros en línea."
            ],
            [
              "",
              "to ask a favor",
              "¿Te puedo pedir un favor?"
            ],
            [
              "",
              "to ask someone to do something (+ que + subjunctive)",
              "Le pedí que me ayudara / me pidió que viniera."
            ],
            [
              "preguntar",
              "to ask a question, for information",
              "Le pregunté la hora."
            ],
            [
              "",
              "+ si / qué / dónde / cuándo…",
              "Pregúntale si viene."
            ],
            [
              "preguntar por",
              "to ask about someone",
              "Beto preguntó por ti."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Pedir** is e > i: **pido**, **pides**, **pidió**. It often goes with an indirect pronoun, since you ask people for things: **me pidió**, **le pedí**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **pedir** wants something; **preguntar** wants to know something."
        }
      ]
    },
    {
