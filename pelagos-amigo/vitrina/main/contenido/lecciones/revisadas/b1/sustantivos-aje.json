{
  "tema": 6151,
  "slug": "sustantivos-aje",
  "titulo": "Nouns ending in -aje are masculine",
  "subtitulo": "El viaje, el equipaje, el paisaje: always masculine.",
  "foto": "t05.jpg",
  "regla": "All nouns ending in -aje are masculine: el viaje, el equipaje, el mensaje. Plural: add -s (los viajes).",
  "comparada_kwiziq": "2026-10-10",
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**All** nouns ending in **-aje** are **masculine**: **el viaje**, **el equipaje**, **el mensaje**, **el paisaje**, **el garaje**, **el pasaje**, **el aprendizaje**, **el espionaje**, **el masaje**."
        },
        {
          "tipo": "texto",
          "texto": "The plural just adds **-s**: **los viajes**, **los pasajes**."
        },
        {
          "tipo": "texto",
          "texto": "Articles and adjectives agree in the masculine: **un viaje largo**, **el mensaje nuevo**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **-aje** ends in **e**, but it's always a guy: **el viaje**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Tuvimos ==un viaje increíble== a Baja Sur.",
              "en": "We had an amazing trip to Baja Sur."
            },
            {
              "es": "Siempre llevas ==demasiado equipaje==.",
              "en": "You always bring too much luggage."
            },
            {
              "es": "==El espionaje== es algo que me apasiona.",
              "en": "Espionage is something I'm passionate about."
            },
            {
              "es": "Mi hijo hace ==unos viajes increíbles== en verano.",
              "en": "My son takes some amazing trips in the summer."
            },
            {
              "es": "==Los masajes== en ese spa cuestan ochocientos pesos.",
              "en": "The massages at that spa cost eight hundred pesos."
            },
            {
              "es": "¿Viste ==el mensaje== que te mandé?",
              "en": "Did you see the message I sent you?"
            },
            {
              "es": "==El paisaje== de Valle de Guadalupe es precioso.",
              "en": "The landscape in Valle de Guadalupe is beautiful."
            }
          ]
        }
