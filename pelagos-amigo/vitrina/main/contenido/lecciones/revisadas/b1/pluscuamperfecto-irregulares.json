    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "These verbs are easy in the pluperfect: **haber** is the same as always (**había, habías, había, habíamos, habían**), and only the **past participle** is irregular. You use the pluperfect for what _had happened_ in the past."
        },
        {
          "tipo": "formula",
          "partes": [
            "**había**…",
            "irregular participle"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Infinitive",
            "Participle",
            "Pluperfect (yo)"
          ],
          "filas": [
            [
              "hacer",
              "hecho",
              "había hecho"
            ],
            [
              "escribir",
              "escrito",
              "había escrito"
            ],
            [
              "ver",
              "visto",
              "había visto"
            ],
            [
              "decir",
              "dicho",
              "había dicho"
            ],
            [
              "poner",
              "puesto",
              "había puesto"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Every form of **haber** has a written accent on the **í**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: three of them end in **-to** (escrito, visto, puesto) and two in **-cho** (hecho, dicho)."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Yo no ==había hecho== nada todavía.",
              "en": "I hadn't done anything yet."
            },
            {
              "es": "¿Cuándo ==habías escrito== el mensaje?",
              "en": "When had you written the message?"
            },
            {
              "es": "Beto ==había puesto== las llaves en el mostrador.",
              "en": "Beto had put the keys on the counter."
            },
            {
              "es": "Nosotros ==habíamos dicho== la verdad.",
              "en": "We had told the truth."
            },
            {
              "es": "Holden y Naomi ==habían visto== la nave.",
              "en": "Holden and Naomi had seen the ship."
            },
            {
              "es": "¿Ustedes no ==habían visto== esa película?",
              "en": "Hadn't you seen that movie?"
            },
            {
              "es": "Me dijo que ustedes ==habían puesto== los papeles en el cajón.",
              "en": "He told me you had put the papers in the drawer."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
