            },
            {
              "es": "En mi huerto hay ==menos jitomates que== chiles.",
              "en": "In my garden there are fewer tomatoes than chiles."
            },
            {
              "es": "Entreno ==más que== mi hermano.",
              "en": "I train more than my brother."
            },
            {
              "es": "Mi primo come ==menos que== tú.",
              "en": "My cousin eats less than you."
            },
            {
              "es": "Amos pelea ==más rápido que== Holden.",
              "en": "Amos fights faster than Holden."
            }
