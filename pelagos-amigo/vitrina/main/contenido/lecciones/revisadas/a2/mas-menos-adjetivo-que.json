{
  "tema": 6210,
  "slug": "mas-menos-adjetivo-que",
  "titulo": "More … than, less … than: más … que, menos … que",
  "subtitulo": "«Mi tabla es más larga que la tuya.»",
  "foto": "t03.jpg",
  "regla": "To compare two unequal things, put más (more) or menos (less) before the adjective, adverb or noun, and que (than) before the second thing. With a verb, más / menos goes right after the verb: corro más que tú.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "With an **adjective**, **adverb** or **noun**:"
        },
        {
          "tipo": "formula",
          "partes": [
            "más / menos",
            "+ adjective / adverb / noun +",
            "que"
          ]
        },
        {
          "tipo": "texto",
          "texto": "With a **verb**:"
        },
        {
          "tipo": "formula",
          "partes": [
            "verb",
            "+ más / menos +",
            "que"
          ]
        },
        {
          "tipo": "texto",
          "texto": "_Than_ is **que**. The adjective still agrees: Ana es **más alta** que Beto; mis tacos son **menos caros**."
        },
        {
          "tipo": "texto",
          "texto": "After **que** use **yo** and **tú**, not mí or ti: más alto que **yo**."
        },
        {
          "tipo": "texto",
          "texto": "With a number, use **más de / menos de**: más **de** cien pesos."
        },
        {
          "tipo": "texto",
          "texto": "Good and bad are irregular: **mejor**, **peor** (not más bueno, más malo)."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Mi tabla es ==más larga que== la tuya.",
              "en": "My board is longer than yours."
            },
            {
