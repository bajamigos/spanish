{
  "tema": 6870,
  "slug": "a-personal-ver-conocer",
  "titulo": "The personal a",
  "subtitulo": "Veo a Beto, pero veo el mar.",
  "foto": "t09.jpg",
  "regla": "When the direct object of a verb like ver, visitar, buscar or conocer is a specific person (or a pet), put a before it: veo a Beto, conozco a Naomi. No a before things or places.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "When a **specific person** receives the action of the verb, Spanish puts **a** before that person. English has nothing there."
        },
        {
          "tipo": "formula",
          "partes": [
            "verb",
            "+ a +",
            "person"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Verb",
            "Person: a",
            "Thing or place: no a"
          ],
          "filas": [
            [
              "ver",
              "Veo a Beto.",
              "Veo el mar."
            ],
            [
              "visitar",
              "Visito a mi abuela.",
              "Visito Ensenada."
            ],
            [
              "buscar",
              "Busco a mi hermana.",
              "Busco las llaves."
            ],
            [
              "conocer",
              "Conozco a tu primo.",
              "Conozco Rosarito."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**A + el = al**: **busco al profesor**."
        },
        {
          "tipo": "texto",
          "texto": "It also goes before **alguien** and **nadie**: **¿Ves a alguien?**, **no conozco a nadie**."
        },
        {
          "tipo": "texto",
          "texto": "Pets you love get it too: **paseo a mi perro**."
        },
        {
          "tipo": "texto",
          "texto": "After **tener** there's normally no a: **tengo dos hermanos**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: the **a** is a handshake. You give it to people, not to things."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Veo a== Beto todos los domingos en la playa.",
              "en": "I see Beto every Sunday at the beach."
            },
            {
              "es": "Este fin de semana ==visitamos a== mi abuela en Tecate.",
              "en": "This weekend we're visiting my grandma in Tecate."
            },
            {
              "es": "¿==Conoces a== Naomi? Es mi compañera de jiu-jitsu.",
              "en": "Do you know Naomi? She trains jiu-jitsu with me."
            },
            {
              "es": "==Busco a== mi hermano. ¿Lo has visto?",
              "en": "I'm looking for my brother. Have you seen him?"
            },
            {
              "es": "==Busco al== profesor de surf.",
              "en": "I'm looking for the surf instructor."
            },
            {
              "es": "No ==conozco a== nadie en esta fiesta.",
              "en": "I don't know anybody at this party."
            },
            {
              "es": "¿==Ves a== alguien en el agua?",
              "en": "Do you see anyone in the water?"
            },
            {
              "es": "Saco ==a== mi perro a caminar en la mañana.",
              "en": "I take my dog for a walk in the morning."
            }
          ]
        }
      ]
    },
    {
