{
  "tema": 7055,
  "slug": "he-sido-perfecto-ser",
  "titulo": "Ser in the present perfect",
  "subtitulo": "Hoy ha sido un día muy largo.",
  "foto": "t10.jpg",
  "regla": "Ser in the present perfect is haber in the present + sido: he sido, has sido, ha sido, hemos sido, han sido. Sido never changes. For been somewhere or a temporary state, use estado (from estar).",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Build it with **haber** in the present + **sido**. **Sido** is regular and never changes."
        },
        {
          "tipo": "formula",
          "partes": [
            "he / has / ha / hemos / han",
            "+",
            "sido"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "Ser"
          ],
          "filas": [
            [
              "yo",
              "he sido"
            ],
            [
              "tú",
              "has sido"
            ],
            [
              "él, ella, usted",
              "ha sido"
            ],
            [
              "nosotros, nosotras",
              "hemos sido"
            ],
            [
              "ellos, ellas, ustedes",
              "han sido"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "The adjective after it agrees, **sido** doesn't: **la semana ha sido difícil**."
        },
        {
          "tipo": "texto",
          "texto": "English _been_ is not always **sido**. The usual **ser** / **estar** rules still apply:"
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Meaning",
            "Spanish"
          ],
          "filas": [
            [
              "_been_ + identity, character, relationship",
              "**he sido** amigo, **ha sido** difícil"
            ],
            [
              "_been_ somewhere",
              "**he estado** en Ensenada"
            ],
            [
              "_been_ + temporary state",
              "**he estado** cansado"
            ]
          ]
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Hoy ==ha sido== un día muy largo.",
              "en": "Today has been a very long day."
            },
            {
              "es": "Siempre ==has sido== muy buena onda conmigo.",
              "en": "You've always been really nice to me."
            },
            {
              "es": "Nunca ==he sido== bueno para cocinar.",
              "en": "I've never been good at cooking."
            },
            {
              "es": "==Hemos sido== amigos desde la prepa.",
              "en": "We've been friends since high school."
            },
            {
              "es": "Las olas de este mes ==han sido== increíbles.",
              "en": "The waves this month have been amazing."
            },
            {
              "es": "¿Cómo ==ha sido== tu primera semana en el trabajo?",
              "en": "How has your first week at work been?"
            },
            {
              "es": "Ustedes ==han sido== muy pacientes conmigo.",
              "en": "You all have been very patient with me."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
