              "en": "How much water do you drink a day?"
            },
            {
              "es": "¿==Cuántos== años tienes?",
              "en": "How old are you?"
            },
            {
              "es": "¿==Cuántas== olas agarraste hoy?",
              "en": "How many waves did you catch today?"
            },
            {
              "es": "¿==Cuánto== tiempo llevas entrenando jiu-jitsu?",
              "en": "How long have you been training jiu-jitsu?"
            },
            {
              "es": "¿==Cuánta== gente vino a la fiesta?",
              "en": "How many people came to the party?"
            },
            {
              "es": "¿==Cuántos== hermanos tiene tu novia?",
              "en": "How many brothers and sisters does your girlfriend have?"
            },
            {
              "es": "No sé ==cuántas== semillas planté.",
              "en": "I don't know how many seeds I planted."
            }
          ]
        }
      ]
