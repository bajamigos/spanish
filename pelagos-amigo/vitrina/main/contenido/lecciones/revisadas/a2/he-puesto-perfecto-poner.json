                  "t": "He ponido la mesa."
                },
                {
                  "v": "bien",
                  "t": "He puesto la mesa."
                }
              ],
              "nota": "Irregular participle: **puesto**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "La he puesta en la mesa."
                },
                {
                  "v": "bien",
                  "t": "La he puesto en la mesa."
