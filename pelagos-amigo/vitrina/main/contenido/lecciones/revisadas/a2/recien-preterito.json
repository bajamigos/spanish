{
  "tema": 9554,
  "slug": "recien-preterito",
  "titulo": "Recién for actions that just happened",
  "subtitulo": "Recién llegué. Tortillas recién hechas.",
  "foto": "t08.jpg",
  "regla": "In Mexico, recién + preterite means just did: Recién llegué = I just arrived (= Acabo de llegar). Recién + past participle means freshly / newly: recién pintado. Recién never changes; the participle agrees.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Recién** + **preterite** = _just_ did something. It goes **right before** the verb."
        },
        {
          "tipo": "formula",
          "partes": [
            "recién",
            "+",
            "preterite"
          ]
        },
        {
          "tipo": "texto",
          "texto": "It means the same as **acabar de** + infinitive: **Recién llegué** = **Acabo de llegar**."
        },
        {
          "tipo": "texto",
          "texto": "**Recién** + **past participle** = _freshly, newly_: **recién hecho**, **recién pintado**, **recién casados**."
        },
        {
          "tipo": "texto",
          "texto": "**Recién** never changes. The participle agrees with the noun: **tortillas recién hechas**."
        },
        {
          "tipo": "texto",
          "texto": "It always has an accent: **recién**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Recién llegué== a la playa.",
              "en": "I just got to the beach."
            },
            {
              "es": "==Recién comimos==; no tenemos hambre.",
              "en": "We just ate; we're not hungry."
            },
            {
              "es": "==Recién terminé== la clase de jiu-jitsu.",
              "en": "I just finished jiu-jitsu class."
            },
            {
              "es": "==Recién empezó== a llover.",
              "en": "It just started raining."
            },
            {
              "es": "==Acabo de llegar== a Tijuana.",
              "en": "I just arrived in Tijuana."
            },
            {
              "es": "Las tortillas están ==recién hechas==.",
              "en": "The tortillas are freshly made."
            },
            {
              "es": "Cuidado, la pared está ==recién pintada==.",
              "en": "Careful, the wall is freshly painted."
            },
            {
              "es": "Los ==recién casados== se fueron a Cancún.",
              "en": "The newlyweds went to Cancún."
            }
          ]
        }
      ]
    },
    {
