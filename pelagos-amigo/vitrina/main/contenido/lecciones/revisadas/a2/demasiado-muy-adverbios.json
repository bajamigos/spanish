  "foto": "t05.jpg",
  "regla": "Used as adverbs (with an adjective, an adverb or a verb), demasiado, bastante, un poco, mucho, muy, tan and tanto never change form. Muy and tan go before adjectives and adverbs; mucho and tanto go with verbs; demasiado, bastante and un poco work with both.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "These words say _how much_. As **adverbs** they never change: no gender, no plural."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Word",
