            ],
            [
              "tanto",
              "_so much_",
              "—",
              "como tanto"
            ],
            [
              "demasiado",
              "_too, too much_",
              "demasiado caro",
              "como demasiado"
            ],
            [
              "bastante",
              "_quite, a fair amount_",
              "bastante caro",
              "como bastante"
            ],
            [
              "un poco",
              "_a bit_",
              "un poco caro",
              "como un poco"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Muy** and **tan** go **before** an adjective or adverb. With a verb, use **mucho** and **tanto** **after** it."
        },
        {
          "tipo": "texto",
          "texto": "**Demasiado**, **bastante** and **un poco** go before an adjective or after a verb, same form."
        },
        {
          "tipo": "texto",
          "texto": "Before an adjective they stay masculine singular: **las olas están demasiado grandes**, never _demasiadas grandes_."
        },
        {
          "tipo": "texto",
          "texto": "Small exception: **mucho** goes before **mejor, peor, más, menos**: **mucho mejor**."
        }
      ]
    },
