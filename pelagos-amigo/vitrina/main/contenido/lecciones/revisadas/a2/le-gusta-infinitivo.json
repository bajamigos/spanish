{
  "tema": 10727,
  "slug": "le-gusta-infinitivo",
  "titulo": "Gustar + infinitive: he likes, we like, they like",
  "subtitulo": "A Luis le gusta surfear.",
  "foto": "t08.jpg",
  "regla": "To say someone likes doing something, use the pronoun (me, te, le, nos, les) + gusta + infinitive: le gusta surfear, nos gusta bailar. Gusta stays singular, even with several infinitives.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "The person who likes it is the **indirect pronoun**; the activity is the **infinitive**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Who likes it",
            "Pronoun + gusta",
            "Example"
          ],
          "filas": [
            [
              "_I_",
              "me gusta",
              "Me gusta cocinar."
            ],
            [
              "_you_ (tú)",
              "te gusta",
              "¿Te gusta bailar?"
            ],
            [
              "_he, she, you_ (usted)",
              "le gusta",
              "Le gusta surfear."
            ],
            [
              "_we_",
              "nos gusta",
              "Nos gusta caminar."
            ],
            [
              "_they, you_ (ustedes)",
              "les gusta",
              "Les gusta leer."
            ]
          ]
        },
        {
          "tipo": "formula",
          "partes": [
            "le / nos / les",
            "+ gusta +",
            "infinitive"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Always **gusta**, singular: an activity counts as one thing. Even with two or three: **Les gusta** nadar y correr."
        },
        {
          "tipo": "texto",
          "texto": "To say who: **a** + name or pronoun, and keep the pronoun: **A Luis le** gusta surfear. **A mis papás les** gusta bailar."
        },
        {
          "tipo": "texto",
          "texto": "Negative: **no** goes before the pronoun: **No nos** gusta madrugar."
        },
        {
          "tipo": "texto",
          "texto": "Tip: the activity is the subject. _Surfing pleases him_ = **le gusta surfear**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "A Luis ==le gusta surfear== en las mañanas.",
              "en": "Luis likes surfing in the mornings."
            },
            {
              "es": "==Nos gusta comer== tacos de pescado en Ensenada.",
              "en": "We like eating fish tacos in Ensenada."
            },
            {
              "es": "A mis papás ==les gusta bailar== cumbia.",
              "en": "My parents like dancing cumbia."
            },
            {
              "es": "¿A usted ==le gusta cocinar==?",
              "en": "Do you like cooking?"
            },
            {
              "es": "A mi novia ==le gusta leer y escribir==.",
              "en": "My girlfriend likes reading and writing."
            },
            {
              "es": "==No les gusta madrugar==.",
              "en": "They don't like getting up early."
            },
            {
              "es": "A Sofía ==le gusta entrenar== jiu-jitsu los sábados.",
              "en": "Sofía likes training jiu-jitsu on Saturdays."
            },
            {
              "es": "¿A ustedes ==les gusta trabajar== en el huerto?",
              "en": "Do you all like working in the garden?"
            }
          ]
        }
      ]
    },
    {
