{
  "tema": 6141,
  "slug": "conmigo-contigo-con-el",
  "titulo": "Con + pronouns: with me, with you, with him…",
  "subtitulo": "«¿Vienes conmigo? Sí, voy contigo.»",
  "foto": "t04.jpg",
  "regla": "With me is conmigo and with you (tú) is contigo. Every other person uses con + the normal pronoun: con él, con ella, con usted, con nosotros, con ustedes, con ellos.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Con** + **mí** and **con** + **ti** fuse into one word: **conmigo** and **contigo**."
        },
        {
          "tipo": "texto",
          "texto": "All the other persons are regular: **con** + the same pronoun you use as a subject."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "With…"
          ],
          "filas": [
            [
              "yo",
              "**conmigo**"
            ],
            [
              "tú",
              "**contigo**"
            ],
            [
              "él / ella / usted",
              "con él / con ella / con usted"
            ],
            [
              "nosotros / nosotras",
              "con nosotros / con nosotras"
            ],
            [
              "ustedes",
              "con ustedes"
            ],
            [
              "ellos / ellas",
              "con ellos / con ellas"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Con mí**, **con ti**, **con yo** and **con tú** don't exist."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **conmigo** says _with_ twice: **con** at the front and **-go** at the end (from Latin _cum_, _with_). Spanish just loves company."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "¿Quieres ir a surfear ==conmigo==?",
              "en": "Do you want to go surfing with me?"
            },
            {
              "es": "Sí, voy ==contigo==.",
              "en": "Yes, I'll go with you."
            },
            {
              "es": "Ana entrena ==con él== los martes.",
              "en": "Ana trains with him on Tuesdays."
            },
            {
              "es": "¿Puedo hablar ==con usted== un momento?",
              "en": "Can I talk to you for a moment?"
            },
            {
              "es": "Mis hermanos viven ==con nosotros==.",
              "en": "My brothers live with us."
            },
            {
              "es": "Mañana voy al cine ==con ellas==.",
              "en": "Tomorrow I'm going to the movies with them."
            },
            {
              "es": "No te enojes ==conmigo==.",
              "en": "Don't get mad at me."
            },
            {
              "es": "¿Todo bien ==con ustedes==?",
              "en": "Is everything OK with you guys?"
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
