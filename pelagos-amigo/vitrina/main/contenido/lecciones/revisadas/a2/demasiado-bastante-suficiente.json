  "titulo": "Quantity words: demasiado, bastante, suficiente, poco, tanto, mucho",
  "subtitulo": "«Hoy hay demasiadas olas.»",
  "foto": "t06.jpg",
  "regla": "Before a noun, demasiado, bastante, suficiente, poco, tanto and mucho agree with it. Demasiado, mucho, poco and tanto have four forms; bastante and suficiente only change for number.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "These words say **how much** or **how many**. Before a noun they agree with it."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "meaning",
            "masc. sing.",
            "fem. sing.",
            "masc. pl.",
            "fem. pl."
          ],
          "filas": [
            [
              "too much / too many",
              "demasiado",
              "demasiada",
              "demasiados",
              "demasiadas"
            ],
            [
              "a lot of, many",
              "mucho",
              "mucha",
              "muchos",
              "muchas"
            ],
            [
              "little, few",
              "poco",
              "poca",
              "pocos",
              "pocas"
            ],
            [
              "so much / so many",
              "tanto",
              "tanta",
              "tantos",
              "tantas"
            ],
            [
              "enough, quite a lot",
              "bastante",
              "bastante",
              "bastantes",
              "bastantes"
            ],
            [
              "enough",
              "suficiente",
              "suficiente",
              "suficientes",
              "suficientes"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**bastante** = _enough_ or _quite a lot_; **suficiente** = _enough_, just what you need."
        },
        {
          "tipo": "texto",
          "texto": "Mass nouns stay singular: **suficiente** dinero, **mucha** agua, **poco** tiempo."
        },
        {
          "tipo": "texto",
          "texto": "**Muy** never goes before a noun: **mucha** gente, not muy gente."
        },
        {
          "tipo": "texto",
          "texto": "After a verb they don't change: entrené **demasiado**."
        }
      ]
    },
    {
