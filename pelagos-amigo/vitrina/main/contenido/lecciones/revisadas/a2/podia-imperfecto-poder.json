{
  "tema": 6505,
  "slug": "podia-imperfecto-poder",
  "titulo": "Poder in the imperfect",
  "subtitulo": "De niño podía nadar horas.",
  "foto": "t07.jpg",
  "regla": "Poder is regular in the imperfect, with no o > ue: podía, podías, podía, podíamos, podían. It means could / was able to, as a general ability or possibility in the past.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Poder** is regular in the imperfect: stem **pod-** + **-ía** endings. No **ue** (the stress falls on **-ía**)."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "Poder"
          ],
          "filas": [
            [
              "yo",
              "podía"
            ],
            [
              "tú",
              "podías"
            ],
            [
              "él, ella, usted",
              "podía"
            ],
            [
              "nosotros, nosotras",
              "podíamos"
            ],
            [
              "ellos, ellas, ustedes",
              "podían"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Podía** = _could_, _was able to_, _was allowed to_: a general ability or possibility in the past, or background to a story."
        },
        {
          "tipo": "formula",
          "partes": [
            "podía",
            "+",
            "infinitive"
          ]
        },
        {
          "tipo": "texto",
          "texto": "For one specific moment when you managed (or failed) to do something, use the preterite: **pude**, **no pude**."
        },
        {
          "tipo": "texto",
          "texto": "**Se podía** = _you could_ / _it was possible_ (in general)."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "De niño ==podía== nadar horas en el mar.",
              "en": "As a kid I could swim for hours in the sea."
            },
            {
              "es": "Antes no ==podías== levantar ni diez kilos.",
              "en": "Before, you couldn't even lift ten kilos."
            },
            {
              "es": "Desde la azotea ==se podía== ver el mar.",
              "en": "You could see the sea from the roof."
            },
            {
              "es": "Mi abuelo ==podía== arreglar cualquier carro.",
              "en": "My grandpa could fix any car."
            },
            {
              "es": "Cuando vivíamos en Ensenada, ==podíamos== surfear antes del trabajo.",
              "en": "When we lived in Ensenada, we could surf before work."
            },
            {
              "es": "Ustedes no ==podían== entrar sin boleto.",
              "en": "You all couldn't get in without a ticket."
            },
            {
              "es": "No ==podía== dormir por el ruido de la fiesta.",
              "en": "I couldn't sleep because of the party noise."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
