            },
            {
              "es": "—¿==Para== qué ==es== este botón? —==Es para== apagar la alarma.",
              "en": "\"What's this button for?\" \"It's for turning off the alarm.\""
            },
            {
              "es": "Esta llave ==es para== la bodega.",
              "en": "This key is for the storage room."
            },
            {
              "es": "Los guantes ==son para== trabajar en el huerto.",
              "en": "The gloves are for working in the garden."
            },
            {
              "es": "El dinero ==es para== el viaje a Ensenada.",
              "en": "The money is for the trip to Ensenada."
            },
            {
              "es": "Esta app ==es para== aprender español.",
