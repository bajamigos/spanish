            },
            {
              "es": "Ya ==entregué== el reporte.",
              "en": "I already turned in the report."
            },
            {
              "es": "Mi hermano ==pagó== la cena.",
              "en": "My brother paid for dinner."
            },
            {
              "es": "==Apagué== el riego porque llovió toda la noche.",
              "en": "I turned off the sprinklers because it rained all night."
            },
            {
              "es": "La Rocinante ==llegó== a Ceres sin problemas.",
              "en": "The Rocinante reached Ceres without problems."
            }
          ]
