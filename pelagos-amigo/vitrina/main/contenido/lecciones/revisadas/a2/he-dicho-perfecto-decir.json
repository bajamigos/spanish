{
  "tema": 6240,
  "slug": "he-dicho-perfecto-decir",
  "titulo": "Decir in the present perfect",
  "subtitulo": "Te lo he dicho mil veces.",
  "foto": "t05.jpg",
  "regla": "Decir in the present perfect is haber in the present + the irregular participle dicho (never decido): he dicho, has dicho, ha dicho, hemos dicho, han dicho.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Build it with **haber** in the present + **dicho**. The participle of **decir** is irregular: **dicho**."
        },
        {
          "tipo": "formula",
          "partes": [
            "he / has / ha / hemos / han",
            "+",
            "dicho"
          ]
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "Decir"
          ],
          "filas": [
            [
              "yo",
              "he dicho"
            ],
            [
              "tú",
              "has dicho"
            ],
            [
              "él, ella, usted",
              "ha dicho"
            ],
            [
              "nosotros, nosotras",
              "hemos dicho"
            ],
            [
              "ellos, ellas, ustedes",
              "han dicho"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Dicho** never changes: **ha dicho la verdad**, **han dicho cosas**."
        },
        {
          "tipo": "texto",
          "texto": "Pronouns go before **haber**, never in the middle: **te lo he dicho**."
        },
        {
          "tipo": "texto",
          "texto": "Verbs built on **decir** do the same: **predecir** → **predicho**, **contradecir** → **contradicho**."
        },
        {
          "tipo": "texto",
          "texto": "Careful: **decidido** is from **decidir** (_to decide_), a different verb."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Te lo ==he dicho== mil veces: ¡riega las plantas!",
              "en": "I've told you a thousand times: water the plants!"
            },
            {
              "es": "Mi jefe no me ==ha dicho== nada del aumento.",
              "en": "My boss hasn't told me anything about the raise."
            },
            {
              "es": "¿Qué te ==han dicho== en el banco?",
              "en": "What have they told you at the bank?"
            },
            {
              "es": "==Hemos dicho== que sí a la invitación.",
              "en": "We've said yes to the invitation."
            },
            {
              "es": "¿Ya le ==has dicho== a Mario?",
              "en": "Have you told Mario yet?"
            },
            {
              "es": "El doctor ==ha dicho== que necesito descansar.",
              "en": "The doctor has said I need to rest."
            },
            {
              "es": "Nunca ==he dicho== una mentira tan grande.",
              "en": "I've never told such a big lie."
            },
            {
              "es": "Los vecinos ==han dicho== que va a llover.",
              "en": "The neighbors have said it's going to rain."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
