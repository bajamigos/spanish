{
  "tema": 6075,
  "slug": "nadie-pronombre",
  "titulo": "Nadie: no one, nobody, not anyone",
  "subtitulo": "No vino nadie.",
  "foto": "t01.jpg",
  "regla": "Nadie means no one / not anyone. Before the verb it stands alone (Nadie vino); after the verb it needs no before the verb (No vino nadie). As an object it takes the personal a: No conozco a nadie.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Nadie** = _no one, nobody, not anyone_. Only for **people**. It never changes, and the verb is **singular**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Position",
            "Pattern",
            "Example"
          ],
          "filas": [
            [
              "Before the verb",
              "**nadie** + verb",
              "**Nadie** sabe."
            ],
            [
              "After the verb",
              "**no** + verb + **nadie**",
              "**No** sabe **nadie**."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "When it's the object of the verb, it takes the **personal a**: No veo **a nadie**. It also goes after prepositions: **con nadie**, **para nadie**."
        },
        {
          "tipo": "texto",
          "texto": "Alone as an answer: ¿Quién llamó? —**Nadie**."
        },
        {
          "tipo": "texto",
          "texto": "It stacks with other negatives: No le dije **nada** a **nadie**."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **nadie** is an empty room. Say **no** at the door unless **nadie** walks in first."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Nadie== sabe dónde están las llaves.",
              "en": "Nobody knows where the keys are."
            },
            {
              "es": "No vino ==nadie== a la clase de hoy.",
              "en": "No one came to today's class."
            },
            {
              "es": "No conozco a ==nadie== en esta ciudad.",
              "en": "I don't know anyone in this city."
            },
            {
              "es": "¿Quién se comió mis tacos? —¡==Nadie==!",
              "en": "Who ate my tacos? —Nobody!"
            },
            {
              "es": "No hablo con ==nadie== antes de mi café.",
              "en": "I don't talk to anyone before my coffee."
            },
            {
              "es": "==Nadie== me avisó que no había clase.",
              "en": "Nobody told me there was no class."
            },
            {
              "es": "Aquí no hay ==nadie==.",
              "en": "There's nobody here."
            },
            {
              "es": "No le dije nada a ==nadie==.",
              "en": "I didn't tell anyone anything."
            }
