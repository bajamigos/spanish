      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Mexico uses the **metric system**: **metros**, **centímetros**, **kilómetros**, **kilos**, **litros**."
        },
        {
          "tipo": "texto",
          "texto": "**Height** uses **medir** (e > i): **mido, mides, mide, medimos, miden**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "What",
            "Question",
            "Answer"
          ],
          "filas": [
            [
              "height",
              "¿Cuánto mides?",
              "Mido un metro setenta y cinco (1.75 m)."
            ],
            [
              "weight",
              "¿Cuánto pesas?",
              "Peso setenta kilos."
            ],
            [
              "length / width / height of a thing",
              "¿Cuánto mide?",
              "Mide tres metros de largo / de ancho / de alto."
            ],
            [
              "depth",
              "¿Qué tan profunda es?",
              "Tiene dos metros de profundidad."
            ],
            [
              "distance",
              "¿A qué distancia está? / ¿Qué tan lejos está?",
              "Está a cinco kilómetros."
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Distance uses **estar a** + amount: **La playa está a diez minutos / a dos kilómetros de aquí**."
        },
        {
          "tipo": "texto",
          "texto": "For the dimensions of things, use **medir** or **tener** + amount + **de largo / ancho / alto**."
        },
        {
          "tipo": "texto",
          "texto": "Abbreviations never take **-s** or a period: **5 km, 70 kg, 20 cm**. Mexico writes decimals with a point: **1.80 m** (read **un metro ochenta**)."
        }
      ]
    },
