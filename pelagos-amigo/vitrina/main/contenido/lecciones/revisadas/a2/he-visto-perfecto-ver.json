{
  "tema": 5112,
  "slug": "he-visto-perfecto-ver",
  "titulo": "Ver in the present perfect",
  "subtitulo": "¿Has visto mis llaves?",
  "foto": "t07.jpg",
  "regla": "Ver has an irregular participle, visto. The present perfect is he visto, has visto, ha visto, hemos visto, han visto.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Ver** (_to see_, _to watch_) has an irregular participle: **visto**. Never _vido_ or _veído_."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "ver"
          ],
          "filas": [
            [
              "yo",
              "**he visto**"
            ],
            [
              "tú",
              "**has visto**"
            ],
            [
              "él / ella / usted",
              "**ha visto**"
            ],
            [
              "nosotros",
              "**hemos visto**"
            ],
            [
              "ellos / ellas / ustedes",
              "**han visto**"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Only **haber** changes; **visto** stays the same. Pronouns and **no** go before **haber**: **no la he visto**."
        },
        {
          "tipo": "texto",
          "texto": "When you see a **person**, add **a**: **he visto a Beto**."
        },
        {
          "tipo": "texto",
          "texto": "**¿Has visto…?** is the classic question for experiences and lost things. For something that just happened, Mexicans often use the preterite: **¿Ya viste…?**"
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==He visto== a Beto en el gimnasio esta semana.",
              "en": "I've seen Beto at the gym this week."
            },
            {
              "es": "¿==Has visto== mis llaves?",
              "en": "Have you seen my keys?"
            },
            {
              "es": "Mi abuela nunca ==ha visto== la nieve.",
              "en": "My grandma has never seen snow."
            },
            {
              "es": "==Hemos visto== ballenas desde la playa este invierno.",
              "en": "We've seen whales from the beach this winter."
            },
            {
              "es": "¿Ustedes ==han visto== The Expanse?",
              "en": "Have you guys watched The Expanse?"
            },
            {
              "es": "Nunca ==he visto== olas tan grandes.",
              "en": "I've never seen waves that big."
            },
            {
              "es": "Mi hijo ==ha visto== esa película diez veces.",
              "en": "My son has watched that movie ten times."
            },
            {
              "es": "Todavía no la ==he visto==.",
              "en": "I haven't seen it yet."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "He veído esa serie."
                },
                {
                  "v": "bien",
                  "t": "He visto esa serie."
                }
              ]
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Has viste a Beto?"
                },
                {
                  "v": "bien",
                  "t": "¿Has visto a Beto?"
                }
              ],
              "nota": "After **has**, the participle."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "He visto Beto hoy."
                },
                {
                  "v": "bien",
                  "t": "He visto a Beto hoy."
                }
              ],
              "nota": "Personal **a** for people."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Yo lo visto."
                },
                {
                  "v": "bien",
                  "t": "Yo lo he visto."
                }
              ],
              "nota": "Don't drop **he**."
            }
          ]
        }
      ]
    },
