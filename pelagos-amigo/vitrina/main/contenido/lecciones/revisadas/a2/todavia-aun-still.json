{
  "tema": 8618,
  "slug": "todavia-aun-still",
  "titulo": "Todavía / aún = still",
  "subtitulo": "«Todavía vivo en Tijuana. Aún no llega.»",
  "foto": "t07.jpg",
  "regla": "Todavía and aún both mean _still_ (something continues): todavía vivo aquí. With no they mean _not yet_: todavía no / aún no. For _no longer_, use ya no.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Todavía** and **aún** (with accent) mean _still_: the situation continues. They're interchangeable; **todavía** is more common in Mexico."
        },
        {
          "tipo": "texto",
          "texto": "They usually go **before the verb**, but can also go after it or at the end: **Todavía estoy aquí / Estoy aquí todavía**."
        },
        {
          "tipo": "texto",
          "texto": "With a negative they mean _not yet_ (it hasn't happened, but it may):"
        },
        {
          "tipo": "formula",
          "partes": [
            "todavía / aún",
            "+ no +",
            "verb"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Or at the end: **No llega todavía**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Spanish",
            "English"
          ],
          "filas": [
            [
              "**todavía / aún** + verb",
              "_still_"
            ],
            [
              "**todavía no / aún no** + verb",
              "_not yet_"
            ],
            [
              "**ya no** + verb",
              "_no longer, not anymore_"
            ],
            [
              "**ya** + verb",
              "_already, now_"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Aún** with an accent = _still_. **Aun** without accent means _even_ (another word)."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "==Todavía== vivo con mis papás.",
              "en": "I still live with my parents."
            },
