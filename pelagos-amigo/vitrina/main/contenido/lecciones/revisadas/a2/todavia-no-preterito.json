                {
                  "v": "mal",
                  "t": "Todavía no lo hice todavía."
                },
                {
                  "v": "bien",
                  "t": "Todavía no lo hice."
                }
              ],
              "nota": "One **todavía** is enough."
            }
          ]
        }
      ]
