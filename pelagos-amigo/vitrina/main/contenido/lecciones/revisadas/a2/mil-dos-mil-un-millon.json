  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "**Mil** = 1,000. Say **mil**, never **un mil**."
        },
        {
          "tipo": "texto",
          "texto": "**Mil** doesn't change: **dos mil**, **diez mil**, **cien mil**. No _miles_ here."
        },
        {
          "tipo": "tabla",
