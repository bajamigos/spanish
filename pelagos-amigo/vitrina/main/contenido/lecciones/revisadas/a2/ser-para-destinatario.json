{
  "tema": 5988,
  "slug": "ser-para-destinatario",
  "titulo": "Ser para for a recipient",
  "subtitulo": "Este regalo es para ti.",
  "foto": "t03.jpg",
  "regla": "To say who something is for, use ser + para + the person: el regalo es para ti. Never estar. After para, use mí and ti, not yo and tú.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "To say **who something is for**, use **ser + para** + the person."
        },
        {
          "tipo": "formula",
          "partes": [
            "thing",
            "+ ser + para +",
            "person"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Never **estar** here: **es para ti**, not **está para ti**."
        },
        {
          "tipo": "texto",
          "texto": "To ask, put **para** first: **¿Para quién es?** = _Who is it for?_"
        },
        {
          "tipo": "texto",
          "texto": "After **para**, use these pronouns:"
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Person",
            "After para"
          ],
          "filas": [
            [
              "I",
              "para **mí**"
            ],
            [
              "you (tú)",
              "para **ti**"
            ],
            [
              "he, she, you (usted)",
              "para él, para ella, para usted"
            ],
            [
              "we",
              "para nosotros/as"
            ],
            [
              "they, you all",
              "para ellos/as, para ustedes"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Mí** has an accent; **ti** never does."
        },
        {
          "tipo": "texto",
          "texto": "Tip: **para** is the delivery address on the box. **Es** just says the box belongs there."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Este regalo ==es para== ti.",
              "en": "This present is for you."
            },
            {
              "es": "—¿==Para== quién ==es== el café? —==Es para== mí.",
              "en": "\"Who's the coffee for?\" \"It's for me.\""
            },
            {
              "es": "Las flores ==son para== mi mamá.",
              "en": "The flowers are for my mom."
            },
            {
              "es": "Estos tacos ==son para== nosotros.",
              "en": "These tacos are for us."
            },
            {
              "es": "La tabla nueva ==es para== mi sobrino.",
              "en": "The new board is for my nephew."
            },
            {
              "es": "Señora, esta carta ==es para== usted.",
              "en": "Ma'am, this letter is for you."
            },
            {
              "es": "¿Los boletos ==son para== ellos?",
              "en": "Are the tickets for them?"
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
