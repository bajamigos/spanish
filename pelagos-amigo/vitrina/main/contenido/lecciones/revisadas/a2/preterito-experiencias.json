              "nota": "Experiences: preterite, not imperfect."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Iba a Oaxaca dos veces."
                },
                {
                  "v": "bien",
                  "t": "Fui a Oaxaca dos veces."
                }
              ],
              "nota": "Counted times: preterite."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "Nunca no fui a Cancún."
                },
                {
                  "v": "bien",
                  "t": "Nunca fui a Cancún."
                }
              ],
              "nota": "**Nunca** before the verb: no extra **no**."
            },
            {
              "filas": [
                {
                  "v": "mal",
                  "t": "¿Has alguna vez ido a Cancún?"
                },
                {
                  "v": "bien",
                  "t": "¿Alguna vez has ido a Cancún?"
                }
              ],
              "nota": "Never split **has** from **ido**."
            }
          ]
        }
      ]
