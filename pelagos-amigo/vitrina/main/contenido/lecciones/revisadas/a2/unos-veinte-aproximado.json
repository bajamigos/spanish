{
  "tema": 6671,
  "slug": "unos-veinte-aproximado",
  "titulo": "Unos, unas + number = about",
  "subtitulo": "Había unas cincuenta personas.",
  "foto": "t05.jpg",
  "regla": "Unos / unas + number + noun means about or approximately. Unos or unas agrees with the noun: unos diez minutos, unas veinte personas. For clock times use como a las… or a eso de las….",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "Before a number, **unos / unas** means **about**, **approximately**."
        },
        {
          "tipo": "formula",
          "partes": [
            "unos / unas",
            "+ number +",
            "noun"
          ]
        },
        {
          "tipo": "texto",
          "texto": "**Unos / unas** agrees with the **noun**, not the number: **unos treinta kilos**, **unas treinta personas**, **unas mil personas**."
        },
        {
          "tipo": "texto",
          "texto": "Numbers that have gender agree too: **unos doscientos pesos**, **unas doscientas personas**."
        },
        {
          "tipo": "texto",
          "texto": "For clock times, don't use **unos**: say **como a las ocho** or **a eso de las ocho**. In Mexico, **como** + number is very common for any amount: **como veinte personas**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Había ==unas== cincuenta personas en la fiesta.",
              "en": "There were about fifty people at the party."
            },
            {
              "es": "La playa está a ==unos== diez minutos de mi casa.",
              "en": "The beach is about ten minutes from my house."
            },
            {
              "es": "Entreno ==unas== cuatro horas a la semana.",
              "en": "I train about four hours a week."
            },
            {
              "es": "Las olas tenían ==unos== dos metros.",
              "en": "The waves were about two meters."
            },
            {
              "es": "Mi abuelo tiene ==unos== ochenta años.",
              "en": "My grandpa is about eighty."
            },
            {
              "es": "Cosechamos ==unos== veinte jitomates.",
              "en": "We harvested about twenty tomatoes."
            },
            {
              "es": "El libro cuesta ==unos== trescientos pesos.",
              "en": "The book costs about three hundred pesos."
            },
            {
              "es": "Llegamos ==como a las== ocho.",
              "en": "We got there around eight."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
