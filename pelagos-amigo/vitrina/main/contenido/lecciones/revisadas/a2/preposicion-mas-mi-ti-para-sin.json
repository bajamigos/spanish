{
  "tema": 6466,
  "slug": "preposicion-mas-mi-ti-para-sin",
  "titulo": "Prepositions + pronouns: para mí, sin ti, de él…",
  "subtitulo": "«Esto es para ti. No puedo vivir sin ti.»",
  "foto": "t01.jpg",
  "regla": "After a preposition (a, para, por, de, en, sin, hacia, sobre…), use mí and ti for I and you. All the other persons keep their usual form: él, ella, usted, nosotros, ustedes, ellos. Exceptions: con (conmigo, contigo) and entre / según (yo, tú).",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "After a **preposition**, **yo** becomes **mí** and **tú** becomes **ti**. Everyone else stays the same."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Subject",
            "After a preposition"
          ],
          "filas": [
            [
              "yo",
              "**mí** (para mí)"
            ],
            [
              "tú",
              "**ti** (sin ti)"
            ],
            [
              "él / ella / usted",
              "él / ella / usted (de él)"
            ],
            [
              "nosotros / nosotras",
              "nosotros / nosotras (por nosotros)"
            ],
            [
              "ustedes",
              "ustedes (en ustedes)"
            ],
            [
              "ellos / ellas",
              "ellos / ellas (sobre ellas)"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Prepositions in this pattern: **a, para, por, de, en, sin, hacia, sobre, contra, desde, hasta**…"
        },
        {
          "tipo": "texto",
          "texto": "**Mí** has an accent (it's not **mi**, _my_). **Ti** never has one."
        },
        {
          "tipo": "texto",
          "texto": "Exceptions: **con** gives **conmigo** and **contigo**; **entre** and **según** keep **yo** and **tú** (**entre tú y yo**)."
        },
        {
          "tipo": "texto",
          "texto": "Tip: only the two people in the conversation, **me** and **you**, change their clothes after a preposition."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Este regalo es ==para ti==.",
              "en": "This gift is for you."
            },
            {
              "es": "No puedo vivir ==sin ti==.",
              "en": "I can't live without you."
            },
            {
              "es": "¿Están hablando ==de mí==?",
              "en": "Are you talking about me?"
            },
            {
              "es": "Confía ==en mí==.",
              "en": "Trust me."
            },
            {
              "es": "Lo hizo ==por ella==.",
              "en": "He did it for her."
            },
            {
              "es": "El perro corrió ==hacia nosotros==.",
              "en": "The dog ran toward us."
            },
            {
              "es": "Escribieron un artículo ==sobre ustedes==.",
              "en": "They wrote an article about you guys."
            },
            {
              "es": "==A mí== me encanta el mole.",
              "en": "I love mole."
            }
          ]
        }
      ]
    },
    {
      "id": "trampa",
      "titulo": "The trap",
      "bloques": [
        {
          "tipo": "pares",
          "lista": [
