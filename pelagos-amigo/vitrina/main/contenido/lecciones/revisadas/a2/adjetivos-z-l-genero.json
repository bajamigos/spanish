{
  "tema": 6056,
  "slug": "adjetivos-z-l-genero",
  "titulo": "Adjectives in -z and -l: one form for both genders",
  "subtitulo": "«Un niño feliz, una niña feliz.»",
  "foto": "t01.jpg",
  "regla": "Adjectives ending in -z or -l have the same singular form for masculine and feminine: un carro azul, una casa azul. The exception is nationality and origin words, which add -a: español → española.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "If the adjective ends in **-z** or **-l**, it does **not** change for gender."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "masculine",
            "feminine"
          ],
          "filas": [
            [
              "un día feliz",
              "una tarde feliz"
            ],
            [
              "un examen difícil",
              "una pregunta difícil"
            ],
            [
              "un mar azul",
              "una tabla azul"
            ],
            [
              "un perro fiel",
              "una perra fiel"
            ],
            [
              "un surfista capaz",
              "una surfista capaz"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Common ones: **feliz, capaz, veloz, audaz, eficaz, fácil, difícil, útil, azul, fiel, cruel, normal, igual, especial, genial, ideal, natural**."
        },
        {
          "tipo": "texto",
          "texto": "Exception: nationality and origin adjectives add **-a**: **español → española**."
        },
        {
          "tipo": "texto",
          "texto": "The plural is another rule: **feliz → felices**, **azul → azules**."
        }
      ]
    },
    {
      "id": "ejemplos",
      "titulo": "Examples",
      "bloques": [
        {
          "tipo": "ejemplos",
          "lista": [
            {
              "es": "Mi hija es una niña muy ==feliz==.",
              "en": "My daughter is a very happy girl."
            },
            {
              "es": "Esta ola es ==fácil== para principiantes.",
              "en": "This wave is easy for beginners."
            },
            {
              "es": "La pared de mi cuarto es ==azul==.",
              "en": "My bedroom wall is blue."
            },
            {
              "es": "Mi perra es muy ==fiel==.",
              "en": "My dog is very loyal."
            },
            {
              "es": "La clase de hoy fue ==difícil==.",
              "en": "Today's class was hard."
            },
            {
              "es": "Ella es ==capaz== de surfear olas enormes.",
              "en": "She's capable of surfing huge waves."
            },
            {
              "es": "Es una idea ==genial==.",
              "en": "It's a great idea."
            },
            {
              "es": "Mi vecina es ==española==, pero vive en Tijuana.",
              "en": "My neighbor is Spanish, but she lives in Tijuana."
            }
          ]
        }
      ]
