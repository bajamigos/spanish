{
  "tema": 6087,
  "slug": "diminutivo-ito-ita",
  "titulo": "Diminutive -ito, -ita (words in -o, -a, -io, -ia)",
  "subtitulo": "perro → perrito, casa → casita, despacio → despacito",
  "foto": "t02.jpg",
  "regla": "For words ending in -o or -a, drop the final vowel and add -ito / -ita (plural -itos / -itas): perro → perrito, casa → casita. Words in unstressed -io / -ia drop the whole -io / -ia: despacio → despacito. The new word keeps the gender of the original.",
  "comparada_kwiziq": null,
  "secciones": [
    {
      "id": "regla",
      "titulo": "The rule",
      "bloques": [
        {
          "tipo": "texto",
          "texto": "The diminutive makes something **small**, **cute** or **softer**. In Mexico it's everywhere: **ahorita**, **un momentito**, **cerquita**."
        },
        {
          "tipo": "texto",
          "texto": "Words ending in **-o / -a**: drop the final vowel and add **-ito / -ita**. Plural: **-itos / -itas**."
        },
        {
          "tipo": "formula",
          "partes": [
            "perr(o)",
            "+ ito =",
            "perrito"
          ]
        },
        {
          "tipo": "texto",
          "texto": "Words ending in **-io / -ia** (unstressed i): drop **-io / -ia** and add **-ito / -ita**, so the i disappears: **despacio → despacito**, **Mario → Marito**, **Julia → Julita**."
        },
        {
          "tipo": "texto",
          "texto": "The ending copies the **last vowel** of the word, and the **gender stays**: **el problema → el problemita**, **el mapa → el mapita**."
        },
        {
          "tipo": "tabla",
          "encabezados": [
            "Original",
            "Diminutive",
            "Plural"
          ],
          "filas": [
            [
              "perro",
              "perrito",
              "perritos"
            ],
            [
              "casa",
              "casita",
              "casitas"
            ],
            [
              "gato",
              "gatito",
              "gatitos"
            ],
            [
              "despacio",
              "despacito",
              "—"
            ],
            [
              "Julia",
              "Julita",
              "—"
            ]
          ]
        },
        {
          "tipo": "texto",
          "texto": "Spelling keeps the sound: **c → qu** (poco → **poquito**, chico → **chiquito**), **g → gu** (amigo → **amiguito**), **z → c** (taza → **tacita**)."
        },
        {
          "tipo": "texto",
          "texto": "It works with nouns, adjectives and adverbs: **ahora → ahorita**, **cerca → cerquita**, **rápido → rapidito**."
        }
      ]
    },
